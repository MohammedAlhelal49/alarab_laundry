<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override achievement menu to make it visible only to Sales Administrators -->
    <record id="sale_commission.sale_commission_achievement_report_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_manager')])]"/>
    </record>

    <!-- Override to show the "commission" menu only to Sales > User: All Documents -->
    <record id="sale_commission.sale_commission_plan_report_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman_all_leads')])]"/>
    </record>

</odoo>
