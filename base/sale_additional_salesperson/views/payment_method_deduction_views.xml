<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_scpml_tree" model="ir.ui.view">
        <field name="name">sale.commission.payment.method.line.deduction.tree</field>
        <field name="model">sale.commission.payment.method.line.deduction</field>
        <field name="arch" type="xml">
            <list string="Payment Method Line Deductions" editable="bottom">
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="journal_id"/>
                <field name="payment_method_line_id"
                       string="Payment Method Name"
                       domain="[('journal_id', '=', journal_id), ('payment_type', '=', 'inbound')]"
                       options="{'no_create_edit': True}"/>
                <field name="deduction_percent" widget="percentage"/>
                <field name="note" optional="hide"/>
                <field name="payment_method_id" readonly="1" optional="hide"/>
                <field name="method_code" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_scpml_form" model="ir.ui.view">
        <field name="name">sale.commission.payment.method.line.deduction.form</field>
        <field name="model">sale.commission.payment.method.line.deduction</field>
        <field name="arch" type="xml">
            <form string="Payment Method Line Deduction">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"
                                   string="Payment Method Name"
                                   domain="[('journal_id', '=', journal_id), ('payment_type', '=', 'inbound')]"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="deduction_percent" widget="percentage"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <group string="Details" col="4">
                        <field name="payment_method_id" readonly="1"/>
                        <field name="method_code" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_scpml_search" model="ir.ui.view">
        <field name="name">sale.commission.payment.method.line.deduction.search</field>
        <field name="model">sale.commission.payment.method.line.deduction</field>
        <field name="arch" type="xml">
            <search string="Payment Method Line Deductions">
                <field name="journal_id"/>
                <field name="payment_method_line_id" string="Payment Method Name"/>

                <filter name="flt_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="flt_inactive" string="Archived" domain="[('active','=',False)]"/>

                <group expand="1" string="Group By">
                    <filter name="grp_journal" string="Journal" context="{'group_by':'journal_id'}"/>
                    <filter name="grp_pml" string="Payment Method Name" context="{'group_by':'payment_method_line_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scpml" model="ir.actions.act_window">
        <field name="name">Payment Method Deductions</field>
        <field name="res_model">sale.commission.payment.method.line.deduction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>

    </record>

    <!-- Menu under Sales ▸ Commission -->
    <menuitem id="menu_scpml"
              name="Payment Method Deductions"
              parent="sale_commission.menu_sale_commission"
              action="action_scpml"
              sequence="100"
              groups="sales_team.group_sale_manager"/>

</odoo>
