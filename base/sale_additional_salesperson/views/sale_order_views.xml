<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Sale Order form and add Additional Salespersons after user_id -->
    <record id="view_order_form_inherit_additional_salesperson_after_user" model="ir.ui.view">
        <field name="name">sale.order.form.additional.salespersons.after.user</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']//field[@name='user_id']"
                   position="after">
                <field name="additional_user_id" widget="many2many_avatar_user"/>
            </xpath>
        </field>
    </record>

    <!-- Optional: add to list (tree) view too -->
    <record id="view_quotation_tree_inherit_additional_salesperson" model="ir.ui.view">
        <field name="name">sale.order.tree.additional.salespersons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='user_id']" position="after">
                <field name="additional_user_id" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <!-- Also show in sale.sale_order_list_upload -->
    <record id="view_sale_order_list_upload_inherit_additional_salesperson" model="ir.ui.view">
        <field name="name">sale.order.list.upload.additional.salespersons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='user_id']" position="after">
                <field name="additional_user_id" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_additional_user" model="ir.ui.view">
        <field name="name">account.move.form.inherit.additional.user</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="additional_invoice_user_id" widget="many2many_avatar_user"/>
            </xpath>
        </field>
    </record>
</odoo>
