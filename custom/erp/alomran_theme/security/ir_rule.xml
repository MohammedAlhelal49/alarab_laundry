<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rule 1: Sales Admin - يشوف كل Website Registration Leads لشركته -->
    <record id="rule_crm_lead_website_registration_admin" model="ir.rule">
        <field name="name">Website Registration: Sales Admin - All Company Leads</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('x_source_type', 'in', ['popup', 'course', 'contact']), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 2: Salesperson - يشوف بس Leads المعينة له + شركته -->
    <record id="rule_crm_lead_website_registration_salesperson" model="ir.rule">
        <field name="name">Website Registration: Salesperson - Own Leads Only</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('x_source_type', 'in', ['popup', 'course', 'contact']), ('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>