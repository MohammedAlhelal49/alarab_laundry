<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="branch_detail_template" name="Branch Detail">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- Hero Section with Branch Image -->
                <section class="branch-detail-hero">
                    <!-- Background Image -->
                    <div class="branch-hero-bg">
                        <img t-att-src="branch['image']" t-att-alt="branch['name']" class="branch-hero-image"/>
                        <div class="branch-hero-overlay"></div>
                    </div>

                    <!-- Hero Content -->
                    <div class="container">
                        <div class="row align-items-center min-vh-75 py-5">
                            <div class="col-lg-8 mx-auto text-center branch-hero-content">
                                <!-- Back Button -->
                                <a href="/branches" class="btn btn-outline-light mb-4 back-btn">
                                    <i class="fa fa-arrow-right me-2"></i>
                                    Back to Branches
                                </a>

                                <!-- City Badge -->
                                <div class="mb-4">
                                    <span t-attf-class="badge {{branch['badge_class']}} badge-lg" t-esc="branch['city']"/>
                                </div>

                                <!-- Branch Name -->
                                <h1 class="display-3 fw-black mb-4 text-white" t-esc="branch['name']"/>

                                <!-- Location -->
                                <p class="lead text-light mb-0">
                                    <i class="fa fa-map-marker-alt me-2"></i>
                                    <t t-esc="branch['location']"/>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Scroll Indicator -->
                    <div class="scroll-indicator">
                        <a href="#branch-info" class="scroll-link">
                            <i class="fa fa-chevron-down"></i>
                        </a>
                    </div>
                </section>

                <!-- Branch Information Section -->
                <section class="py-5" id="branch-info">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <!-- Contact Info Card -->
                                <div class="branch-info-card">
                                    <div class="text-center mb-5">
                                        <span class="badge mb-3">Contact Information</span>
                                        <h2 class="display-6 fw-bold">Get in Touch</h2>
                                    </div>

                                    <div class="row g-4">
                                        <!-- Location -->
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <div class="info-icon">
                                                    <i class="fa fa-location-dot"></i>
                                                </div>
                                                <div class="info-content">
                                                    <h5>Address</h5>
                                                    <p t-esc="branch['location']"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Phone -->
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <div class="info-icon">
                                                    <i class="fa fa-phone"></i>
                                                </div>
                                                <div class="info-content">
                                                    <h5>Phone</h5>
                                                    <a t-attf-href="tel:{{branch['phone_link']}}" class="info-link" dir="ltr">
                                                        <t t-esc="branch['phone']"/>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Working Hours -->
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <div class="info-icon">
                                                    <i class="fa fa-clock"></i>
                                                </div>
                                                <div class="info-content">
                                                    <h5>Working Hours</h5>
                                                    <p t-esc="branch['working_hours']"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- City -->
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <div class="info-icon">
                                                    <i class="fa fa-city"></i>
                                                </div>
                                                <div class="info-content">
                                                    <h5>City</h5>
                                                    <p t-esc="branch['city']"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Google Maps Link -->
                                        <t t-if="branch.get('maps_link')">
                                            <div class="col-md-6">
                                                <div class="info-item">
                                                    <div class="info-icon">
                                                        <i class="fa fa-map-marked-alt"></i>
                                                    </div>
                                                    <div class="info-content">
                                                        <h5>Location on Map</h5>
                                                        <a t-att-href="branch['maps_link']" target="_blank" class="info-link">
                                                            Open Google Maps
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="branch-actions mt-5">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <a t-attf-href="https://wa.me/{{branch['phone_link']}}"
                                                   class="btn btn-success btn-lg w-100" target="_blank">
                                                    <i class="fab fa-whatsapp me-2"></i>
                                                    Contact via WhatsApp
                                                </a>
                                            </div>
                                            <div class="col-md-4">
                                                <a t-attf-href="tel:{{branch['phone_link']}}"
                                                   class="btn btn-primary btn-lg w-100">
                                                    <i class="fa fa-phone me-2"></i>
                                                    Call Now
                                                </a>
                                            </div>
                                            <t t-if="branch.get('maps_link')">
                                                <div class="col-md-4">
                                                    <a t-att-href="branch['maps_link']"
                                                       class="btn btn-danger btn-lg w-100" target="_blank">
                                                        <i class="fa fa-map-marker-alt me-2"></i>
                                                        Open in Maps
                                                    </a>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ===== GOOGLE MAPS EMBEDDED SECTION ===== -->
                <t t-if="branch.get('embed_link')">
                    <section class="py-5 bg-light" id="branch-map">
                        <div class="container">
                            <div class="text-center mb-5">
                                <span class="badge bg-danger mb-3">
                                    <i class="fa fa-map-marker-alt me-1"></i>
                                    Our Location
                                </span>
                                <h2 class="display-6 fw-bold">Find Us on the Map</h2>
                                <p class="text-muted mt-2" t-esc="branch['location']"/>
                            </div>
                            <div class="row justify-content-center">
                                <div class="col-lg-10">
                                    <!-- Map Wrapper -->
                                    <div class="map-wrapper rounded-4 overflow-hidden shadow-lg">
                                        <iframe
                                            t-att-src="branch['embed_link']"
                                            width="100%"
                                            height="500"
                                            style="border:0; display:block;"
                                            allowfullscreen="allowfullscreen"
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade">
                                        </iframe>
                                    </div>
                                    <!-- Open in Google Maps Button -->
                                    <div class="text-center mt-4">
                                        <a t-att-href="branch['maps_link']"
                                           target="_blank"
                                           class="btn btn-danger btn-lg px-5 py-3">
                                            <i class="fa fa-map-marker-alt me-2"></i>
                                            Open in Google Maps
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </t>
                <!-- ===== END GOOGLE MAPS SECTION ===== -->

                <!-- CTA Section -->
                <section class="hero-section py-5">
                    <div class="container text-center hero-content">
                        <h2 class="display-4 fw-bold mb-4" style="color: white;">Ready to Start?</h2>
                        <p class="lead mb-5" style="color: white; opacity: 0.95;">
                            Visit us at our branch or contact us for more information
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a href="/branches" class="btn btn-light btn-lg px-5 py-3">
                                <i class="fa fa-map-marker-alt me-2"></i>
                                View All Branches
                            </a>
                            <a href="/contact" class="btn btn-outline-light btn-lg px-5 py-3">
                                <i class="fa fa-envelope me-2"></i>
                                Contact Us
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>