<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage" name="Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="homepage-modern">

                <!-- ============================================================ -->
                <!-- HERO SECTION - PREMIUM DESIGN -->
                <!-- ============================================================ -->
                <section class="hero-premium">
                    <!-- Background with overlay -->
                    <div class="hero-bg-overlay">
                        <div class="hero-bg-image" style="background-image: url('/alomran_theme/static/src/img/hero-bg.jpg');"></div>
                        <div class="hero-gradient-overlay"></div>
                    </div>

                    <div class="container">
                        <div class="row align-items-center min-vh-100 py-5">
                            <div class="col-lg-7" data-aos="fade-right" data-aos-delay="100">
                                <!-- Trust Badge -->
                                <div class="trust-badge">
                                    <span class="badge-icon">
                                        <i class="fa fa-award"></i>
                                    </span>
                                    <span class="badge-text">
                                        Certified Training Center Since <strong>2010</strong>
                                    </span>
                                </div>

                                <!-- Main Headline -->
                                <h1 class="display-1 fw-black mb-4 text-white" t-if="not (request.env.lang and request.env.lang.startswith('ar'))">
                                    <span class="text-gradient">Al Omran</span>
                                    <br/>
                                    Training &amp; Development Center
                                </h1>

                                <!-- SEO: H1 عربي - يظهر فقط للزائر العربي بنفس الستايل -->
                                <h1 class="display-1 fw-black mb-4 text-white" t-if="request.env.lang and request.env.lang.startswith('ar')">
                                    <span class="text-gradient">مركز العمران</span>
                                    <br/>
                                    للتدريب والتطوير
                                </h1>

                                <!-- Subheading -->
                                <p class="lead text-light mb-3">
                                    We shape tomorrow's leaders through advanced training programs,
                                    internationally accredited certificates, and over 14 years of professional training experience.
                                </p>

                                <!-- SEO: فقرة عربية - تظهر فقط للزائر العربي -->
                                <p class="lead text-light mb-5" t-if="request.env.lang and request.env.lang.startswith('ar')">
                                    مركز العمران للتدريب والتطوير هو معهد تعليمي رائد ومركز تعليم لغات معتمد، يقدم أفضل البرامج التدريبية في العين والإمارات منذ عام 2010.
                                </p>

                                <!-- CTA Buttons -->
                                <div class="hero-actions">
                                    <a href="/courses" class="btn btn-primary-glow">
                                        <i class="fa fa-play-circle me-2"></i>
                                        <span>Start Your Journey Now</span>
                                    </a>

                                </div>

                                <!-- Quick Stats -->
                                <div class="quick-stats mt-5">
                                    <div class="d-flex flex-wrap justify-content-center gap-3">
                                        <div class="stat-card" style="min-width: 180px;">
                                            <div class="stat-number text-gradient">50k+</div>
                                            <div class="stat-label">Successful Trainees</div>
                                        </div>
                                        <div class="stat-card" style="min-width: 180px;">
                                            <div class="stat-number text-gradient">250+</div>
                                            <div class="stat-label">Certified Trainers</div>
                                        </div>
                                        <div class="stat-card" style="min-width: 180px;">
                                            <div class="stat-number text-gradient">1750+</div>
                                            <div class="stat-label">Training Programs</div>
                                        </div>
                                        <div class="stat-card" style="min-width: 180px;">
                                            <div class="stat-number text-gradient">11</div>
                                            <div class="stat-label">Branches in UAE</div>
                                        </div>
                                        <div class="stat-card" style="min-width: 180px;">
                                            <div class="stat-number text-gradient">25</div>
                                            <div class="stat-label">Government Entities Trained</div>
                                        </div>
                                    </div>
                                </div>                            </div>
                        </div>
                    </div>

                    <!-- Scroll Indicator -->
                    <div class="scroll-indicator">
                        <a href="#programs" class="scroll-link">
                            <i class="fa fa-chevron-down"></i>
                        </a>
                    </div>
                </section>

                <!-- ============================================================ -->
                <!-- FEATURED PROGRAMS - ENHANCED -->
                <!-- ============================================================ -->
                <section id="programs" class="section-programs py-6">
                    <div class="container">
                        <div class="section-header text-center mb-6">
                            <span class="section-badge">
                                <i class="fa fa-star me-2"></i>
                                Most Requested
                            </span>
                            <h2 class="display-4 fw-bold mb-3">Our Distinguished Training Programs</h2>
                            <p class="section-subtitle">Choose from 12 internationally accredited specialized training fields</p>
                        </div>

                        <div class="row g-4">
                            <!-- Program 1 -->
                            <div class="col-lg-4 col-md-6" data-aos="fade-up">
                                <div class="program-card-hover">
                                    <div class="program-icon-wrapper">
                                        <div class="program-icon bg-blue-gradient">
                                            <i class="fa fa-chalkboard-teacher"></i>
                                        </div>
                                        <span class="program-badge">New</span>
                                    </div>
                                    <h4 class="program-title">Professional Teacher Training</h4>
                                    <p class="program-description">
                                        6 specialized programs in developing modern teaching and education skills
                                    </p>
                                    <a href="/teachers" class="program-link">
                                        <span>Explore Program</span>
                                        <i class="fa fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>

                            <!-- Program 2 -->
                            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                                <div class="program-card-hover">
                                    <div class="program-icon-wrapper">
                                        <div class="program-icon bg-green-gradient">
                                            <i class="fa fa-language"></i>
                                        </div>
                                        <span class="program-badge">In Demand</span>
                                    </div>
                                    <h4 class="program-title">World Languages Courses</h4>
                                    <p class="program-description">
                                        12 languages available
                                    </p>
                                    <a href="/languages" class="program-link">
                                        <span>Explore Program</span>
                                        <i class="fa fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>

                            <!-- Program 3 -->
                            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                                <div class="program-card-hover">
                                    <div class="program-icon-wrapper">
                                        <div class="program-icon bg-orange-gradient">
                                            <i class="fa fa-laptop-code"></i>
                                        </div>
                                        <span class="program-badge">Exclusive</span>
                                    </div>
                                    <h4 class="program-title">IT &amp; Programming</h4>
                                    <p class="program-description">
                                        9 advanced technical programs including Cybersecurity and Artificial Intelligence
                                    </p>
                                    <a href="/it-programs" class="program-link">
                                        <span>Explore Program</span>
                                        <i class="fa fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-6">
                            <a href="/courses" class="btn btn-outline-primary">
                                <i class="fa fa-list me-2"></i>
                                View All Programs (1750+ programs)
                            </a>
                        </div>
                    </div>
                </section>

              <!-- ============================================================ -->
<!-- WHY CHOOSE US - WITH LOGO -->
<!-- ============================================================ -->
<section class="section-why-choose section-padding bg-light">
    <div class="container">
        <div class="section-header text-center mb-6">
            <div class="logo-display mb-4">
                <img src="/alomran_theme/static/src/img/Logo_Mockup_3.png"
                     t-att-alt="'مركز العمران للتدريب والتطوير - معهد تعليمي في العين' if request.env.lang and request.env.lang.startswith('ar') else 'Al Omran Training and Development Center'"
                     class="alomran-logo"
                     loading="lazy"
                     style="max-width: 300px; height: auto;"/>
            </div>
            <h2 class="display-3 fw-bold mb-3">Why Choose Al Omran Center?</h2>
            <p class="lead"><strong>At Al Omran Center, we offer you:</strong></p>
        </div>

        <div class="row align-items-center">
            <!-- Image on left -->
            <div class="col-lg-5 mb-5 mb-lg-0" data-aos="fade-right">
                <div class="logo-featured">
                    <div class="logo-frame">
                        <img src="/alomran_theme/static/src/img/Logo_Mockup_3.png"
                             t-att-alt="'أفضل مركز تعليمي في العين والإمارات' if request.env.lang and request.env.lang.startswith('ar') else 'Al Omran Training and Development Center'"
                             class="img-fluid rounded-4 shadow-lg"
                             loading="lazy"/>
                    </div>
                    <div class="logo-text mt-4 text-center">
                        <h3 class="fw-bold text-primary">Al Omran Center</h3>
                        <h4 class="text-dark">For Training &amp; Development</h4>
                    </div>
                </div>
            </div>

            <!-- Features on right -->
            <div class="col-lg-7">
                <div class="row g-4">
                    <!-- Specialized Trainers -->
                    <div class="col-md-6" data-aos="fade-up">
                        <div class="feature-box-with-logo">
                            <div class="feature-icon">
                                <i class="fa fa-user-tie fa-2x"></i>
                            </div>
                            <div class="feature-content">
                                <h5 class="fw-bold mb-2">Specialized Trainers</h5>
                                <p class="text-muted mb-0">Highly qualified specialized trainers</p>
                            </div>
                        </div>
                    </div>

                    <!-- Accredited Certificates -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="feature-box-with-logo">
                            <div class="feature-icon">
                                <i class="fa fa-certificate fa-2x"></i>
                            </div>
                            <div class="feature-content">
                                <h5 class="fw-bold mb-2">Accredited Certificates</h5>
                                <p class="text-muted mb-0">Locally and internationally accredited certificates</p>
                            </div>
                        </div>
                    </div>

                    <!-- Widest Network -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="feature-box-with-logo">
                            <div class="feature-icon">
                                <i class="fa fa-network-wired fa-2x"></i>
                            </div>
                            <div class="feature-content">
                                <h5 class="fw-bold mb-2">Widest Network</h5>
                                <p class="text-muted mb-0">Largest center network in the country</p>
                            </div>
                        </div>
                    </div>

                    <!-- Courses in All Languages -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="feature-box-with-logo">
                            <div class="feature-icon">
                                <i class="fa fa-language fa-2x"></i>
                            </div>
                            <div class="feature-content">
                                <h5 class="fw-bold mb-2">Courses in All Languages</h5>
                                <p class="text-muted mb-0">We offer courses in all world languages</p>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Courses -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="feature-box-with-logo">
                            <div class="feature-icon">
                                <i class="fa fa-briefcase fa-2x"></i>
                            </div>
                            <div class="feature-content">
                                <h5 class="fw-bold mb-2">Professional Courses</h5>
                                <p class="text-muted mb-0">Plus specialized professional courses</p>
                            </div>
                        </div>
                    </div>

                    <!-- More Features -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="500">
                        <div class="feature-box-with-logo empty-feature">
                            <div class="feature-icon">
                                <i class="fa fa-star fa-2x text-muted"></i>
                            </div>
                            <div class="feature-content">
                                <h5 class="fw-bold mb-2 text-muted">And More...</h5>
                                <p class="text-muted mb-0">Discover more features</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Certification Seal -->
                <div class="certificate-seal mt-5 text-center" data-aos="zoom-in">
                    <div class="seal-icon">
                        <i class="fa fa-award fa-3x text-primary"></i>
                    </div>
                    <p class="mt-2 fw-bold">Center Accredited by Official UAE Authorities</p>
                </div>
            </div>
        </div>

        <!-- Statistics Bar -->
        <div class="stats-bar mt-6" data-aos="fade-up">
            <div class="row g-4">
                <div class="col-6 col-md-3">
                    <div class="stat-box text-center">
                        <div class="stat-number text-primary fw-bold display-6">14+</div>
                        <div class="stat-label">Years of Experience</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-box text-center">
                        <div class="stat-number text-primary fw-bold display-6">50K+</div>
                        <div class="stat-label">Successful Trainees</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-box text-center">
                        <div class="stat-number text-primary fw-bold display-6">1750+</div>
                        <div class="stat-label">Training Programs</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-box text-center">
                        <div class="stat-number text-primary fw-bold display-6">11</div>
                        <div class="stat-label">Branches in UAE</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

                <!-- ============================================================ -->
                <!-- BRANCHES MAP -->
                <!-- ============================================================ -->
                <section class="section-branches py-6 bg-gradient-primary">
                    <div class="container">
                        <div class="section-header text-center text-white mb-6">
                            <span class="section-badge bg-white text-primary">
                                <i class="fa fa-map-marker-alt me-2"></i>
                                Our Branches
                            </span>
<h2 class="display-4 fw-bold mb-3" style="color: #ffffff !important; -webkit-text-fill-color: #ffffff !important;">We Are Close to You Across the UAE</h2>
                            <p class="section-subtitle text-white-75">11 branches equipped with latest technologies</p>
                        </div>

                        <div class="branches-grid">
                            <div class="branch-card" data-aos="zoom-in">
                                <div class="branch-icon">
                                    <i class="fa fa-university"></i>
                                </div>
                                <h5>Sharjah Branch</h5>
                                <p class="branch-address">
                                    <i class="fa fa-map-pin me-2"></i>
                                     Central Mall
                                </p>
                                <div class="branch-info">
                                    <span><i class="fa fa-phone"></i> <bdi dir="ltr">+971 56 414 1409</bdi></span>
                                </div>
                            </div>

                            <div class="branch-card" data-aos="zoom-in" data-aos-delay="100">
                                <div class="branch-icon">
                                    <i class="fa fa-building"></i>
                                </div>
                                <h5>Al Ain Branch</h5>
                                <p class="branch-address">
                                    <i class="fa fa-map-pin me-2"></i>
                                    City Center
                                </p>
                                <div class="branch-info">
                                    <span><i class="fa fa-phone"></i> <bdi dir="ltr">+971 56 434 288</bdi></span>
                                </div>
                            </div>

                            <div class="branch-card" data-aos="zoom-in" data-aos-delay="200">
                                <div class="branch-icon">
                                    <i class="fa fa-city"></i>
                                </div>
                                <h5>Zakher Branch</h5>
                                <p class="branch-address">
                                    <i class="fa fa-map-pin me-2"></i>
                                    Makani Mall
                                </p>
                                <div class="branch-info">
                                    <span><i class="fa fa-phone"></i> <bdi dir="ltr">+971 56 434 2889</bdi></span>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-6">
                            <a href="/branches" class="btn btn-light">
                                <i class="fa fa-map-marked-alt me-2"></i>
                                View All Branches &amp; Directions
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ============================================================ -->
                <!-- FINAL CTA -->
                <!-- ============================================================ -->
                <section class="section-cta py-6 bg-dark">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-8 mb-4 mb-lg-0">
                                <h2 class="display-4 fw-bold text-white mb-3">
                                    Ready to Start Your Training Journey?
                                </h2>
                                <p class="lead text-white-75 mb-0">
                                    Join thousands of successful trainees and unleash your potential
                                </p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <div class="cta-buttons">
                                    <a href="/contact" class="btn btn-primary btn-lg">
                                        <i class="fa fa-phone me-2"></i>
                                        Contact Us
                                    </a>
                                    <a href="https://wa.me/971505829697" class="btn btn-outline-light btn-lg">
                                        <i class="fa fa-whatsapp me-2"></i>
                                        WhatsApp Direct
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>