<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="languages_page" name="Languages Training Programs">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- Hero Section -->
                <section class="hero-section py-5" style="min-height: 60vh; display: flex; align-items: center;">
                    <div class="container text-center hero-content">
                        <div class="animate-scale">
                            <span class="badge bg-success text-white mb-3" style="font-size: 1rem; padding: 0.75rem 1.5rem;">
                                <i class="fa fa-language me-2"></i>
                                Language Programs
                            </span>
                            <h1 class="display-3 fw-bold mb-3" style="color: white;" t-if="not (request.env.lang and request.env.lang.startswith('ar'))">Language Training Courses</h1>

                            <!-- SEO: H1 عربي - يظهر فقط للزائر العربي -->
                            <h1 class="display-3 fw-bold mb-3" style="color: white;" t-if="request.env.lang and request.env.lang.startswith('ar')">دورات تعليم لغات وتحضير ايلتس</h1>
                            <p class="lead mb-4" style="color: white; opacity: 0.95; font-size: 1.3rem;">
                                Learn languages with professional trainers | Accredited certificates | Multiple levels
                            </p>
                            <div class="glass-card d-inline-block">
                                <p class="mb-0" style="font-size: 1.1rem ;color: white;">
                                    <i class="fa fa-globe me-2"></i>
                                    12 Languages Available
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Program Description -->
                <section class="py-5 bg-light">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <span class="badge bg-success mb-3">About the Program</span>
                                <h2 class="display-5 fw-bold mb-4">Learn a New Language Now</h2>
                                <p class="lead text-muted mb-4">
                                    We offer comprehensive training courses in more than 12 world languages, focusing on conversation and practical use.
                                </p>

                                <!-- SEO: فقرة عربية - تظهر فقط للزائر العربي -->
                                <p class="lead text-muted mb-4" t-if="request.env.lang and request.env.lang.startswith('ar')">
                                    مركز العمران معهد لغات معتمد يقدم دورة لغة انجليزية، دورة لغة فرنسية، ودورة لغة صينية مع مدربين محترفين، بالإضافة إلى تعليم لغات متعددة لكل المستويات.
                                </p>

                                <div class="d-flex gap-4 mb-4">
                                    <div>
                                        <h4 class="fw-bold text-success mb-1">12</h4>
                                        <small class="text-muted">Languages Available</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="modern-card p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="fa fa-check-circle text-success me-2"></i>
                                        Language Program Features
                                    </h5>
                                    <ul class="list-unstyled">
                                        <li class="mb-3">
                                            <i class="fa fa-check text-success me-2"></i>
                                            <strong>Specialized trainers</strong> native speakers or internationally certified
                                        </li>
                                        <li class="mb-3">
                                            <i class="fa fa-check text-success me-2"></i>
                                            <strong>Multiple levels</strong> from beginner to advanced
                                        </li>
                                        <li class="mb-3">
                                            <i class="fa fa-check text-success me-2"></i>
                                            <strong>Practical application</strong> with real conversations
                                        </li>
                                        <li class="mb-3">
                                            <i class="fa fa-check text-success me-2"></i>
                                            <strong>Accredited certificates</strong> after passing the exam
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Languages Grid -->
                <section class="py-5">
                    <div class="container">
                        <div class="text-center mb-5">
                            <span class="badge bg-success mb-3">Available Languages</span>
                            <h2 class="display-5 fw-bold mb-3" t-if="not (request.env.lang and request.env.lang.startswith('ar'))">Choose the Language You Want to Learn</h2>

                            <!-- SEO: H2 عربي - يظهر فقط للزائر العربي -->
                            <h2 class="display-5 fw-bold mb-3" t-if="request.env.lang and request.env.lang.startswith('ar')">اختر دورة لغة انجليزية أو فرنسية أو صينية</h2>
                            <p class="lead text-muted">12 world languages with professional trainers</p>
                        </div>

                        <div class="row g-4">
                            <!-- English -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <i class="fa fa-flag"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-primary mb-3">Most Requested</span>
                                        <h5 class="fw-bold mb-3">English Language</h5>
                                        <p class="text-muted mb-4">
                                            Comprehensive courses from beginner to advanced focusing on conversation and writing.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="English Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- French -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                        <i class="fa fa-language"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-danger mb-3">Romance</span>
                                        <h5 class="fw-bold mb-3">French Language</h5>
                                        <p class="text-muted mb-4">
                                            Learn the language of Molière with focus on correct pronunciation and French culture.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="French Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Spanish -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                                        <i class="fa fa-globe-americas"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-warning text-dark mb-3">Popular</span>
                                        <h5 class="fw-bold mb-3">Spanish Language</h5>
                                        <p class="text-muted mb-4">
                                            Second most spoken language in the world - learn it easily and enjoyably.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="Spanish Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Italian -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                                        <i class="fa fa-pizza-slice"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-success mb-3">Cultural</span>
                                        <h5 class="fw-bold mb-3">Italian Language</h5>
                                        <p class="text-muted mb-4">
                                            The language of art, music and food - enjoy learning it.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="Italian Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Chinese -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);">
                                        <i class="fa fa-yin-yang"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-danger mb-3">In Demand</span>
                                        <h5 class="fw-bold mb-3">Chinese Language</h5>
                                        <p class="text-muted mb-4">
                                            Most spoken language in the world - open new business horizons.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="Chinese Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Turkish -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">
                                        <i class="fa fa-mosque"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-info mb-3">Regional</span>
                                        <h5 class="fw-bold mb-3">Turkish Language</h5>
                                        <p class="text-muted mb-4">
                                            Beautiful and easy to learn language - ideal for travel and work in Turkey.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="Turkish Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Russian -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #fa8bff 0%, #2bd2ff 100%);">
                                        <i class="fa fa-snowflake"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-primary mb-3">European</span>
                                        <h5 class="fw-bold mb-3">Russian Language</h5>
                                        <p class="text-muted mb-4">
                                            Language of science and literature - important for business and international relations.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="Russian Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Korean -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);">
                                        <i class="fa fa-heart"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-danger mb-3">K-Pop</span>
                                        <h5 class="fw-bold mb-3">Korean Language</h5>
                                        <p class="text-muted mb-4">
                                            Language of K-Drama and K-Pop - enjoy learning it with amazing culture.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="Korean Language">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- SEO: فقرة عربية عن الإيلتس - تظهر فقط للزائر العربي -->
                            <div class="col-12" t-if="request.env.lang and request.env.lang.startswith('ar')">
                                <p class="text-muted text-center mb-2" style="font-size: 0.95rem;">
                                    يقدم مركز العمران دورة ايلتس ودورة توفل معتمدتين، مع تحضير لاختبار الايلتس واختبار ايلتس تجريبي لمساعدتك على تحقيق أعلى الدرجات.
                                </p>
                            </div>

                            <!-- IELTS -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <i class="fa fa-certificate"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-primary mb-3">International Test</span>
                                        <h5 class="fw-bold mb-3">IELTS Preparation</h5>
                                        <p class="text-muted mb-4">
                                            Comprehensive preparation to achieve a high score in IELTS exam.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="IELTS Preparation">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- TOEFL -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                        <i class="fa fa-graduation-cap"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-danger mb-3">Academic</span>
                                        <h5 class="fw-bold mb-3">TOEFL Preparation</h5>
                                        <p class="text-muted mb-4">
                                            Intensive preparation for TOEFL exam for studying in American universities.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="TOEFL Preparation">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- General English -->
                            <div class="col-lg-4 col-md-6">
                                <div class="course-card h-100">
                                    <div class="course-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                                        <i class="fa fa-comments"></i>
                                    </div>
                                    <div class="p-4">
                                        <span class="badge bg-info mb-3">For Everyone</span>
                                        <h5 class="fw-bold mb-3">General English</h5>
                                        <p class="text-muted mb-4">
                                            General English for daily use in travel, work and life.
                                        </p>
                                        <button class="btn btn-primary w-100 btn-register-lang" data-course="General English">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Register Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Registration Modal -->
                <div class="modal fade" id="registrationModalLang" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius: 20px; border: none;">
                            <div class="modal-header" style="background: linear-gradient(135deg, #4ade80, #22c55e); color: white; border-radius: 20px 20px 0 0;">
                                <h5 class="modal-title">
                                    <i class="fa fa-language me-2"></i>
                                    Language Course Registration
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div id="registrationFormLang">
                                    <div class="text-center mb-4">
                                        <h6 class="fw-bold mb-2" id="modalCourseNameLang"></h6>
                                    </div>

                                    <form id="courseRegistrationFormLang">
                                        <input type="hidden" id="courseNameLang" name="course_name"/>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">
                                                <i class="fa fa-user text-success me-2"></i>
                                                Full Name <span class="text-danger">*</span>
                                            </label>
                                            <input type="text"
                                                   class="form-control form-control-lg"
                                                   id="studentNameLang"
                                                   name="name"
                                                   required=""
                                                   placeholder="Enter your full name"
                                                   style="border-radius: 12px;"/>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">
                                                <i class="fa fa-phone text-success me-2"></i>
                                                Phone Number <span class="text-danger">*</span>
                                            </label>
                                            <input type="tel"
                                                   class="form-control form-control-lg"
                                                   id="studentPhoneLang"
                                                   name="phone"
                                                   required=""
                                                   placeholder="05XXXXXXXX"
                                                   pattern="[0-9]{10}"
                                                   style="border-radius: 12px;"/>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">
                                                <i class="fa fa-envelope text-success me-2"></i>
                                                Email (Optional)
                                            </label>
                                            <input type="email"
                                                   class="form-control form-control-lg"
                                                   id="studentEmailLang"
                                                   name="email"
                                                   placeholder="example@email.com"
                                                   style="border-radius: 12px;"/>
                                        </div>

                                        <button type="submit"
                                                class="btn btn-lg w-100"
                                                id="submitRegistrationLang"
                                                style="background: linear-gradient(135deg, #4ade80, #22c55e); color: white; border-radius: 12px; border: none;">
                                            <i class="fa fa-paper-plane me-2"></i>
                                            Submit Request
                                        </button>
                                    </form>
                                </div>

                                <!-- Success Message -->
                                <div id="registrationSuccessLang" style="display: none;" class="text-center">
                                    <div class="mb-4">
                                        <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #4ade80, #22c55e); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                            <i class="fa fa-check" style="font-size: 2.5rem; color: white;"></i>
                                        </div>
                                    </div>
                                    <h4 class="fw-bold mb-3">Request Submitted Successfully! 🎉</h4>
                                    <p class="mb-4">
                                        Thank you! Our team will contact you within <strong>24 hours</strong> to confirm registration.
                                    </p>
                                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CTA Section -->
                <section class="hero-section py-5">
                    <div class="container text-center hero-content">
                        <h2 class="display-4 fw-bold mb-4" style="color: white;">Have a Question?</h2>
                        <p class="lead mb-5" style="color: white; opacity: 0.95;">
                            Our team is ready to help you choose the right language and level
                        </p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="tel:+971505829697" class="btn btn-light btn-lg px-5">
                                <i class="fa fa-phone me-2"></i>
                                Call Us
                            </a>
                            <a href="https://wa.me/971505829697" target="_blank" class="btn btn-success btn-lg px-5">
                                <i class="fab fa-whatsapp me-2"></i>
                                WhatsApp
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>