<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RTL Support for Arabic -->
    <template id="layout_rtl_arabic" inherit_id="website.layout" name="Alomran RTL Arabic" active="True">
        <!-- This template activates RTL for Arabic language -->
        <xpath expr="//html" position="attributes">
            <attribute name="t-attf-dir">#{request.env.lang and request.env.lang.startswith('ar') and 'rtl' or 'ltr'}</attribute>
            <attribute name="t-attf-lang">#{request.env.lang or 'en'}</attribute>
        </xpath>

        <xpath expr="//head" position="inside">
            <!-- Load RTL CSS only for Arabic -->
            <t t-if="request.env.lang and request.env.lang.startswith('ar')">
                <link rel="stylesheet" href="/alomran_theme/static/src/css/rtl.css"/>
            </t>
        </xpath>
    </template>

    <!-- Alternative: Direct RTL Template -->
    <template id="rtl_assets" name="RTL Assets">
        <t t-call="web.assets_common">
            <t t-if="request.env.lang and request.env.lang.startswith('ar')">
                <link rel="stylesheet" href="/alomran_theme/static/src/css/rtl.css"/>
            </t>
        </t>
    </template>

