<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LTR Support for English -->
    <template id="layout_rtl" inherit_id="website.layout" name="Alomran LTR">
        <xpath expr="//html" position="attributes">
            <attribute name="t-attf-lang">#{request.env.lang.split('_')[0] if request.env.lang else 'en'}</attribute>
            <attribute name="t-attf-dir">#{request.env.lang and request.env.lang.startswith('ar') and 'rtl' or 'ltr'}</attribute>
        </xpath>

        <xpath expr="//head" position="inside">
            <link rel="preload" href="/alomran_theme/static/src/img/hero-bg.jpg" as="image"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&amp;display=swap" rel="stylesheet"/>
