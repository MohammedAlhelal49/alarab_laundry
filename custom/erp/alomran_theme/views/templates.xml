    <!-- ============================================================ -->
    <!-- SEO Meta Tags - كل الصفحات الأساسية (عربي فقط)             -->
    <!-- ============================================================ -->
    <t t-if="request.env.lang and request.env.lang.startswith('ar')">

        <!-- title وdescription ثابتان على كل الصفحات -->
        <title>دورات لغة إنجليزية ومتابعة دراسية ودورات مهنية في الإمارات | مركز العمران</title>
        <meta name="description" content="مركز العمران للتدريب والتطوير: دورات لغة إنجليزية وIELTS ومتابعة دراسية ودورات مهنية للنساء في العين ودبي وأبوظبي والشارقة. معتمد منذ 2010."/>

        <!-- robots وgooglebot على كل الصفحات -->
        <meta name="robots" content="index, follow, max-image-preview:large"/>
        <meta name="googlebot" content="index, follow"/>

        <!-- hreflang ديناميكي حسب الصفحة الحالية -->
        <t t-set="current_path" t-value="request.httprequest.path"/>
        <link rel="alternate" hreflang="ar-AE" t-attf-href="https://alomrantd.com/ar#{current_path.replace('/ar', '') if '/ar' in current_path else current_path}"/>
        <link rel="alternate" hreflang="en-AE" t-attf-href="https://alomrantd.com#{current_path.replace('/ar', '') if '/ar' in current_path else current_path}"/>
        <link rel="alternate" hreflang="x-default" t-attf-href="https://alomrantd.com/ar#{current_path.replace('/ar', '') if '/ar' in current_path else current_path}"/>

        <!-- OG Tags ثابتة على كل الصفحات -->
        <meta property="og:type" content="website"/>
        <meta property="og:locale" content="ar_AE"/>
        <meta property="og:locale:alternate" content="en_AE"/>
        <meta property="og:site_name" content="مركز العمران للتدريب والتطوير"/>
        <meta property="og:title" content="دورات لغة إنجليزية ومتابعة دراسية ودورات مهنية في الإمارات | مركز العمران"/>
        <meta property="og:description" content="دورات إنجليزية وIELTS ومتابعة دراسية ودورات مهنية للنساء. 11 فرعاً في الإمارات منذ 2010."/>
        <meta name="twitter:card" content="summary"/>
        <meta name="twitter:title" content="مركز العمران للتدريب والتطوير"/>
        <meta name="twitter:description" content="دورات لغة إنجليزية وIELTS ومتابعة دراسية ودورات مهنية للنساء في العين ودبي وأبوظبي والشارقة."/>

        <!-- canonical + og:url خاصة بكل صفحة -->
        <t t-if="request.httprequest.path in ['/', '/ar', '/ar/']">
            <link rel="canonical" href="https://alomrantd.com/ar/"/>
            <meta property="og:url" content="https://alomrantd.com/ar/"/>
        </t>
        <t t-elif="request.httprequest.path in ['/about', '/ar/about']">
            <link rel="canonical" href="https://alomrantd.com/ar/about"/>
            <meta property="og:url" content="https://alomrantd.com/ar/about"/>
        </t>
        <t t-elif="request.httprequest.path in ['/courses', '/ar/courses']">
            <link rel="canonical" href="https://alomrantd.com/ar/courses"/>
            <meta property="og:url" content="https://alomrantd.com/ar/courses"/>
        </t>
        <t t-elif="request.httprequest.path in ['/branches', '/ar/branches']">
            <link rel="canonical" href="https://alomrantd.com/ar/branches"/>
            <meta property="og:url" content="https://alomrantd.com/ar/branches"/>
        </t>
        <t t-elif="request.httprequest.path in ['/languages', '/ar/languages']">
            <link rel="canonical" href="https://alomrantd.com/ar/languages"/>
            <meta property="og:url" content="https://alomrantd.com/ar/languages"/>
        </t>
        <t t-elif="request.httprequest.path in ['/contact', '/ar/contact']">
            <link rel="canonical" href="https://alomrantd.com/ar/contact"/>
            <meta property="og:url" content="https://alomrantd.com/ar/contact"/>
        </t>

    </t>
