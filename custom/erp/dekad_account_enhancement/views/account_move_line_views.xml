<odoo>
    <record id="view_move_seq_form_inherit_line_order" model="ir.ui.view">
        <field name="name">account.move.form.seq.line.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Invoice Lines -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[1]"
                   position="before">
                <field name="invoice_line_index"
                       readonly="1"
                       optional="show"/>
            </xpath>

            <!-- Journal Items -->
            <xpath expr="//field[@name='line_ids']/list/field[1]"
                   position="before">
                <field name="journal_line_index"
                       readonly="1"
                       optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>