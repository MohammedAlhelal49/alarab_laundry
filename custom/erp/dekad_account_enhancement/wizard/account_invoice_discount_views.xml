<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoice_discount_view_form" model="ir.ui.view">
        <field name="name">account.invoice.discount.form</field>
        <field name="model">account.invoice.discount</field>
        <field name="arch" type="xml">
            <form string="Apply Discount">
                <!-- Hidden technical field -->
                <field name="move_id" invisible="1"/>

                <sheet>
                    <div class="row">
                        <!-- Left column: numeric input -->
                        <div class="col-sm-5 col-md-4 col-lg-4 col-4">
                            <group>
                                <!-- Percentage input -->
                                <label for="discount_percentage"
                                       string="Discount (%)"
                                       invisible="discount_type == 'fixed_amount'"/>
                                <field name="discount_percentage"
                                       invisible="discount_type == 'fixed_amount'"
                                       nolabel="1"/>

                                <!-- Amount input -->
                                <label for="discount_amount"
                                       string="Discount Amount"
                                       invisible="discount_type != 'fixed_amount'"/>
                                <field name="discount_amount"
                                       invisible="discount_type != 'fixed_amount'"
                                       nolabel="1"/>
                            </group>
                        </div>

                        <!-- Right column: discount type radio -->
                        <div class="col-sm-7 col-md-8 col-lg-8 col-8">
                            <field name="discount_type" widget="radio" nolabel="1"/>
                        </div>
                    </div>
                </sheet>

                <footer>
                    <button name="action_apply_discount"
                            string="Apply"
                            type="object"
                            class="btn btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard"
                            class="btn btn-secondary"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
