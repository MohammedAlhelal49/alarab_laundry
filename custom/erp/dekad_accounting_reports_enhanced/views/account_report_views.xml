<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_report_form_view_secondary_currency" model="ir.ui.view">
        <field name="name">account.report.form.secondary.currency</field>
        <field name="model">account.report</field>
        <field name="inherit_id" ref="account_reports.account_report_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='filter_partner']" position="after">
                <field name="filter_secondary_currency" string="Secondary Currency"/>
                <field name="filter_hide_zero_balance" string="Hide Zero Balance"/>
                <field name="filter_hide_initial_balance" string="Hide Initial Balance"/>
            </xpath>
        </field>
    </record>

</odoo>