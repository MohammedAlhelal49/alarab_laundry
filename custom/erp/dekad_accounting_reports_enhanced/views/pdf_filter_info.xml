<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pdf_export_filters_custom"
              inherit_id="account_reports.pdf_export_filters">
        <xpath expr="//t[@t-if=&quot;options.get(&apos;company_currency&apos;)&quot;]" position="after">
            <t t-if="options.get('custom_filter_labels')">
                <div style="margin-top: 6px; border-top: 2px solid #875A7B; padding-top: 6px;">
                    <t t-foreach="options['custom_filter_labels']" t-as="label">
                        <t t-set="parts" t-value="label.split(': ', 1)"/>
                        <div style="margin-bottom: 4px; line-height: 1.4;">
                            <span style="font-weight: 700; color: #333333; font-size: 12px;">
                                <t t-out="parts[0]"/>:
                            </span>
                            <span style="color: #555555; font-size: 12px; margin-left: 4px;">
                                <t t-out="parts[1] if len(parts) > 1 else ''"/>
                            </span>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>