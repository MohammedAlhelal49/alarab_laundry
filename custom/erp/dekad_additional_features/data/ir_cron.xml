<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_company_attachment_notification" model="ir.cron">
            <field name="name">Company Attachment Expiry Notification</field>
            <field name="model_id" ref="model_company_attachment"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_attachment_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
