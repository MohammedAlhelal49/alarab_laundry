<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mail_template_company_attachment" model="mail.template">
            <field name="name">Company Attachment Expiry Notification</field>
            <field name="model_id" ref="model_company_attachment"/>
            <field name="subject">Company Attachment Expiry</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello,</p>

                    <p>The following attachment will expire soon.</p>

                    <ul>
                        <li><strong>Company:</strong> <t t-out="object.company_id.name"/></li>
                        <li><strong>Attachment:</strong> <t t-out="object.name"/></li>
                        <li><strong>Expiry Date:</strong> <t t-out="object.expiry_date"/></li>
                        <li><strong>Description:</strong> <t t-out="object.description or ''"/></li>
                    </ul>

                    <p>Please review the document.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>