<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_required_field_list" model="ir.ui.view">
        <field name="name">required.field.config.list</field>
        <field name="model">required.field.config</field>
        <field name="arch" type="xml">

            <list>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="required"/>
                <field name="duplicate_warning"/>
                <field name="prevent_duplicate"/>
            </list>

        </field>
    </record>

    <record id="view_required_field_form" model="ir.ui.view">
        <field name="name">required.field.config.form</field>
        <field name="model">required.field.config</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="model_id"/>

                        <field name="field_id"
                               domain="[('model_id', '=', model_id)]"/>

                        <field name="required"/>

                        <field name="duplicate_warning"/>
                        <field name="prevent_duplicate"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <record id="view_required_field_search" model="ir.ui.view">
        <field name="name">required.field.config.search</field>
        <field name="model">required.field.config</field>
        <field name="arch" type="xml">

            <search>

                <field name="model_id"/>

                <field name="field_id"/>

                <!-- Filters -->

                <filter name="required"
                        string="Required"
                        domain="[('required', '=', True)]"/>

                <filter name="duplicate_warning"
                        string="Duplicate Warning"
                        domain="[('duplicate_warning', '=', True)]"/>

                <filter name="prevent_duplicate"
                        string="Prevent Duplicate"
                        domain="[('prevent_duplicate', '=', True)]"/>

                <!-- Group By -->

                <group expand="0" string="Group By">

                    <filter name="group_model"
                            string="Model"
                            context="{'group_by': 'model_id'}"/>

                    <filter name="group_model"
                            string="Field"
                            context="{'group_by': 'field_id'}"/>
                </group>

            </search>

        </field>
    </record>

    <record id="required_field_action" model="ir.actions.act_window">
        <field name="name">Dynamic Field Rules</field>
        <field name="res_model">required.field.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_required_field_search"/>
    </record>

</odoo>