<odoo>
    <record id="view_partner_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_send_whatsapp"
                        string="WhatsApp"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"/>
            </xpath>
        </field>
    </record>
    <record id="view_partner_tree_inherit_company_editable" model="ir.ui.view">
        <field name="name">res.partner.tree.company.editable</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="replace">

                <!-- Editable version: only for sales groups -->
                <field name="company_id"
                       groups="sales_team.group_sale_manager,sales_team.group_sale_salesman_all_leads"
                       readonly="0"
                       optional="show"/>

                <!-- Readonly version: for everyone else -->
                <field name="company_id"
                       groups="!sales_team.group_sale_manager,!sales_team.group_sale_salesman_all_leads"
                       readonly="1"
                       optional="show"/>

            </xpath>


        </field>
    </record>
    <record id="view_partner_form_inherit_user_field" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.user.field</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field string="User" invisible="related_user_id == False" name="related_user_id" readonly="1"/>
            </xpath>
        </field>
    </record>
    <function model="res.partner" name="handle_current_users_contacts" eval="[[]]"/>
</odoo>
