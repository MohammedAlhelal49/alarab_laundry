<odoo>
    <record id="view_send_whatsapp_wizard_form" model="ir.ui.view">
        <field name="name">send.whatsapp.wizard.form</field>
        <field name="model">send.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="template_id"/>
                    <field name="preview_message" readonly="1" nolabel="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_open_whatsapp"
                            string="Send via WhatsApp"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
