<odoo>
    <!-- List view -->
    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="message" widget="textarea"/>
                    </group>

                    <separator string="Available Placeholders"/>
                    <div class="alert alert-info" style="font-size:13px;">
                        <p>You can use the following placeholders in your message:</p>
                        <ul>
                            <li><code>{{partner_name}}</code>: Partner's name
                            </li>
                            <li><code>{{partner_phone}}</code>: Partner's phone number
                            </li>
                            <li><code>{{email}}</code>: Partner's email address
                            </li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_whatsapp_templates" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_whatsapp_templates"
              name="Whatsapp Templates"
              parent="contacts.res_partner_menu_config"
              action="dekad_additional_features.action_whatsapp_templates"/>
</odoo>
