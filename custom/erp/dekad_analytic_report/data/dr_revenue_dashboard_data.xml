<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_dashboard_group_medical" model="spreadsheet.dashboard.group">
        <field name="name">Analytic Account</field>
        <field name="sequence">50</field>
    </record>

    <record id="payment_method_line_company_rule" model="ir.rule">
        <field name="name">Payment Method Line multi-company inbound only</field>
        <field name="model_id" ref="account.model_account_payment_method_line"/>
        <field name="domain_force">
             ['&amp;',
                ('payment_type', '=', 'inbound'),
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'in', company_ids)
            ]
        </field>
        <field name="global" eval="True"/>
    </record>


    <record id="spreadsheet_dashboard_dr_revenue" model="spreadsheet.dashboard">
        <field name="name">Revenue</field>
        <field name="spreadsheet_binary_data" type="base64" file="dekad_analytic_report/data/files/dr_revenue_dashboard.json"/>
        <field name="sample_dashboard_file_path">dekad_analytic_report/data/files/dr_revenue_dashboard.json</field>
        <field name="main_data_model_ids" eval="[(4, ref('analytic.model_account_analytic_line'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_medical"/>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_user')), Command.link(ref('account.group_account_manager'))]"/>
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>
</odoo>
