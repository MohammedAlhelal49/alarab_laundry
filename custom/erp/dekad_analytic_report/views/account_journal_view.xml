<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_journal_form_inherit_payment_category" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.payment.category</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='page_incoming_payments']//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']" position="after">
                <field name="payment_category" optional="show"/>
            </xpath>

        </field>
    </record>

</odoo>
