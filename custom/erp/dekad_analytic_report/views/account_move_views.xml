<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_move_form_default_analytic" model="ir.ui.view">
        <field name="name">account.move.form.default.analytic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']/.." position="after">
                <field name="auto_account_id" readonly="state != 'draft'"
                />
            </xpath>

        </field>
    </record>
    <record id="view_account_journal_form_inherit_receivable_analytic" model="ir.ui.view">
        <field name="name">account.journal.form.receivable.analytic</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='refund_sequence']" position="after">
                <field name="apply_receivable_analytic"/>
            </xpath>

        </field>
    </record>

</odoo>