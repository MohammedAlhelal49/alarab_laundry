<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: run scheduled backups every 10 minutes -->
        <record id="cron_backup_database" model="ir.cron">
            <field name="name">Automatic database backup scheduler</field>
            <field name="model_id" ref="dekad_auto_database_backup.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.run_scheduled_backups()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: daily cleanup of old backups -->
        <record id="cron_clean_database_backup" model="ir.cron">
            <field name="name">Cleanup old database backups</field>
            <field name="model_id" ref="dekad_auto_database_backup.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.clean_database_backup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
