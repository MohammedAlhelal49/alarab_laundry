<odoo>

    <record id="action_account_move_line_report_pdf" model="ir.actions.report">
        <field name="name">Account Move Project Report</field>
        <field name="model">account.move.line.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_move_project_report.report_account_move_line_pdf</field>
        <field name="report_file">account_move_project_report.report_account_move_line_pdf</field>
        <field name="binding_model_id" ref="model_account_move_line_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_account_move_line_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">

                    <h2>Account Move Project Report</h2>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Journal Entry</th>
                                <th>Partner</th>
                                <th>Account</th>
                                <th>Project</th>
                                <th>Task</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>

                            <t t-set="total_debit" t-value="0"/>
                            <t t-set="total_credit" t-value="0"/>
                            <t t-set="total_balance" t-value="0"/>

                            <t t-foreach="docs" t-as="line">
                                <t t-set="total_debit" t-value="total_debit + line.debit"/>
                                <t t-set="total_credit" t-value="total_credit + line.credit"/>
                                <t t-set="total_balance" t-value="total_balance + line.balance"/>

                                <tr>
                                    <td>
                                        <t t-esc="line.date"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.move_id.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.partner_id.name or ''"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.account_id.code"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.project_id.name or ''"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.task_id.name or ''"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.debit"
                                              t-options='{"widget": "monetary", "display_currency": line.company_currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.credit"
                                              t-options='{"widget": "monetary", "display_currency": line.company_currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.balance"
                                              t-options='{"widget": "monetary", "display_currency": line.company_currency_id}'/>
                                    </td>
                                </tr>
                            </t>

                            <tr t-if="docs">
                                <td colspan="6">
                                    <strong>Total</strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="total_debit"
                                              t-options='{"widget": "monetary", "display_currency": docs[0].company_currency_id}'/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="total_credit"
                                              t-options='{"widget": "monetary", "display_currency": docs[0].company_currency_id}'/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="total_balance"
                                              t-options='{"widget": "monetary", "display_currency": docs[0].company_currency_id}'/>
                                    </strong>
                                </td>
                            </tr>

                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

</odoo>