<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_job_cost_project_multi_company" model="ir.rule">
            <field name="name">Job Cost Project: Multi-Company Filter</field>
            <field name="model_id" ref="model_job_cost_project"/>
