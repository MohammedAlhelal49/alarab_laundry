<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit_construction" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.construction</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Insert the button in the header button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_related_job_cost_project"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-folder-open"
                        invisible="job_cost_project_count == 0">
                    <div class="o_stat_info">
                        <field name="job_cost_project_count" class="o_stat_value"/>
                        <span class="o_stat_text">Job Cost Project</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
