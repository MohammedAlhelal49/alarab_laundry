<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_inherit_task" model="ir.ui.view">
        <field name="name">hr.expense.view.form.inherit.task</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="project_id" readonly="1"/>

                <field name="task_id"
                       options="{'no_create': True}"
                       domain="project_id and [('project_id', '=', project_id)] or []"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_sheet_view_form_inherit_task" model="ir.ui.view">
        <field name="name">hr.expense.sheet.view.form.inherit.task</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expense_line_ids']/list//field[@name='analytic_distribution']" position="after">
                <field name="project_id" optional="show"/>
                <field name="task_id" optional="show" domain="project_id and [('project_id', '=', project_id)] or []"/>
            </xpath>
        </field>
    </record>
</odoo>