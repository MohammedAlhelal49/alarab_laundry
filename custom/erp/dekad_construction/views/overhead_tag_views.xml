<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_cost_overhead_tag_list" model="ir.ui.view">
        <field name="name">job.cost.overhead.tag.list</field>
        <field name="model">job.cost.overhead.tag</field>
        <field name="arch" type="xml">
            <list string="Overhead Tags" editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="action_job_cost_overhead_tag" model="ir.actions.act_window">
        <field name="name">Overhead Tags</field>
        <field name="res_model">job.cost.overhead.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>