<odoo>

    <record id="view_account_move_project_report_wizard" model="ir.ui.view">
        <field name="name">account.move.project.report.wizard.form</field>
        <field name="model">account.move.project.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Account Move Project Report">
                <sheet>

                    <group col="2">

                        <group string="Commercial Filters">
                            <field name="partner_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>

                            <field name="account_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>

                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>

                        <group string="Project Filters">

                            <field name="project_id"
                                   options="{'no_create': True}"
                                   required="1"/>

                            <field name="task_ids"
                                   widget="many2many_tags"
                                   invisible="not project_id"
                                   options="{'no_create': True}"/>

                            <field name="journal_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>

                            <field name="currency_id"
                                   options="{'no_create': True, 'no_open': True}"/>

                        </group>

                    </group>

                </sheet>

                <footer>
                    <button name="action_preview"
                            type="object"
                            string="Preview"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_move_project_report_wizard" model="ir.actions.act_window">
        <field name="name">Account Move Project Report</field>
        <field name="res_model">account.move.project.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>