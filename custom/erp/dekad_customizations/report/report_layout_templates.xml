<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- LIGHT / STANDARD                                          -->
    <!-- ========================================================= -->

    <template id="external_layout_standard_header_image"
              inherit_id="web.external_layout_standard">

        <!-- ORIGINAL HEADER -->
        <xpath expr="//div[starts-with(@t-attf-class, 'header o_company_')]"
               position="attributes">
            <attribute name="t-if">not company.header_image</attribute>
        </xpath>

        <!-- CUSTOM HEADER -->
        <xpath expr="//div[starts-with(@t-attf-class, 'header o_company_')]"
               position="before">
            <div t-if="company.header_image"
                 t-attf-class="header o_company_#{company.id}_layout">
                <img t-att-src="image_data_uri(company.header_image)"
                     style="width: 100%; height: auto; display: block;"
                     alt="Header"/>
            </div>
        </xpath>


        <!-- ORIGINAL FOOTER -->
        <xpath expr="//div[starts-with(@t-attf-class, 'footer o_company_')]"
               position="attributes">
            <attribute name="t-if">not company.footer_image</attribute>
        </xpath>

        <!-- CUSTOM FOOTER -->
        <xpath expr="//div[starts-with(@t-attf-class, 'footer o_company_')]"
               position="before">
            <div t-if="company.footer_image"
                 t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <img t-att-src="image_data_uri(company.footer_image)"
                     style="width: 100%; height: auto; display: block;"
                     alt="Footer"/>
            </div>
        </xpath>

    </template>


