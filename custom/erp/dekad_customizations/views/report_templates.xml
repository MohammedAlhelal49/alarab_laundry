<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="external_layout_bilingual"
              name="Arabic / English">


        <t t-if="company._name == 'base.document.layout'">
            <t t-set="real_company"
               t-value="company.company_id"/>
        </t>

        <t t-else="">
            <t t-set="real_company"
               t-value="company"/>
        </t>


        <!-- ======================================================
             TRANSLATED COMPANY DETAILS
             ====================================================== -->

        <t t-set="company_details_en"
           t-value="real_company.with_context(lang='en_US').company_details"/>

        <t t-set="company_details_ar"
           t-value="real_company.with_context(lang='ar_001').company_details"/>


        <!-- ======================================================
             HEADER
             ====================================================== -->

        <t t-set="header_shape_height" t-value="'230'"/>

        <div t-attf-class="
                header
                o_company_#{company.id}_layout
                o_bilingual_report_header
                {{report_type != 'pdf' and 'h-0'}}
             ">


            <svg t-attf-class="
                    o_bilingual_header_wave
                    {{report_type == 'pdf'
                       and 'position-fixed'
                       or 'position-absolute'}}
                    top-0
                    z-n1
                 "
                 t-attf-style="
                    {{report_type != 'pdf'
                       and 'left: -48px; width: calc(100% + 96px);'
                       or 'left: 0; width: 100%;'}}
                 "
                 preserveAspectRatio="none"
                 t-att-height="header_shape_height"
                 viewBox="0 0 1000 240"
                 fill="none"
                 xmlns="http://www.w3.org/2000/svg">


                <!-- ==============================================
                     MAIN HEADER BACKGROUND
                     ============================================== -->

                <path d="
                    M0 0
                    H1000
                    V190
                    C800 205 650 135 480 170
                    C300 205 150 175 0 195
                    Z
                "
                t-att-fill="company.primary_color"
                fill-opacity=".10"/>


                <!-- ==============================================
                     DECORATIVE BOTTOM WAVE
                     ============================================== -->

                <path d="
                    M0 170
                    C180 140 320 205 500 170
                    C680 135 820 195 1000 155
                    V180
                    C820 215 680 160 500 195
                    C300 225 160 175 0 205
                    Z
                "
                t-att-fill="company.secondary_color"
                fill-opacity=".18"/>

            </svg>


            <!-- ==================================================
                 HEADER CONTENT
                 ================================================== -->

            <div class="o_bilingual_header_content">

                <div class="o_bilingual_header_row">


                    <!-- ==========================================
                         ENGLISH COMPANY DETAILS
                         LEFT
                         ========================================== -->

                    <div class="
                            o_bilingual_company_info
                            o_bilingual_english
                         "
                         dir="ltr">

                        <div t-if="company_details_en"
                             class="o_bilingual_company_details">

                            <t t-out="company_details_en"/>

                        </div>

                    </div>


                    <!-- ==========================================
                         LOGO
                         CENTER
                         ========================================== -->

                    <div class="o_bilingual_logo_container">

                        <div class="o_bilingual_logo_wrapper">

                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 class="o_bilingual_company_logo"
                                 alt="Logo"/>

                        </div>

                    </div>


                    <!-- ==========================================
                         ARABIC COMPANY DETAILS
                         RIGHT
                         ========================================== -->

                    <div class="
                            o_bilingual_company_info
                            o_bilingual_arabic
                         "
                         dir="rtl"
                         lang="ar">

                        <div t-if="company_details_ar"
                             class="o_bilingual_company_details">

                            <t t-out="company_details_ar"/>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ======================================================
             BODY
             STANDARD ODOO WAVE BODY
             ====================================================== -->

        <t t-set="layout_background_url"
           t-value="
                'data:image/png;base64,%s'
                % company.layout_background_image.decode('utf-8')
                if company.layout_background_image
                   and company.layout_background == 'Custom'
                else
                '/base/static/img/demo_logo_report.png'
                if company.layout_background == 'Demo logo'
                else ''
           "/>


        <div t-attf-class="
                article
                o_report_layout_wave
                o_table_striped
                o_company_#{company.id}_layout
                {{'o_report_layout_background'
                  if company.layout_background != 'Blank'
                  else ''}}
             "

             t-attf-style="
                {{report_type != 'pdf'
                  and 'margin-top:' + header_shape_height + 'px;'
                  or ''}}

                {{'background-image: url(%s);'
                  % layout_background_url
                  if layout_background_url
                  else ''}}
             "

             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="
                o and o.env.context.get('lang')
             ">


            <!-- ==============================================
                 STANDARD ODOO WAVE CUSTOMER ADDRESS
                 ============================================== -->

            <t t-set="custom_layout_address"
               t-value="true"/>

            <t t-call="web.address_layout"/>


            <!-- ==============================================
                 DOCUMENT TITLE
                 ============================================== -->

            <h2 t-out="layout_document_title"/>


            <!-- ==============================================
                 ACTUAL REPORT
                 Invoice / Sale Order / PO / etc.
                 ============================================== -->

            <t t-out="0"/>

        </div>


        <!-- ======================================================
             FOOTER
             ====================================================== -->

        <div t-attf-class="
                footer
                o_company_#{company.id}_layout
                o_bilingual_report_footer
                {{report_type != 'pdf'
                   and 'position-relative mt-auto mx-n5'}}
             ">


            <!-- ==================================================
                 FOOTER BACKGROUND

                 Keep the same behavior that is already working
                 correctly in both preview and PDF.
                 ================================================== -->

            <svg t-attf-class="
                    o_bilingual_footer_wave
                    {{report_type == 'pdf'
                       and 'position-fixed start-0'}}
                    w-100
                 "
                 preserveAspectRatio="none"
                 t-att-height="
                    report_type == 'pdf'
                    and '130'
                    or '110'
                 "
                 viewBox="0 0 1000 130"
                 fill="none"
                 xmlns="http://www.w3.org/2000/svg">

                <path d="
                    M0 55
                    C180 15 340 80 520 45
                    C700 10 850 65 1000 30
                    V130
                    H0
                    Z
                "
                t-att-fill="company.secondary_color"
                fill-opacity=".10"/>

            </svg>


            <!-- ==================================================
                 CENTERED FOOTER CONTENT
                 ================================================== -->

            <div t-attf-class="
                    o_footer_content
                    o_bilingual_footer_content
                    {{report_type != 'pdf'
                       and 'position-absolute end-0 start-0 bottom-0 mx-3'}}
                 ">


                <!-- ==============================================
                     COMPANY FOOTER
                     ============================================== -->

                <div t-if="company.report_footer"
                     class="o_bilingual_footer_text">

                    <span t-field="company.report_footer"/>

                </div>


                <!-- ==============================================
                     DOCUMENT NAME
                     ============================================== -->

                <div t-if="
                        report_type == 'pdf'
                        and display_name_in_footer
                     "
                     class="
                        text-muted
                        o_bilingual_footer_document
                     ">

                    <span t-out="o.name"/>

                </div>


                <!-- ==============================================
                     PAGE NUMBER
                     ============================================== -->

                <div t-if="report_type == 'pdf'"
                     class="
                        text-muted
                        o_bilingual_page_number
                     ">

                    Page
                    <span class="page"/>
                    /
                    <span class="topage"/>

                </div>

            </div>

        </div>

    </template>

</odoo>