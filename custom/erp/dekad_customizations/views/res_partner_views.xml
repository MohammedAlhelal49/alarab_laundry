<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_properties" model="ir.ui.view">
        <field name="name">res.partner.form.properties</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="before">

                <!-- Required as the definition record -->
                <field name="property_set_id" invisible="1"/>

                <field
                    name="custom_properties"
                    columns="2"
                />

            </xpath>

        </field>
    </record>

</odoo>