<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_form_properties" model="ir.ui.view">
        <field name="name">sale.order.form.properties</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="before">

                <!-- Required by the Properties widget -->
                <field name="property_set_id" invisible="1"/>

                <field
                    name="custom_properties"
                    columns="2"
                />

            </xpath>

        </field>
    </record>

</odoo>