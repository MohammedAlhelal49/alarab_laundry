<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_duplicate_contact_warning" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.duplicate.contact.warning</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning oe_edit_only" name="warning_duplicate_contact"
                     invisible="not same_contact_partner_id">
                    A contact with the same
                    <span>
                        <field name="contact_conflict_label"/>
                    </span>
                    already exists:

                    <!-- Non clickable for pure salesman users -->
                    <span groups="sales_team.group_sale_salesman,!sales_team.group_sale_salesman_all_leads">
                        <field name="same_contact_partner_id"
                               options="{'no_open': True}"
                               context="{'show_address': False, 'show_vat': False}"/>
                    </span>
                    . Are you sure you want to continue?

                    <!-- Clickable for all_leads + managers -->
                    <span groups="sales_team.group_sale_salesman_all_leads,sales_team.group_sale_manager">
                        <field name="same_contact_partner_id"
                               context="{'show_address': False, 'show_vat': False}"/>
                    </span>

                    . Are you sure you want to continue?
                </div>
            </xpath>
        </field>
    </record>
</odoo>
