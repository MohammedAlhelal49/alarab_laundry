<odoo>
    <record id="res_config_settings_view_form_distance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.distance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="after">
                <block title="GPS Control">
                    <setting string="Maximum Allowed Distance">
                        <field name="attendance_max_distance"
                               class="text-center"
                               style="width: 10ch;"/>
                        <span class="ms-2">meters</span>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>