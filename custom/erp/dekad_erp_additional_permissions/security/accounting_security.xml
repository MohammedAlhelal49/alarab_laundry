<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_accounting_additional_permissions">
            <field name="name">Accounting Additional Permissions</field>
            <field name="sequence">10</field>
        </record>


        <!-- Group: Allows posting journal entries or vendor bills -->
        <record id="group_account_move_post" model="res.groups">
            <field name="name">Allow Posting Accounting Entries</field>
            <field name="category_id" ref="module_category_accounting_additional_permissions"/>
        </record>

        <!-- Group: Allows cancelling journal entries or vendor bills -->
        <record id="group_account_move_cancel" model="res.groups">
            <field name="name">Allow Cancelling Accounting Entries</field>
            <field name="category_id" ref="module_category_accounting_additional_permissions"/>
        </record>

        <!-- Group: Allows deleting accounting entries -->
        <record id="group_account_move_delete" model="res.groups">
            <field name="name">Allow Deleting Accounting Entries</field>
            <field name="category_id" ref="module_category_accounting_additional_permissions"/>
        </record>

        <!-- Group: Allows resetting posted accounting entries back to draft -->
        <record id="group_account_move_reset_to_draft" model="res.groups">
            <field name="name">Allow Reset to Draft</field>
            <field name="category_id" ref="module_category_accounting_additional_permissions"/>
        </record>


                <!-- Category -->
        <record model="ir.module.category" id="module_category_chart_of_account_permissions">
            <field name="name">Chart of Account Additional Permissions</field>
            <field name="sequence">10</field>
        </record>


           <!-- Group: Allow create accounts -->
        <record id="group_account_account_create" model="res.groups">
            <field name="name">Allow Creating Accounts</field>
            <field name="category_id" ref="dekad_erp_additional_permissions.module_category_chart_of_account_permissions"/>
        </record>


        <!-- Group: Allow delete accounts -->
        <record id="group_account_account_delete" model="res.groups">
            <field name="name">Allow Deleting Accounts</field>
            <field name="category_id" ref="dekad_erp_additional_permissions.module_category_chart_of_account_permissions"/>
        </record>


        <!-- ====================================================== -->
        <!-- PAYMENT PERMISSIONS CATEGORY -->
        <!-- ====================================================== -->

        <record model="ir.module.category"
                id="module_category_account_payment_permissions">
            <field name="name">Payment Additional Permissions</field>
            <field name="sequence">11</field>
        </record>


        <!-- ====================================================== -->
        <!-- PAYMENT GROUPS -->
        <!-- ====================================================== -->

        <record id="group_account_payment_confirm" model="res.groups">
            <field name="name">Allow Confirm Payments</field>
            <field name="category_id"
                   ref="dekad_erp_additional_permissions.module_category_account_payment_permissions"/>
        </record>

        <record id="group_account_payment_cancel" model="res.groups">
            <field name="name">Allow Cancel Payments</field>
            <field name="category_id"
                   ref="dekad_erp_additional_permissions.module_category_account_payment_permissions"/>
        </record>

        <record id="group_account_payment_delete" model="res.groups">
            <field name="name">Allow Delete Payments</field>
            <field name="category_id"
                   ref="dekad_erp_additional_permissions.module_category_account_payment_permissions"/>
        </record>

        <record id="group_account_payment_draft" model="res.groups">
            <field name="name">Allow Reset Payments To Draft</field>
            <field name="category_id"
                   ref="dekad_erp_additional_permissions.module_category_account_payment_permissions"/>
        </record>

    </data>
</odoo>
