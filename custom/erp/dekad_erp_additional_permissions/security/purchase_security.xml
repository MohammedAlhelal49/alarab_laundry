<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_purchase_additional_permissions">
            <field name="name">Purchase Additional Permissions</field>
            <field name="sequence">12</field>
        </record>

        <!-- Group: Allows users to confirm purchase orders -->
        <record id="group_purchase_order_confirm" model="res.groups">
            <field name="name">Allow Purchase Order Confirm</field>
            <field name="category_id" ref="module_category_purchase_additional_permissions"/>
        </record>

        <!-- Group: Allows users to cancel purchase orders -->
        <record id="group_purchase_order_cancel" model="res.groups">
            <field name="name">Allow Purchase Order Cancel</field>
            <field name="category_id" ref="module_category_purchase_additional_permissions"/>
        </record>

        <!-- Group: Allows users to delete purchase orders -->
        <record id="group_purchase_order_delete" model="res.groups">
            <field name="name">Allow Purchase Order Delete</field>
            <field name="category_id" ref="module_category_purchase_additional_permissions"/>
        </record>


        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dekad_erp_additional_permissions.group_purchase_order_confirm')),
                                              (4, ref('dekad_erp_additional_permissions.group_purchase_order_cancel')),
                                              (4, ref('dekad_erp_additional_permissions.group_purchase_order_delete'))]"/>
        </record>
    </data>
</odoo>
