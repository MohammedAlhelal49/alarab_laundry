<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_sales_additional_permissions">
            <field name="name">Sales Additional Permissions</field>
            <field name="sequence">12</field>
        </record>

        <!-- Group to allow deleting Sale Orders -->
        <record id="group_sale_order_deletion" model="res.groups">
            <field name="name">Allow Sale Order Deletion</field>
            <field name="category_id" ref="module_category_sales_additional_permissions"/>
        </record>

        <!-- Group to allow canceling Sale Orders -->
        <record id="group_sale_order_cancel" model="res.groups">
            <field name="name">Allow Sale Order Cancel</field>
            <field name="category_id" ref="module_category_sales_additional_permissions"/>
        </record>

        <!-- Group to allow confirming Sale Orders -->
        <record id="group_sale_order_confirm" model="res.groups">
            <field name="name">Allow Sale Order Confirm</field>
            <field name="category_id" ref="module_category_sales_additional_permissions"/>
        </record>


    </data>
</odoo>
