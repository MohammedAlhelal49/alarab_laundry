<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="hr_employee_form_inherit_bro" model="ir.ui.view">
        <field name="name">hr.employee.form.bro.field</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="pro_id" widget="many2one_avatar_user"/>
            </xpath>
            <xpath expr="//field[@name='private_phone']" position="after">
                <field name="labor_card_number"/>
            </xpath>

             <xpath expr="//page[@name='hr_settings']//group[@name='active_group']" position="inside">
                <field name="last_working_date"/>
                <field name="cancellation_date"/>
            </xpath>
            <xpath expr="//page[@name='personal_information']//group[@name='identification_id']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//group[@name='passport_id']" position="replace"/>

            <xpath expr="//page[@name='personal_information']//separator[@name='has_work_permit']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//field[@name='visa_no']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//field[@name='permit_no']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//field[@name='visa_expire']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//field[@name='work_permit_expiration_date']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//field[@name='work_permit_name']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//field[@name='has_work_permit']" position="replace"/>

            <xpath expr="//page[@name='personal_information']" position="after">
                <page name="documents" string="Documents"  groups="hr.group_hr_user">
                    <group>
                        <group string="Identification ID">
                            <field name="identification_id"/>
                            <field name="id_expiry_date"
                                   groups="hr.group_hr_user"
                                   invisible="not identification_id"/>
                            <field name="identification_attachment_ids"
                                   groups="hr.group_hr_user"
                                   widget="many2many_binary"
                                   class="oe_inline"
                                   invisible="not identification_id"/>
                        </group>

                        <group string="Passport">
                            <field name="passport_id"/>
                            <field name="passport_expiry_date"
                                   groups="hr.group_hr_user"
                                   invisible="not passport_id"/>
                            <field name="passport_attachment_ids"
                                   groups="hr.group_hr_user"
                                   widget="many2many_binary"
                                   class="oe_inline"
                                   invisible="not passport_id"/>
                        </group>
                    </group>
                    <group>

                        <group string="Visa">
                            <field name="visa_no"/>
                            <field name="visa_expire"
                                   invisible="not visa_no"/>
                            <field name="visa_attachment_ids"
                                   widget="many2many_binary"
                                   class="oe_inline"
                                   invisible="not visa_no"/>
                        </group>
                        <group string="Insurance">
                            <field name="insurance_number"/>

                            <field name="insurance_expiry_date"
                                   invisible="not insurance_number"/>

                            <field name="insurance_attachment_ids"
                                   widget="many2many_binary"
                                   class="oe_inline"
                                   invisible="not insurance_number"/>
                        </group>

                        <group string="Work Permit">
                            <field name="permit_no"/>
                            <field name="work_permit_expiration_date"
                                   invisible="not permit_no"/>
                            <field name="work_permit_name" invisible="1"/>
                            <field name="has_work_permit"
                                   widget="work_permit_upload"
                                   filename="work_permit_name"
                                    invisible="not permit_no"/>
                        </group>

                    </group>
                </page>
            </xpath>

            <xpath expr="//page[@name='public']//field[@name='work_location_id']" position="after">
                    <group string="Employment" colspan="2">
                        <field name="employment_status"/>
                        <field name="employment_type"/>
                    </group>
            </xpath>

            <field name="joining_date" position="attributes">
                <attribute name="readonly">False</attribute>
            </field>

        </field>
    </record>

</odoo>