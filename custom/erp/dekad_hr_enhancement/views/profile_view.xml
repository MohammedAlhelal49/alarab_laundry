<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PROFILE FORM VIEW -->
    <record id="view_hr_employee_profile_form" model="ir.ui.view">
        <field name="name">hr.employee.profile.form</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form string="My Profile" create="0">
                <sheet>
                    <div class="d-flex align-items-center w-100 mb-2">

                        <div class="oe_title mw-75">
                            <h1 class="mb-0">
                                <field name="name" readonly="1"/>
                            </h1>
                            <h2 class="mb-0">
                                <field name="job_title" readonly="1"/>
                            </h2>
                        </div>

                        <div class="o_employee_avatar ms-auto">
                            <field name="image_1920"
                                   widget="image"
                                   class="oe_avatar"
                                   options='{"zoom": true, "preview_image":"avatar_128"}'/>
                        </div>

                    </div>
                    <group>
                        <group>
                            <field name="work_email" readonly="1" widget="email" placeholder="e.g. johndoe@example.com"/>
                            <field name="work_phone" readonly="1" widget="phone"/>
                            <field name="mobile_phone" readonly="1" widget="phone"/>
                        </group>
                        <group>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1" context="{'default_no_of_recruitment': 0, 'default_is_favorite': False}" placeholder="e.g. Sales Manager"/>
                            <field name="parent_id" readonly="1"/>
                            <field name="coach_id" readonly="1"/>
                            <field name="pro_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="private_contact" string="Private Contact">
                            <group>
                                <group string="Address">
                                    <label for="private_street" string="Private Address"/>
                                    <div class="o_address_format">
                                        <field name="private_street" placeholder="Street..." class="o_address_street"/>
                                        <field name="private_street2" placeholder="Street 2..." class="o_address_street"/>
                                        <field name="private_city" placeholder="City" class="o_address_city"/>
                                        <field name="private_state_id" class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'default_country_id': private_country_id}"/>
                                        <field name="private_zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="private_country_id" placeholder="Country" class="o_address_country"
                                               options='{"no_open": true, "no_create": true}'/>
                                    </div>
                                    <field name="private_email" placeholder="e.g. myprivateemail@example.com"/>
                                    <field name="private_phone"/>
                                    <field name="bank_account_id"
                                           context="{'default_partner_id': work_contact_id}"
                                           options="{'no_quick_create': True}"
                                           readonly="not id"/>
                                    <label for="distance_home_work"/>
                                    <div class="o_row" name="div_km_home_work">
                                        <field name="distance_home_work" class="o_hr_narrow_field"/>
                                        <span><field name="distance_home_work_unit"/></span>
                                    </div>
                                    <field name="private_car_plate"/>
                                </group>
                            </group>
                        </page>
                        <page name="citizenship" string="Citizenship">
                            <group>
                                <group string="Citizenship Details">
                                    <field name="country_id" options='{"no_open": true, "no_create": true}'/>
                                    <field name="identification_id"/>
                                    <field name="ssnid"/>
                                    <field name="passport_id"/>
                                    <field name="gender"/>
                                    <field name="birthday"/>
                                    <field name="place_of_birth"/>
                                    <field name="country_of_birth"/>
                                </group>
                            </group>
                        </page>
                        <page name="emergency" string="Emergency &amp; Family">
                            <group>
                                <group string="Emergency Contact">
                                    <field name="emergency_contact"/>
                                    <field name="emergency_phone" class="o_force_ltr"/>
                                </group>
                                <group string="Family Status">
                                    <field name="marital"/>
                                    <field name="spouse_complete_name"
                                           invisible="marital not in ['married', 'cohabitant']"/>
                                    <field name="spouse_birthdate"
                                           invisible="marital not in ['married', 'cohabitant']"/>
                                    <field name="children"/>
                                </group>
                                <group name="family_info_ids" colspan="4" string="Dependence Details">
                                    <field name="family_info_ids">
                                        <list editable="bottom">
                                            <field name="member_name" required="1"/>
                                            <field name="relation_id" required="1"/>
                                            <field name="member_contact"/>
                                            <field name="birth_date"/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page name="education" string="Education &amp; Work Permit">
                            <group>
                                <group string="Education">
                                    <field name="certificate"/>
                                    <field name="study_field"/>
                                    <field name="study_school"/>
                                </group>
                                <group string="Work Permit">
                                    <field name="visa_no"/>
                                    <field name="permit_no"/>
                                    <field name="visa_expire"/>
                                    <field name="work_permit_expiration_date"/>
                                    <field name="work_permit_name" invisible="1"/>
                                    <field name="has_work_permit"
                                           widget="work_permit_upload"
                                           filename="work_permit_name"/>
                                </group>
                                <group name="identification_id" string="Identification ID">
                                    <field name="identification_id"/>
                                    <field name="id_expiry_date" groups="hr.group_hr_user"
                                           invisible="identification_id in [None,False]"/>
                                    <field name="identification_attachment_ids" groups="hr.group_hr_user" widget="many2many_binary"
                                           class="oe_inline" invisible="identification_id in [None,False]"/>
                                </group>
                                <group name="passport_id" string="Passport ID">
                                    <field name="passport_id"/>
                                    <field name="passport_expiry_date" groups="hr.group_hr_user"
                                           invisible="passport_id in [None,False]"/>
                                    <field name="passport_attachment_ids" groups="hr.group_hr_user" widget="many2many_binary"
                                           class="oe_inline" invisible="passport_id in [None,False]"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_profile" model="ir.actions.server">
        <field name="name">My Profile</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.employee'].action_open_my_profile()</field>
    </record>

    <menuitem
        id="menu_hr_employee_profile"
        name="My Profile"
        parent="hr.menu_hr_employee_payroll"
        action="action_hr_employee_profile"
        sequence="100"
        groups="base.group_user"/>

</odoo>

