<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- view_stock_move_line_operation_tree — Delivery Moves -->
    <record id="view_move_line_operation_tree_tracking" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.tracking</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='quantity']" position="before">
                <field name="x_order_confirm_date"
                       optional="show"
                       readonly="1"/>
                <field name="x_preparing_order_date"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipping_order_date"
                       optional="show"
                       readonly="1"/>
                <field name="x_shipment_delivery_date"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipment_company"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipment_method"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_is_intercompany_dest" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- view_stock_move_line_detailed_operation_tree — Receipt Moves -->
    <record id="view_move_line_detailed_operation_tree_tracking" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.tracking2</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='quantity']" position="before">
                <field name="x_order_confirm_date"
                       optional="show"
                       readonly="1"/>
                <field name="x_preparing_order_date"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipping_order_date"
                       optional="show"
                       readonly="1"/>
                <field name="x_shipment_delivery_date"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipment_company"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipment_method"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_is_intercompany_dest" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>