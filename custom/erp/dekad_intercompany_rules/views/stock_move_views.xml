<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_move_tree_inherit_tracking" model="ir.ui.view">
        <field name="name">stock.picking.move.list.tracking</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_enterprise.stock_enterprise_move_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_order_confirm_date"
                       optional="show"
                       readonly="1"/>
                <field name="x_preparing_order_date"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipping_order_date"
                       optional="show"
                       readonly="1"/>
                <field name="x_shipment_delivery_date"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipment_company"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_shipment_method"
                       optional="show"
                       readonly="x_is_intercompany_dest"/>
                <field name="x_is_intercompany_dest" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>