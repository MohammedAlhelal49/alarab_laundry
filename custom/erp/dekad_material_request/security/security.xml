<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ==================== CATEGORY ==================== -->
        <record id="module_category_gmr" model="ir.module.category">
            <field name="name">General Material Request</field>
            <field name="sequence">10</field>
            <field name="exclusive" eval="False"/>
        </record>

        <!-- ==================== GROUPS ====================
             Hierarchical chain: User ⊂ Approver ⊂ Admin.
             Each level implies the one below it, so Odoo renders this
             category as a single radio-button (dropdown-style) selector
             on the res.users form instead of independent checkboxes.
             Assigning "Admin" automatically grants Approver + User too. -->
        <record id="group_gmr_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_gmr"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Create and submit material requests. View own requests only.</field>
        </record>

        <record id="group_gmr_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_category_gmr"/>
            <field name="implied_ids" eval="[(4, ref('group_gmr_user'))]"/>
            <field name="comment">Everything a User can do, plus approve or reject material requests assigned to them.</field>
        </record>

        <record id="group_gmr_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_gmr"/>
            <field name="implied_ids" eval="[(4, ref('group_gmr_approver'))]"/>
            <field name="comment">Everything an Approver can do, plus full access: create POs and Vendor Bills.</field>
        </record>

    </data>

    <!-- ==================== RECORD RULES ==================== -->
    <data noupdate="0">

        <!-- User: own requests only -->
        <record id="rule_gmr_request_user" model="ir.rule">
            <field name="name">GMR User: Own Requests Only</field>
            <field name="model_id" ref="model_gmr_request"/>
            <field name="domain_force">[('requested_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gmr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Approver: requests assigned to them only -->
        <record id="rule_gmr_request_approver" model="ir.rule">
            <field name="name">GMR Approver: Assigned Requests Only</field>
            <field name="model_id" ref="model_gmr_request"/>
            <field name="domain_force">[('approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gmr_approver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin: approved requests + requests assigned to him as approver -->
        <record id="rule_gmr_request_admin" model="ir.rule">
            <field name="name">GMR Admin: Approved + Assigned as Approver</field>
            <field name="model_id" ref="model_gmr_request"/>
            <field name="domain_force">['|', ('approver_id', '=', user.id), ('state', 'not in', ['draft', 'pending_approval', 'rejected'])]</field>
            <field name="groups" eval="[(4, ref('group_gmr_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Any role: delete own requests, Draft/Cancelled only. Separate rule
             (rather than enabling unlink on rule_gmr_request_user above) because
             a single ir.rule domain applies to every permission enabled on it,
             and we don't want the broader "own records" domain used for
             read/write to also govern unlink. Assigned to group_gmr_user, so
             it applies to Approver and Admin too via the implied hierarchy. -->
        <record id="rule_gmr_request_own_unlink" model="ir.rule">
            <field name="name">GMR: Delete Own Draft/Cancelled Requests Only</field>
            <field name="model_id" ref="model_gmr_request"/>
            <field name="domain_force">[('requested_by', '=', user.id), ('state', 'in', ['draft', 'cancelled'])]</field>
            <field name="groups" eval="[(4, ref('group_gmr_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>