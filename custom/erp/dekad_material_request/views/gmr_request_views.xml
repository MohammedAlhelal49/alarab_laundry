<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_gmr_request_form" model="ir.ui.view">
        <field name="name">gmr.request.form</field>
        <field name="model">gmr.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <!-- User: Submit -->
                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Approver + Admin: Approve / Reject -->
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'pending_approval'"
                            groups="dekad_material_request.group_gmr_approver,dekad_material_request.group_gmr_admin"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'pending_approval'"
                            groups="dekad_material_request.group_gmr_approver,dekad_material_request.group_gmr_admin"/>

                    <!-- Admin: Create PO / Bill -->
                    <button name="action_create_document"
                            string="Create PO / Bill"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="dekad_material_request.group_gmr_admin"/>

                    <!-- Owner: Reset to Draft (before decision, or after rejection to fix and resubmit) -->
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ['pending_approval', 'rejected'] or requested_by != uid"/>

                    <!-- Admin: Reset to Draft (rejected only, once approved the decision is final and cannot be reset).
                         Hidden when the current user is also the requester, since the Owner
                         Reset to Draft button above already covers that exact case. -->
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected' or requested_by == uid"
                            groups="dekad_material_request.group_gmr_admin"/>

                    <!-- Owner: Cancel (only before an approval decision is made) -->
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ['draft', 'pending_approval'] or requested_by != uid"/>

                    <!-- Approver/Admin: Cancel (draft/approved — NOT pending_approval, that's Approve/Reject territory).
                         Hidden on draft when the current user is also the requester, since the
                         Owner Cancel button above already covers that exact case. -->
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ['draft', 'approved'] or (state == 'draft' and requested_by == uid)"
                            groups="dekad_material_request.group_gmr_approver,dekad_material_request.group_gmr_admin"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,done"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0"
                                groups="dekad_material_request.group_gmr_admin">
                            <field name="purchase_order_count" widget="statinfo" string="PO"/>
                        </button>
                        <button name="action_view_vendor_bills"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="account_move_count == 0"
                                groups="dekad_material_request.group_gmr_admin">
                            <field name="account_move_count" widget="statinfo" string="Bills"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="analytic_account_id"
                                   string="Analytic Account"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="has_linked_projects" invisible="1"/>
                            <field name="project_id"
                                   required="has_linked_projects"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="requested_by_name" readonly="1"/>
                            <field name="approver_id"
                                   domain="[('is_gmr_approver', '=', True)]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="submit_date" invisible="not submit_date"/>
                            <field name="vendor_id"
                                   groups="dekad_material_request.group_gmr_admin"
                                   options="{'no_create': True}"
                                   readonly="state in ('po_created', 'bill_created', 'done')"/>
                        </group>
                    </group>

                    <!-- Summary -->
                    <group invisible="state == 'draft'">
                        <group>
                            <field name="total_qty" string="Total Requested Qty"/>
                            <field name="total_approved_qty" string="Total Approved Qty"/>
                            <field name="line_count" string="Lines"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Request Lines" name="request_lines">
                            <button name="action_open_add_products_wizard"
                                    string="Add Products"
                                    type="object"
                                    class="btn-secondary mb-2"
                                    icon="fa-plus"
                                    invisible="state != 'draft'"/>
                            <field name="request_line_ids"
                                   readonly="state in ('po_created', 'bill_created', 'done')">
                                <list editable="bottom"
                                      create="parent.state == 'draft'"
                                      delete="parent.state == 'draft'">
                                    <field name="state" column_invisible="1"/>
                                    <field name="can_edit_approved_qty" column_invisible="1"/>
                                    <field name="project_id" column_invisible="1"/>
                                    <field name="product_id" readonly="state != 'draft'"/>
                                    <field name="task_id"
                                           domain="[('project_id', '=', project_id)]"
                                           required="project_id"
                                           options="{'no_create': True}"
                                           readonly="state != 'draft'"/>
                                    <field name="qty" readonly="state != 'draft'"/>
                                    <field name="approved_qty"
                                           readonly="not can_edit_approved_qty"
                                           column_invisible="parent.state == 'draft'"/>
                                    <field name="vendor_id"
                                           groups="dekad_material_request.group_gmr_admin"
                                           options="{'no_create': True}"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="notes" readonly="state != 'draft'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approval" name="approval"
                              invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="approved_by_name" readonly="1"
                                           invisible="not approved_by_name"/>
                                    <field name="approval_date" readonly="1"
                                           invisible="not approval_date"/>
                                    <field name="cancelled_by_name" readonly="1"
                                           invisible="not cancelled_by_name"/>
                                    <field name="cancel_date" readonly="1"
                                           invisible="not cancel_date"/>
                                </group>
                                <group>
                                    <field name="approval_comment"
                                           placeholder="Approval comment..."
                                           readonly="state != 'pending_approval'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="description"
                                   placeholder="Additional notes..."
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== LIST VIEW ===================== -->
    <record id="view_gmr_request_list" model="ir.ui.view">
        <field name="name">gmr.request.list</field>
        <field name="model">gmr.request</field>
        <field name="arch" type="xml">
            <list string="Material Requests"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'pending_approval'"
                  decoration-danger="state in ['rejected', 'cancelled']"
                  decoration-success="state in ['approved', 'po_created', 'bill_created', 'done']">
                <field name="name"/>
                <field name="request_date"/>
                <field name="required_date" optional="show"/>
                <field name="analytic_account_id"/>
                <field name="requested_by_name" string="Requested By"/>
                <field name="approver_id"/>
                <field name="total_qty" string="Total Requested Qty"/>
                <field name="total_approved_qty" string="Total Approved Qty" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending_approval'"
                       decoration-danger="state in ['rejected', 'cancelled']"
                       decoration-success="state in ['approved', 'po_created', 'bill_created', 'done']"/>
            </list>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_gmr_request_search" model="ir.ui.view">
        <field name="name">gmr.request.search</field>
        <field name="model">gmr.request</field>
        <field name="arch" type="xml">
            <search string="Search Material Requests">
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="requested_by_name" string="Requested By"/>
                <field name="approver_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_pending"
                        domain="[('state', '=', 'pending_approval')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <filter string="Done" name="filter_done"
                        domain="[('state', 'in', ['po_created', 'bill_created', 'done'])]"/>
                <separator/>
                <filter string="My Requests" name="filter_my_requests"
                        domain="[('requested_by', '=', uid)]"/>
                <filter string="My Approvals" name="filter_my_approvals"
                        domain="[('approver_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Project / Department" name="group_analytic"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Approver" name="group_approver"
                            context="{'group_by': 'approver_id'}"/>
                    <filter string="Request Date" name="group_date"
                            context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTIONS ===================== -->
    <record id="action_gmr_request_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Material Request</p>
        </field>
    </record>

    <record id="action_gmr_request_mine" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="context">{'search_default_filter_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You have no material requests yet</p>
        </field>
    </record>

    <!-- Approver Tab 1: To Approve — pending only -->
    <record id="action_gmr_request_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="domain">[('approver_id', '=', uid), ('state', '=', 'pending_approval')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending requests assigned to you</p>
        </field>
    </record>

    <!-- Approver + Admin: Approved — every request that has passed approval,
         regardless of who approved it. Record rules still narrow this down
         per role (Admin sees all, Approver only their own); use the search
         filters/group-by (Status, Approver, ...) to slice further. -->
    <record id="action_gmr_request_approver_approved" model="ir.actions.act_window">
        <field name="name">Approved</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="domain">[('state', 'in', ['approved', 'po_created', 'bill_created', 'done'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approved requests yet</p>
        </field>
    </record>


    <!-- Admin: To Approve — pending assigned to him -->
    <record id="action_gmr_admin_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="domain">[('approver_id', '=', uid), ('state', '=', 'pending_approval')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending requests assigned to you</p>
        </field>
    </record>

    <!-- Admin: My Approvals — all states assigned to him -->
    <record id="action_gmr_admin_my_approvals" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="domain">[('approver_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No requests assigned to you</p>
        </field>
    </record>

    <!-- Admin: Cancelled -->
    <record id="action_gmr_request_approved" model="ir.actions.act_window">
        <field name="name">Cancelled</field>
        <field name="res_model">gmr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gmr_request_search"/>
        <field name="domain">[('state', '=', 'cancelled')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cancelled requests</p>
        </field>
    </record>

</odoo>