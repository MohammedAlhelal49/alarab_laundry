<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_gmr" model="ir.ui.view">
        <field name="name">purchase.order.form.gmr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gmr_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        invisible="gmr_request_count == 0">
                    <field name="gmr_request_count" widget="statinfo" string="Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
