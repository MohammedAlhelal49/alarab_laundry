<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gmr_add_products_wizard_form" model="ir.ui.view">
        <field name="name">gmr.add.products.wizard.form</field>
        <field name="model">gmr.add.products.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Products">
                <field name="request_id" invisible="1"/>
                <field name="project_id" invisible="1"/>
                <group>
                    <field name="task_id" options="{'no_create': True}"/>
                </group>
                <group>
                    <group>
                        <field name="search_name" string="Search (Name / Reference)"
                               placeholder="e.g. cable, PVC pipe, SKU-123..."/>
                    </group>
                </group>
                <button name="action_search_products"
                        string="Search / Filter"
                        type="object"
                        class="btn-secondary"/>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="project_id" column_invisible="1"/>
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="is_favorite" widget="boolean_favorite" readonly="1" nolabel="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="default_code" string="Reference"/>
                        <field name="qty" readonly="not selected"/>
                        <field name="task_id"
                               readonly="not selected"
                               domain="[('project_id', '=', project_id)]"
                               options="{'no_create': True}"/>
                        <field name="product_uom_id" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_add_to_request"
                            string="Add Selected Products"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gmr_add_products_wizard" model="ir.actions.act_window">
        <field name="name">Add Products</field>
        <field name="res_model">gmr.add.products.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>