<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--  Extend OrderReceipt -->
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

  <xpath expr="//ReceiptHeader" position="before">

            <div t-if="props.data.headerData.company.country_id.name == 'United Arab Emirates'" class="text-center mb-2"
                 style="font-size: 18px; font-weight: bold;">
                Tax Invoice
            </div>
        </xpath>

        <!-- Add Customer name before "Powered by Odoo" -->
        <xpath expr="//div[@class='pos-receipt-order-data']/p[.='Powered by Odoo']" position="before">
            <t t-if="props.data.partner_name">
                <div class="pos-receipt-order-data mt-3 text-center">
                    <div style="font-weight: bold; font-size: 18px;">
                        Customer :
                    </div>
                    <div style="font-size: 16px;">
                        <t t-esc="props.data.partner_name"/>
                    </div>
                </div>
                <br/>
            </t>
        </xpath>
    </t>
</templates>