<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="dekad_pos_sale_enhancement.ProductInfoPopup"
       t-inherit="point_of_sale.ProductInfoPopup"
       t-inherit-mode="extension">

        <xpath expr="//div[@class='section-financials-body d-flex flex-column']/table[1]"
               position="inside">

            <tr>
                <td>Minimum Price:</td>
                <td>
                    <t t-esc="env.utils.formatCurrency(props.product.min_price)"/>
                </td>
            </tr>

            <tr>
                <td>Maximum Price:</td>
                <td>
                    <t t-esc="env.utils.formatCurrency(props.product.max_price)"/>
                </td>
            </tr>

        </xpath>

    </t>

</templates>