<odoo>

        <!-- WhatsApp button for Account Move (Invoice) Form -->
    <record id="view_invoice_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_send_whatsapp"
                        string="WhatsApp"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"/>
            </xpath>
        </field>
    </record>

</odoo>
