<odoo>

    <!-- base structure of product.template, common with product.product -->
    <record id="view_product_template_min_max_price" model="ir.ui.view">
        <field name="name">product.template.form.min.max.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="min_price"/>
                <field name="max_price"/>
            </xpath>
            <xpath expr="//field[@name='available_in_pos']" position="before">
                    <field name="is_additional_charge"/>
                    <label for="is_additional_charge" string="Additional Charge"/>
            </xpath>
        </field>
    </record>


    <record id="product_variant_easy_edit_view_inherited" model="ir.ui.view">
        <field name="name">product.variant.easy.edit.view.inherited</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricing']" position="inside">
                <label for="min_price" string="Minimum Sale Price"/>
                <div class="o_row">
                    <field name="min_price" class="oe_inline" widget="monetary"
                           options="{'currency_field': 'currency_id', 'field_digits': True}"
                    />
                </div>

                <label for="max_price" string="Maximum Sale Price"/>
                <div class="o_row">
                    <field name="max_price" class="oe_inline" widget="monetary"
                           options="{'currency_field': 'currency_id', 'field_digits': True}"
                    />
                </div>

            </xpath>
        </field>
    </record>

    <!-- Inherit the normalized POS product form view used in POS product editing -->
    <record id="product_product_view_form_normalized_min_max_price" model="ir.ui.view">
        <field name="name">product.product.view.form.normalized.min.max.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_view_form_normalized"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="min_price"/>
                <field name="max_price"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_config_form_inherit_price_override" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.price.override</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_posbox']/ancestor::setting[1]" position="after">
                <setting string="Price Override Control"
                         help="Allow prices outside the configured min/max range for products.">
                    <field name="allow_price_override"/>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_inherit_uom_prices_pos_view" model="ir.ui.view">
        <field name="name">product.template.form.uom.prices.pos.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']/group" position="inside">
                <group name="multi_uom" string="POS UOM items ">
                    <field name="multi_uom_price_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="uom_id" context="{'default_category_id': category_id}"
                                   options="{'no_create': True}"></field>
                        </list>
                    </field>
                </group>
            </xpath>

        </field>
    </record>
    <record id="product_form_inherit_uom_prices_pos_view" model="ir.ui.view">
        <field name="name">product.form.uom.prices.pos.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']/group" position="inside">
                <group name="multi_uom" string="POS UOM items">
                    <field name="multi_uom_price_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="uom_id" context="{'default_category_id': category_id}"
                                   options="{'no_create': True}"></field>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
