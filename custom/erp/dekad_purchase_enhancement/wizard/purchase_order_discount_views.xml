<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_discount_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.discount.form</field>
        <field name="model">purchase.order.discount</field>
        <field name="arch" type="xml">
            <form string="Discount">
                <sheet>
                    <!-- Hidden technical fields -->
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="company_id"        invisible="1"/>
                    <field name="currency_id"       invisible="1"/>

                    <div class="row">
                        <!-- Left column: numeric input -->
                        <div class="col-sm-5 col-md-4 col-lg-4 col-4">
                            <group>
                                <!-- Percentage input (sol_discount / po_discount) -->
                                <label for="discount_percentage"
                                       string="Discount"
                                       invisible="discount_type not in ('sol_discount', 'po_discount')"/>
                                <field name="discount_percentage"
                                       invisible="discount_type not in ('sol_discount', 'po_discount')"
                                       nolabel="1"
                                       widget="percentage"/>

                                <!-- Amount input (fixed amount mode) -->
                                <label for="discount_amount"
                                       string="Discount"
                                       invisible="discount_type != 'amount'"/>
                                <field name="discount_amount"
                                       invisible="discount_type != 'amount'"
                                       nolabel="1"/>
                            </group>
                        </div>

                        <!-- Right column: discount type radio -->
                        <div class="col-sm-7 col-md-8 col-lg-8 col-8">
                            <field name="discount_type" widget="radio" nolabel="1"/>
                        </div>
                    </div>
                </sheet>

                <footer>
                    <button type="object"
                            name="action_apply_discount"
                            string="Apply"
                            class="btn btn-primary"
                            data-hotkey="q"/>
                    <button special="cancel"
                            string="Discard"
                            class="btn btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
