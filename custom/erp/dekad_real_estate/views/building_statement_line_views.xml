<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_building_statement_line_list" model="ir.ui.view">
        <field name="name">building.statement.line.list</field>
        <field name="model">building.statement.line</field>
        <field name="arch" type="xml">
            <list string="Building Statement" create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="availability" widget="badge"
                       decoration-success="availability == 'available'"
                       decoration-danger="availability == 'not_available'"/>
                <field name="building_id" optional="show"/>
                <field name="property_id" optional="show"/>
                <field name="contract_number" optional="show"/>
                <field name="rent_start_date" optional="hide"/>
                <field name="rent_end_date"/>
                <field name="customer_id"/>
                <field name="sale_order_amount_untaxed"/>
                <field name="payment_type"/>
                <field name="payment_date"/>
                <field name="payment_state"/>
                <field name="memo"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_building_statement_line_search" model="ir.ui.view">
        <field name="name">building.statement.line.search</field>
        <field name="model">building.statement.line</field>
        <field name="arch" type="xml">
            <search string="Building Statement">
                <field name="building_id"/>
                <field name="property_id"/>
                <field name="contract_number"/>
                <field name="customer_id"/>
                <filter string="PDC" name="filter_pdc" domain="[('payment_type', '=', 'pdc')]"/>
                <filter string="Normal Payment" name="filter_payment" domain="[('payment_type', '=', 'payment')]"/>
                <separator/>
                <filter string="Available" name="filter_available" domain="[('availability', '=', 'available')]"/>
                <filter string="Not Available" name="filter_not_available" domain="[('availability', '=', 'not_available')]"/>
                <group expand="0" string="Group By">
                    <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Payment Type" name="group_payment_type" context="{'group_by': 'payment_type'}"/>
                    <filter string="Availability" name="group_availability" context="{'group_by': 'availability'}"/>
                    <filter string="Contract No." name="group_contract_number" context="{'group_by': 'contract_number'}"/>
                    <filter string="Payment State" name="group_payment_state" context="{'group_by': 'payment_state'}"/>

                </group>
            </search>
        </field>
    </record>
    <record id="action_building_statement_line" model="ir.actions.act_window">
        <field name="name">Building Statement</field>
        <field name="res_model">building.statement.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_building_statement_line_search"/>
        <field name="context">
            {
                'search_default_group_building': 1,
                'search_default_group_property': 1,
                'search_default_group_payment_state': 1
            }
        </field>
    </record>


</odoo>