<odoo>
    <!-- Real Estate Buildings Form View -->
    <record id="view_real_estate_form" model="ir.ui.view">
        <field name="name">real.estate.buildings.form</field>
        <field name="model">real.estate.buildings</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet string="Buildings">
                    <div class="oe_title">
                        <h1>
                            <field name="name" style="width: 64rem;" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="number_of_floors" style="width: 4rem;" required="1"/>
                    </group>
                    <group>
                        <group>
                            <span class="fw-bold">Address</span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids"
                                   context="{'default_res_model': 'real.estate.buildings', 'default_res_id': id}"
                                   widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Real Estate Buildings Kanban View -->
    <record id="view_real_estate_kanban" model="ir.ui.view">
        <field name="name">real.estate.buildings.kanban</field>
        <field name="model">real.estate.buildings</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="number_of_floors"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>
                                <span>No. of Floors: </span>
                                <field name="number_of_floors"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Real Estate Buildings Action -->
    <record id="action_real_estate" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">real.estate.buildings</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>