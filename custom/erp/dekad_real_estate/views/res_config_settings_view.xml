<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_real_estate" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.real.estate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="dekad_real_estate" string="Real Estate" groups="dekad_real_estate.group_real_estate_user">
                    <block title="properties Settings">
                        <setting id="enable_rental_properties"
                                 help="Enable features related to property rentals.">
                            <field name="enable_rental_properties"/>
                        </setting>
                        <setting id="enable_sale_properties"
                                 help="Enable features related to property sales.">
                            <field name="enable_sale_properties"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <record id="action_real_estate_config_settings" model="ir.actions.act_window">
        <field name="name">Real Estate Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'dekad_real_estate'}</field>
    </record>
</odoo>
