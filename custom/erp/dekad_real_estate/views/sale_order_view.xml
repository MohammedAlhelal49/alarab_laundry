    <!-- Action for Rental Contracts with context flag -->
    <record id="action_rental_contracts" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_rental_contracts_custom_search"/>
        <field name="target">current</field>
        <field name="domain">[('account_analytic_account_id', '!=', False), ('is_rental_contract', '=', True)]</field>
        <field name="context">{'search_default_group_by_related_buildings_ids': 1, 'rental_mode': True,'default_is_rental_contract': True }</field>
    </record>

