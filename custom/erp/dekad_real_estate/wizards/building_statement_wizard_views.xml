<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_building_statement_wizard_form" model="ir.ui.view">
        <field name="name">building.statement.wizard.form</field>
        <field name="model">building.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Building Statement Filter">
                <group>
                    <group>
                        <field name="building_id"/>
                        <field name="property_ids" widget="many2many_tags" domain="[('is_property', '=', True), ('property_building_id', '=', building_id), ('offer_type', '=', 'rent')]"/>
                        <field name="start_date"
                               widget="daterange"
                               options="{'end_date_field': 'end_date'}"
                               />
                        <field name="end_date" invisible="1"/>
                    </group>
                    <group>
                        <field name="customer_id"/>
                    </group>
                </group>
                <footer>
                    <button string="Search" type="object" name="action_apply_filter"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_building_statement_wizard" model="ir.actions.act_window">
        <field name="name">Building Statement</field>
        <field name="res_model">building.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>