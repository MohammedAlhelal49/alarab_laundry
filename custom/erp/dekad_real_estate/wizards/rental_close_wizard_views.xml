<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rental_close_wizard_view_form" model="ir.ui.view">
        <field name="name">rental.close.wizard.form</field>
        <field name="model">rental.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Contract">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="close_reason_id" placeholder="Why is this contract being closed?"/>
                </group>
                <footer>
                    <button string="Close Contract" type="object" name="action_confirm_close" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="rental_close_wizard_action" model="ir.actions.act_window">
        <field name="name">Close Contract</field>
        <field name="res_model">rental.close.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>