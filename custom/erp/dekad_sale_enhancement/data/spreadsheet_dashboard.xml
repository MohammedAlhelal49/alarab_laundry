<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dekad_sale_enhancement" model="spreadsheet.dashboard">
        <field name="name">Slow Sellers</field>
        <field name="spreadsheet_binary_data" type="base64" file="dekad_sale_enhancement/data/files/product_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('sale.model_sale_order'))]"/>
        <field name="sample_dashboard_file_path">dekad_sale_enhancement/data/files/product_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="sequence">300</field>
        <field name="is_published">True</field>
    </record>

</odoo>
