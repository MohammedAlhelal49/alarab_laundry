<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_us_landscape" model="report.paperformat">
        <field name="name">US Letter Landscape sale</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sale_report" model="ir.actions.report">
        <field name="name">Sale report</field>
        <field name="model">sale.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dekad_sale_enhancement.sale_report</field>
        <field name="report_file">dekad_sale_enhancement.sale_report</field>
        <field name="print_report_name">'Sale Report - %s' % (object.product_id.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="dekad_sale_enhancement.paperformat_us_landscape"/>
    </record>

    <template id="sale_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <h3 class="">Sale report</h3>
                <table class="table table-sm o_main_table table-borderless mt-4">
                    <thead style="display: table-row-group">
                        <tr class="text-center">
                            <th>
                                <strong>Order</strong>
                            </th>
                            <th>
                                <strong>Date Order</strong>
                            </th>
                            <th>
                                <strong>Product</strong>
                            </th>
                            <th>
                                <strong>Unit price</strong>
                            </th>
                            <th>
                                <strong>Quantity To deliver</strong>
                            </th>
                            <th>
                                <strong>Total</strong>
                            </th>
                            <th>
                                <strong>Customer</strong>
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="o">

                            <td class="text-center"
                                t-out="o.order_reference.name">
                            </td>
                            <td class="text-center" t-options="{'widget': 'datetime'}"
                                t-out="o.date">
                            </td>
                            <td class="text-center"
                                t-out="o.product_id.name">
                            </td>


                            <td class="text-center"
                                t-out="o.price_unit"
                                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}">
                            </td>

                            <td class="text-center"
                                t-out="o.qty_to_deliver">
                            </td>

                            <td class="text-center"
                                t-out="o.price_total"
                                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}">
                            </td>

                            <td class="text-center"
                                t-out="o.partner_id.name">
                            </td>
                        </tr>
                    </tbody>
                </table>

            </t>
        </t>

    </template>
</odoo>