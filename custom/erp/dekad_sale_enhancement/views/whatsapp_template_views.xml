<odoo>
    <record id="view_whatsapp_template_form_inherit" model="ir.ui.view">
        <field name="name">whatsapp.template.form.inherit</field>
        <field name="model">whatsapp.template</field>
        <field name="inherit_id" ref="dekad_additional_features.view_whatsapp_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='alert alert-info']/ul" position="inside">
                <li><code>{{quotation_name}}</code>: Quotation name or number</li>
                <li><code>{{quotation_amount}}</code>: Quotation total amount</li>
                <li><code>{{quotation_link}}</code>: The link to the quotation</li>
            </xpath>
        </field>
    </record>
</odoo>
