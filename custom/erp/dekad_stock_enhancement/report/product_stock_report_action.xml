<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_product_stock_report" model="ir.actions.report">
        <field name="name">Product Stock Report</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dekad_stock_enhancement.product_stock_report_template</field>
        <field name="report_file">dekad_stock_report_template</field>
        <field name="print_report_name">'Product Stock - %s' % (object.display_name)</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
