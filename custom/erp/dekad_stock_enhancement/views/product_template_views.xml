<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_readonly_cost" model="ir.ui.view">
        <field name="name">product.template.form.readonly.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Make Cost (standard_price) read-only for ALL users.
                 Cost can only be changed from Physical Inventory. -->
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
