<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_quant_tree_inventory_editable_cost" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.cost</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Add sum aggregate to On Hand Quantity -->
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="sum">Total On Hand</attribute>
            </xpath>

            <!-- Add Cost and Total columns right after Counted Quantity,
                 each with a sum aggregate shown in the footer row -->
            <xpath expr="//field[@name='inventory_quantity']" position="after">
                <field name="company_currency_id" column_invisible="1"/>
                <field name="inventory_cost" optional="show" sum="Total Cost"/>
                <field name="inventory_total" optional="show" readonly="1" sum="Total"/>
            </xpath>

            <!-- Header "Apply All" button -->
            <button name="action_apply_all" position="attributes">
                <attribute name="groups">dekad_stock_enhancement.group_apply_physical_inventory</attribute>
            </button>

            <!-- Row "Apply" button -->
            <button name="action_apply_inventory" position="attributes">
                <attribute name="groups">dekad_stock_enhancement.group_apply_physical_inventory</attribute>
            </button>

            <!-- Header "Apply" button (shown when one or more rows are selected) -->
            <button name="stock.action_stock_inventory_adjustement_name" position="attributes">
                <attribute name="groups">dekad_stock_enhancement.group_apply_physical_inventory</attribute>
            </button>
        </field>
    </record>

</odoo>
