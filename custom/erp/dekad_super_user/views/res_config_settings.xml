<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- customize the general settings -->
    <record id="res_config_settings_view_form_dekad_super_user_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.client.deploy.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- add the users limit functionality-->
            <xpath expr="///div[@id='invite_users']" position="inside">
                <block title="Users limit" name="users_limit">
                    <setting id="users_limit">
                        <field name="users_limit"/>
                        <div class="content-group" invisible="not users_limit">
                            <div class="row mt16">
                                <label for="users_limit_number" class="col-lg-4 o_light_label"/>
                                <field name="users_limit_number"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>
