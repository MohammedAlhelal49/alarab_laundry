<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Footer Contact Buttons
        =====================
        لتغيير الرقم: ابحث عن 971501234567 واستبدله برقمك
        فورمات الرقم: بدون + وبدون مسافات (مثال: 971501234567)
    -->
    <template id="footer_contact_buttons" inherit_id="website.layout" name="Footer Contact Buttons">
        <xpath expr="//body" position="inside">

            <!-- مجموعة الأزرار: ثابتة على اليسار دائماً، اتصال فوق - واتساب تحت -->
            <div class="o_floating_actions_group"
                 style="position:fixed; bottom:30px; left:30px; right:auto; z-index:1000; display:flex; flex-direction:column; gap:14px;">

                <!-- زر اتصال -->
                <a href="tel:+971501234567"
                   class="o_floating_btn o_call_btn"
                   title="اتصل بنا"
                   style="direction:ltr;">
                    <i class="fa fa-phone"></i>
                    <span class="o_btn_tooltip"
                          style="top:50%; transform:translateY(-50%); left:70px; right:auto;">
                        <t t-if="request.env.lang and request.env.lang.startswith('ar')">اتصل بنا</t>
                        <t t-else="">Call Us</t>
                    </span>
                </a>

                <!-- زر واتساب -->
                <a href="https://wa.me/971501234567"
                   class="o_floating_btn o_whatsapp_btn"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="تواصل عبر واتساب"
                   style="direction:ltr;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" style="width:28px; height:28px;">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.17 1.522 5.944L.057 23.886a.5.5 0 0 0 .611.61l6.037-1.459A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.001-1.371l-.36-.214-3.716.898.933-3.619-.235-.372A9.818 9.818 0 1 1 12 21.818z"/>
                    </svg>
                    <span class="o_btn_tooltip"
                          style="top:50%; transform:translateY(-50%); left:70px; right:auto;">
                        <t t-if="request.env.lang and request.env.lang.startswith('ar')">واتساب</t>
                        <t t-else="">WhatsApp</t>
                    </span>
                </a>

            </div>

        </xpath>
    </template>
</odoo>