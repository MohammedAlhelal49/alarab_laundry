<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_invoice_delivery" model="ir.ui.view">

        <field name="name">account.move.form.invoice.delivery</field>

        <field name="model">account.move</field>

        <field name="inherit_id" ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <!-- Delivery smart button -->
            <xpath
                expr="//div[@name='button_box']"
                position="inside"
            >

                <button
                    name="action_view_invoice_deliveries"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="move_type != 'out_invoice' or invoice_delivery_count == 0"
                >

                    <field
                        name="invoice_delivery_count"
                        widget="statinfo"
                        string="Delivery"
                    />

                </button>

            </xpath>


        </field>

    </record>

</odoo>