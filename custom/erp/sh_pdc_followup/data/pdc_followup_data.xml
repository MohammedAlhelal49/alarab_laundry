<?xml version="1.0"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_pdc_followup_1" model="mail.template">
            <field name="name">PDC Payment Reminder</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{ (object.company_id or object._get_pdc_followup_responsible().company_id).name }} PDC Payment Reminder - {{ object.commercial_company_name }}</field>
            <field name="email_from">{{ object._get_pdc_followup_responsible().email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px;">
        Dear <t t-out="object.name or ''"/>,
        <br/><br/>
        It has come to our attention that you have a pending Post-Dated Cheque with an outstanding balance.
        <br/>
        We kindly request that you take the necessary action to settle this amount.
        <br/><br/>
        If you have already made the payment after receiving this message, please disregard it.
        Our accounting department is available if you require any assistance.
        <br/><br/>
        Thank you for your cooperation.
        <br/><br/>
        Best Regards,<br/>
        <t t-out="object._get_pdc_followup_responsible().name"/>
    </p>
</div>
            </field>
            <field name="lang">{{ object.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="demo_pdc_followup_line1" model="pdc.followup.line" forcecreate="False">
            <field name="name">15 Days</field>
            <field name="delay">15</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="send_email">True</field>
            <field name="mail_template_id" ref="email_template_pdc_followup_1"/>
        </record>

    </data>
</odoo>
