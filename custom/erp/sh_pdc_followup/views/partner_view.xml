<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="res_partner_view_form">
            <field name="name">res.partner.view.form.pdc</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority" eval="5"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button groups="account.group_account_invoice"
                            invisible="not pdc_followup_feature_enabled"
                            type="object"
                            class="oe_stat_button"
                            name="action_open_overdue_pdc_cheques"
                            icon="fa-money">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="pdc_total_overdue"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       invisible="pdc_total_overdue == 0 or pdc_total_due == 0"
                                       class="text-danger"/>
                                <field name="pdc_total_due"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       invisible="pdc_total_due == 0 or pdc_total_overdue != 0"/>
                            </span>
                            <span class="o_stat_text">PDC Statement</span>
                        </div>
                    </button>
                </div>
            </field>
        </record>

        <record model="ir.ui.view" id="view_partner_property_form_pdc_followup">
            <field name="name">res.partner.property.form.pdc.followup</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <group name="banks" position="after">
                    <group string="PDC Follow-ups" name="pdc_followups"
                           invisible="not pdc_followup_feature_enabled"
                           groups="account.group_account_invoice">

                        <div colspan="2" invisible="not pdc_followup_line_id">
                            <field name="pdc_followup_line_id"
                                   widget="statusbar"
                                   options="{'clickable': '1'}"/>
                        </div>

                        <label for="pdc_followup_status"/>
                        <div class="o_row">
                            <field name="pdc_followup_status"
                                   widget="badge"
                                   decoration-danger="pdc_followup_status == 'in_need_of_action'"
                                   decoration-warning="pdc_followup_status == 'with_overdue_invoices'"
                                   style="width: 50% !important"
                                   class="fb-mincontent"/>
                            <a name="action_open_overdue_pdc_cheques"
                               invisible="pdc_followup_status not in ('in_need_of_action', 'with_overdue_invoices')"
                               style="width: 50% !important"
                               class="fw-bold"
                               type="object">
                                Overdue Cheques
                            </a>
                        </div>

                        <label for="pdc_followup_reminder_type"/>
                        <div class="o_row">
                            <field name="pdc_followup_reminder_type"
                                   widget="radio"
                                   style="width: 50% !important"
                                   options="{'horizontal': true}"
                                   class="fb-mincontent"/>
                            <a class="fw-bold"
                               name="%(manual_reminder_action)d"
                               style="width: 50% !important"
                               type="action">Send</a>
                        </div>

                        <field name="pdc_followup_next_action_date"/>
                        <field name="pdc_followup_responsible_id"/>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
