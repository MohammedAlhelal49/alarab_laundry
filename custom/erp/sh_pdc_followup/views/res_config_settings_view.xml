<odoo>
    <record id="view_account_config_settings_pdc" model="ir.ui.view">
        <field name="name">res.config.settings.pdc.followup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sh_pdc_payment']" position="inside">

                <setting id="enable_pdc_followup"
                         string="PDC Follow-up"
                         help="Enable PDC Follow-up Levels configuration menu.">

                    <field name="enable_pdc_followup"/>

                </setting>

            </xpath>

        </field>
    </record>
</odoo>
