<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_crm_dekad" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.dekad</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Target the CRM app section directly -->
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="Website Notifications" name="dekad_website_notifications">
                    <setting id="website_lead_activity_users" help="Select the users who will receive a 'To Do' activity when a form is submitted on the website.">
                        <field name="website_lead_activity_user_ids" widget="many2many_tags" placeholder="Select users..."/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>