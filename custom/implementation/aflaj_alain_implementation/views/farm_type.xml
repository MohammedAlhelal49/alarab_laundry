<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_farm_type" model="ir.ui.view">
        <field name="name">view.farm.type</field>
        <field name="model">farm.type</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_form_res_company_farm_type" model="ir.ui.view">
        <field name="name">view.form.res.company.farm.type</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="farm_type_id"/>
            </xpath>
        </field>
    </record>


       <record id="view_company_tree_farm_type" model="ir.ui.view">
        <field name="name">view.company.tree.farm.type</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="farm_type_id"/>
            </xpath>
        </field>
    </record>



    <record id="view_de_company_form_farm_type" model="ir.ui.view">
        <field name="name">view.de.company.form.farm.type</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="dekad_super_user.view_de_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="farm_type_id"/>
            </xpath>
        </field>
    </record>






</odoo>
