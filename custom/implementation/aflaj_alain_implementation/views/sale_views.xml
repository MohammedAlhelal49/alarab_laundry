<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_remove_user_contact" model="ir.ui.view">
        <field name="name">sale.order.form.remove.user.contact</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('related_user_id', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>

