<odoo>
    <record id="view_out_invoice_tree_inherit_phone" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.phone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="partner_contact" optional="show" />
                <field name="partner_address_display" string="Plate Info" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_contact" model="ir.ui.view">
        <field name="name">account.move.search.inherit.contact</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <!-- Search by Contact Phone -->
                <field name="partner_contact" string="Contact Phone"/>
                <field name="partner_address_display" string="Plate Info"/>

                <!-- Group by Contact Phone -->
                <filter string="Plate Info" name="group_by_plate" domain="[]" context="{'group_by': 'partner_address_display'}"/>
                <filter string="Contact Phone" name="group_by_contact" domain="[]" context="{'group_by': 'partner_contact'}"/>
            </xpath>
        </field>
    </record>

    <!-- Custom Window Action for Customer Invoices -->
    <record id="action_pos_invoice_custom" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="domain">[("move_type", "in", ["out_invoice", "out_refund"])]</field>
        <field name="context">
            {
                "search_default_out_invoice": 1,
                "default_move_type": "out_invoice"
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new customer invoice
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pos_invoice_custom"
        name="Invoices"
        parent="point_of_sale.menu_point_of_sale"
        action="action_pos_invoice_custom"
        sequence="2"
    />
</odoo>





