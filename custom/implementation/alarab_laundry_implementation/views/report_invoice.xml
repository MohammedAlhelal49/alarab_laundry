<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_document_inherit_customer_label"
                  inherit_id="account.report_invoice_document">

            <!-- ============================= -->
            <!-- NO SHIPPING -->
            <!-- ============================= -->
            <xpath expr="//div[@name='no_shipping']//address" position="replace">

                <div class="mb-2">
                    <strong>Customer Information:</strong>
                </div>

                <div>
                    <strong>Name:</strong>
                    <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.mobile or o.partner_id.phone">
                    <strong>Contact:</strong>

                    <t t-if="o.partner_id.mobile">
                        <span t-field="o.partner_id.mobile"/>
                    </t>

                    <t t-if="o.partner_id.mobile and o.partner_id.phone">
                        <span> / </span>
                    </t>

                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/>
                    </t>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <strong style="min-width:90px;">Plate info:</strong>

                    <span>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>

                        <t t-if="o.partner_id.zip">
                            , <span t-field="o.partner_id.zip"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            , <span t-field="o.partner_id.country_id.name"/>
                        </t>
                    </span>
                </div>

            </xpath>


            <!-- ============================= -->
            <!-- SHIPPING = INVOICE -->
            <!-- ============================= -->
            <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace">

                <div class="mb-2">
                    <strong>Customer Information:</strong>
                </div>

                <div>
                    <strong>Name:</strong>
                    <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.mobile or o.partner_id.phone">
                    <strong>Contact:</strong>

                    <t t-if="o.partner_id.mobile">
                        <span t-field="o.partner_id.mobile"/>
                    </t>

                    <t t-if="o.partner_id.mobile and o.partner_id.phone">
                        <span> / </span>
                    </t>

                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/>
                    </t>
                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                    <strong style="min-width:90px;">Plate info:</strong>

                    <span>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>

                        <t t-if="o.partner_id.zip">
                            , <span t-field="o.partner_id.zip"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            , <span t-field="o.partner_id.country_id.name"/>
                        </t>
                    </span>
                </div>

            </xpath>


            <!-- ============================= -->
            <!-- SHIPPING DIFFERENT -->
            <!-- ============================= -->
            <xpath expr="//div[@name='address_not_same_as_shipping']//address" position="replace">

                <div class="mb-2">
                    <strong>Customer Information:</strong>
                </div>

                <div>
                    <strong>Name:</strong>
                    <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.mobile or o.partner_id.phone">
                    <strong>Contact:</strong>

                    <t t-if="o.partner_id.mobile">
                        <span t-field="o.partner_id.mobile"/>
                    </t>

                    <t t-if="o.partner_id.mobile and o.partner_id.phone">
                        <span> / </span>
                    </t>

                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/>
                    </t>
                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                    <strong style="min-width:90px;">Plate info:</strong>

                    <span>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>

                        <t t-if="o.partner_id.zip">
                            , <span t-field="o.partner_id.zip"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            , <span t-field="o.partner_id.country_id.name"/>
                        </t>
                    </span>
                </div>

            </xpath>

        </template>

    </data>
</odoo>