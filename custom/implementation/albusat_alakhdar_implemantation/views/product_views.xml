<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show 'Code' on the Product Category form -->
    <record id="view_category_form_albusat" model="ir.ui.view">
        <field name="name">product.category.form.albusat</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="before">
                <field name="code" placeholder="e.g. FER"/>
            </field>
        </field>
    </record>

    <!-- Show the new fields on the Product Template form -->
    <record id="view_product_template_form_albusat" model="ir.ui.view">
        <field name="name">product.template.form.albusat</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div>
                    <label for="code" string="Code"/>
                    <field name="code" placeholder="Product code"/>
                </div>
            </xpath>
            <field name="categ_id" position="after">
                <field name="origin"/>
                <field name="brand"/>
                <field name="minimum_price"/>
                <field name="maximum_price"/>
            </field>
        </field>
    </record>

</odoo>
