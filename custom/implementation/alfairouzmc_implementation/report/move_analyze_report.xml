<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="paperformat_move_analyze_landscape" model="report.paperformat">
        <field name="name">Move Analyze Report - Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>


    <record id="action_report_move_analyze" model="ir.actions.report">
        <field name="name">Move Analyze Report</field>
        <field name="model">stock.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alfairouzmc_implementation.report_move_analyze</field>
        <field name="report_file">alfairouzmc_implementation.report_move_analyze</field>
        <field name="print_report_name">'Move Analyze Report'</field>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_move_analyze_landscape"/>
    </record>

</odoo>