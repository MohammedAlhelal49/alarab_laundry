<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_move_analyze">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">

                    <h2>Move Analyze Report</h2>

                    <t t-foreach="grouped_data" t-as="group">

                        <div style="
                            border:2px solid #bfbfbf;
                            border-radius:6px;
                            margin-bottom:25px;
                            overflow:hidden;
                            page-break-inside:avoid;
                            padding:10px;
                        ">

                            <table class="table table-sm o_main_table" style="margin-bottom:0;">

                                <thead>

                                    <tr style="background-color:#f0f0f0; padding:10px;">
                                        <th colspan="3" style="padding:15px;">
                                            <strong>
                                                <t t-if="group['account']">
                                                    <span t-esc="group['account'].name"/>
                                                </t>
                                                <t t-else="">
                                                    <span>No Analytic Account</span>
                                                </t>
                                            </strong>
                                        </th>
                                    </tr>

                                    <tr>
                                        <th>Date Scheduled</th>
                                        <th>Product</th>
                                        <th>Actual</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <t t-foreach="group['lines']" t-as="o">

                                        <tr>
                                            <td>
                                                <span t-field="o.date"/>
                                            </td>

                                            <td>
                                                <span t-field="o.product_id.display_name"/>
                                            </td>

                                            <td>
                                                <span t-field="o.quantity"/>
                                            </td>
                                        </tr>

                                    </t>

                                    <tr>

                                        <td colspan="3" style="padding:10px;">

                                            <div style="
                                                background:#d9edf7;
                                                border-top:1px solid #bce8f1;
                                                padding:8px 10px;
                                                color:#31708f;
                                                font-weight:bold;
                                            ">

                                                <t t-if="group['account']">
                                                    <span t-esc="group['account'].name"/>
                                                </t>

                                                <t t-else="">
                                                    No Analytic Account
                                                </t>

                                                &#160;-&#160;

                                                Total Actual :
                                                <span t-esc="group['total_quantity']"/>

                                            </div>

                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </t>

                </div>

            </t>
        </t>
    </template>

</odoo>