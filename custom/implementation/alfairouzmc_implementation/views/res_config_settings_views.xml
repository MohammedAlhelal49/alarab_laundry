<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_negative_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.negative.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='stock']" position="inside">

                <h2>Negative Stock</h2>
                <div class="row mt16 o_settings_container" id="negative_stock_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="restrict_negative_delivery"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="restrict_negative_delivery"/>
                            <div class="text-muted">
                                Only selected users will be allowed to validate a Delivery
                                that would bring a product's stock on hand below zero.
                            </div>
                            <div class="content-group" invisible="not restrict_negative_delivery">
                                <field name="negative_delivery_allowed_user_ids"
                                       widget="many2many_tags"
                                       placeholder="Select the users allowed to output negative stock..."/>
                            </div>
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>

</odoo>
