<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_alkahaf" model="report.paperformat">
        <field name="name">AlKahaf A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_alkahaf_delivery_note" model="ir.actions.report">
        <field name="name">Customized delivery slip</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alkahf_implementation.report_alkahaf_delivery_document</field>
        <field name="report_file">alkahf_implementation.report_alkahaf_delivery_document</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="alkahf_implementation.paperformat_alkahaf"/>
    </record>


    <template id="alkahaf_delivery_has_serial_move_line">
        <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px;">
            <span t-field="move_line.product_id"/>
            <t t-if="not description and description != ''">
                <t t-set="description" t-value="move_line.move_id.description_picking"/>
            </t>
            <p t-if="description != '' and
                     description != move_line.product_id.display_name and
                     description != move_line.product_id.name">
                <span t-esc="description"/>
            </p>
        </td>
        <t t-if="has_serial_number" name="move_line_lot">
            <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: center;">
                <span t-field="move_line.lot_id.name"/>
            </td>
        </t>
        <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: right;" name="move_line_lot_quantity">
            <span t-field="move_line.quantity"/>
            <span t-field="move_line.product_uom_id"/>
            <span t-if="move_line.move_id.product_packaging_id" groups="product.group_stock_packaging">
                (<span t-field="move_line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="move_line.move_id.product_packaging_id.display_name"/>)
            </span>
        </td>
    </template>

    <template id="alkahaf_delivery_aggregated_move_lines">
        <tr t-foreach="aggregated_lines" t-as="agg_line"
            t-attf-style="background-color: #{agg_line_index % 2 == 0 and '#f8f9fa' or 'white'};">
            <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px;">
                <span t-esc="aggregated_lines[agg_line]['name']"/>
                <p t-if="aggregated_lines[agg_line]['description']">
                    <span t-esc="aggregated_lines[agg_line]['description']" t-options="{'widget': 'text'}"/>
                </p>
            </td>
            <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: right;" name="move_line_aggregated_qty_ordered">
                <span t-esc="aggregated_lines[agg_line]['qty_ordered']"
                      t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                <span t-esc="aggregated_lines[agg_line]['product_uom'].name"/>
                <span t-if="aggregated_lines[agg_line]['packaging'].name">
                    (<span t-out="aggregated_lines[agg_line]['packaging_qty']" t-options='{"widget": "integer"}'/> <span t-out="aggregated_lines[agg_line]['packaging'].name"/>)
                </span>
            </td>
            <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: right;" name="move_line_aggregated_quantity">
                <t t-if="aggregated_lines[agg_line]['quantity']">
                    <span t-esc="aggregated_lines[agg_line]['quantity']"
                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                    <span t-esc="aggregated_lines[agg_line]['product_uom'].name"/>
                    <span t-if="aggregated_lines[agg_line]['packaging'].name">
                        (<span t-out="aggregated_lines[agg_line]['packaging_quantity']" t-options='{"widget": "integer"}'/> <span t-out="aggregated_lines[agg_line]['packaging'].name"/>)
                    </span>
                </t>
            </td>
        </tr>
    </template>

    <template id="alkahaf_delivery_package_section_line">
        <tr style="background-color: #e9ecef; font-weight: bold;">
            <td colspan="99" style="padding: 8px 6px;">
                <span t-field="package.name"/>
            </td>
        </tr>
    </template>

    <template id="alkahaf_delivery_no_package_section_line">
        <tr style="background-color: #e9ecef; font-weight: bold;">
            <td colspan="99" style="padding: 8px 6px;">
                <span>Products with no package assigned</span>
            </td>
        </tr>
    </template>

    <template id="report_alkahaf_delivery_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang='en_US')"/>
                    <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>

                    <t t-if="o.company_id.company_header">
                        <div class="header">
                            <div class="text-center">
                                <img t-if="o.company_id.company_header"
                                     t-att-src="image_data_uri(o.company_id.company_header)"
                                     style="width: 100%; max-height: 180px; object-fit: contain;"/>
                            </div>
                        </div>
                        <div style="margin-bottom: 40px;"></div>
                    </t>
                    <t t-else="">
                        <div class="header">
                            <div class="row align-items-start">
                                <div class="col-auto">
                                    <img t-if="o.company_id.logo"
                                         t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height: 110px;"/>
                                </div>
                                <div class="col text-start">
                                    <div class="float-end" style="line-height: 1.4;">
                                        <t t-if="o.company_id.company_details">
                                            <span t-field="o.company_id.company_details"/>
                                        </t>
                                        <t t-else="">
                                            <div style="font-weight: bold;"><t t-esc="o.company_id.name"/></div>
                                            <div t-if="o.company_id.street"><t t-esc="o.company_id.street"/></div>
                                            <div>
                                                <t t-if="o.company_id.city"><t t-esc="o.company_id.city"/></t>
                                                <t t-if="o.company_id.country_id">, <t t-esc="o.company_id.country_id.name"/></t>
                                            </div>
                                            <div t-if="o.company_id.phone">Tel: <t t-esc="o.company_id.phone"/></div>
                                            <div t-if="o.company_id.email"><t t-esc="o.company_id.email"/></div>
                                            <div t-if="o.company_id.vat">TRN: <t t-esc="o.company_id.vat"/></div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <div class="page">

                        <!-- TITLE -->
                        <div class="text-center mt-3 mb-5"></div>
                        <h4 class="text-center mb-1">سند تسليم</h4>
                        <h4 class="text-center">Delivery Note</h4>

                        <!-- DELIVERY INFO -->
                        <div class="row my-5" style="font-size: 14px;">
                            <div class="col-12">
                                <div>
                                    <strong>Delivery No:</strong>
                                    <span t-esc="o.name"/>
                                </div>
                                <div class="my-2">
                                    <strong>Shipping Date:</strong>
                                    <span t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                                </div>
                            </div>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;"
                               t-if="o.state != 'done'" name="stock_move_table">
                            <thead>
                                <tr>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: left;">Product</th>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: right;">Ordered</th>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: right;">Delivered</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="lines" t-as="move"
                                    t-attf-style="background-color: #{move_index % 2 == 0 and '#f8f9fa' or 'white'};">
                                    <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px;">
                                        <span t-field="move.product_id"/>
                                        <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                            <span t-field="move.description_picking"/>
                                        </p>
                                    </td>
                                    <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: right;">
                                        <span t-field="move.product_uom_qty"/>
                                        <span t-field="move.product_uom" groups="uom.group_uom"/>
                                    </td>
                                    <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: right;">
                                        <span t-field="move.quantity"/>
                                        <span t-field="move.product_uom" groups="uom.group_uom"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;"
                               t-elif="o.move_line_ids and o.state == 'done'" name="stock_move_line_table">
                            <t t-set="has_serial_number" t-value="False"/>
                            <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"
                               groups="stock.group_lot_on_delivery_slip"/>
                            <thead>
                                <tr>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: left;">Product</th>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: right;"
                                        t-if="not has_serial_number">Ordered</th>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: center;"
                                        t-else="">Lot/Serial Number</th>
                                    <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: right;">Delivered</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- With packages -->
                                <t t-if="o.has_packages" name="has_packages">
                                    <t t-set="packages" t-value="o.move_line_ids.mapped('result_package_id')"/>
                                    <t t-foreach="packages" t-as="package">
                                        <t t-call="alkahf_implementation.alkahaf_delivery_package_section_line"/>
                                        <t t-set="package_move_lines" t-value="o.move_line_ids.filtered(lambda l: l.result_package_id == package)"/>
                                        <t t-if="has_serial_number">
                                            <tr t-foreach="package_move_lines" t-as="move_line"
                                                t-attf-style="background-color: #{move_line_index % 2 == 0 and '#f8f9fa' or 'white'};">
                                                <t t-call="alkahf_implementation.alkahaf_delivery_has_serial_move_line"/>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <t t-set="aggregated_lines" t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                                            <t t-call="alkahf_implementation.alkahaf_delivery_aggregated_move_lines"/>
                                        </t>
                                    </t>
                                    <t t-set="move_lines" t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                                    <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                                    <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                                        <t t-call="alkahf_implementation.alkahaf_delivery_no_package_section_line"/>
                                        <t t-if="has_serial_number">
                                            <tr t-foreach="move_lines" t-as="move_line"
                                                t-attf-style="background-color: #{move_line_index % 2 == 0 and '#f8f9fa' or 'white'};">
                                                <t t-call="alkahf_implementation.alkahaf_delivery_has_serial_move_line"/>
                                            </tr>
                                        </t>
                                        <t t-elif="aggregated_lines">
                                            <t t-call="alkahf_implementation.alkahaf_delivery_aggregated_move_lines"/>
                                        </t>
                                    </t>
                                </t>
                                <!-- No packages -->
                                <t t-else="">
                                    <t t-if="has_serial_number">
                                        <tr t-foreach="o.move_line_ids" t-as="move_line"
                                            t-attf-style="background-color: #{move_line_index % 2 == 0 and '#f8f9fa' or 'white'};">
                                            <t t-call="alkahf_implementation.alkahaf_delivery_has_serial_move_line"/>
                                        </tr>
                                    </t>
                                    <t t-else="" name="aggregated_move_lines">
                                        <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities()"/>
                                        <t t-call="alkahf_implementation.alkahaf_delivery_aggregated_move_lines"/>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                        <div t-if="o.backorder_ids and backorders">
                            <p class="mt-5">Remaining quantities not yet delivered:</p>
                            <table style="width: 100%; border-collapse: collapse;" name="stock_backorder_table">
                                <thead>
                                    <tr>
                                        <th style="border-bottom: 1px solid #000; padding: 8px 6px;"><strong>Product</strong></th>
                                        <th/>
                                        <th style="border-bottom: 1px solid #000; padding: 8px 6px; text-align: center;"><strong>Quantity</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="backorders.mapped('move_ids').filtered(lambda x: x.product_uom_qty)"
                                        t-as="bo_line">
                                        <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px;">
                                            <span t-field="bo_line.product_id"/>
                                            <p t-if="bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                                <span t-field="bo_line.description_picking"/>
                                            </p>
                                        </td>
                                        <td/>
                                        <td style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: center;">
                                            <span t-field="bo_line.product_uom_qty"/>
                                            <span t-field="bo_line.product_uom" groups="uom.group_uom"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="not o.signature" class="oe_structure"></div>
                        <div t-else="" class="mt32 ml64 mr4" name="signature">
                            <div class="offset-8"><strong>Signature</strong></div>
                            <div class="offset-8">
                                <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                            </div>
                            <div t-if="o.partner_id.name" class="offset-8 text-center">
                                <p t-field="o.partner_id.name"/>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-4">
                        <div class="col-8"></div>
                        <div class="col-4">
                            <table style="width:100%; border-collapse:collapse;">
                                <thead>
                                    <tr>
                                        <th style="border-bottom:1px solid #000; padding:8px 6px; text-align:center;">Ordered Total</th>
                                        <th style="border-left:1px solid #dee2e6; border-bottom:1px solid #000; padding:8px 6px; text-align:center;">Delivered Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border-bottom:1px solid #dee2e6; padding:8px 6px; text-align:center;">
                                            <t t-esc="o.product_uom_qty_sum"/>
                                        </td>
                                        <td style="border-left:1px solid #dee2e6; border-bottom:1px solid #dee2e6; padding:8px 6px; text-align:center;">
                                            <t t-esc="o.quantity_sum"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="avoid-page-break-inside">
                        <div class="mt-5"> - The goods were received in good condition and free from defects.</div>
                        <div class="mt-1"> - تم استلام البضاعة بحالة سليمة وخالية من العيوب</div>
                        <div class="my-2 pt-3">
                            <strong>The Recipient :</strong>
                            <span t-esc="o.partner_id.name"/>
                        </div>
                        <div class="my-2">
                            <strong>The Signature :</strong>
                        </div>
                        <div class="my-2">
                            <strong>Mobile number: </strong>
                        </div>
                    </div>

                    <!-- FOOTER -->
                    <div class="footer">
                        <div class="o_footer_content border-top pt-2">
                            <div class="row" style="padding-left: 60px; padding-right: 60px;">
                                <div class="col-6" style="text-align: left;">
                                    Mob.: <span t-esc="o.company_id.partner_id.mobile or o.company_id.partner_id.phone"/>
                                </div>
                                <div class="col-6" style="text-align: right;">
                                    P.O. Box: <span t-esc="o.company_id.po_box"/>
                                </div>
                            </div>
                            <div t-if="report_type == 'pdf'" class="text-center text-muted">
                                Page <span class="page"/> / <span class="topage"/>
                            </div>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>