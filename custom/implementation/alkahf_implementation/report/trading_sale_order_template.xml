<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_custom_quotation" model="report.paperformat">
        <field name="name">Custom Quotation A4</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line">False</field>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sale_quotation_custom" model="ir.actions.report">
        <field name="name">Customized sale order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alkahf_implementation.report_sale_quotation_custom_document</field>
        <field name="report_file">alkahf_implementation.report_sale_quotation_custom_document</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="alkahf_implementation.paperformat_custom_quotation"/>
    </record>


    <template id="report_sale_quotation_custom_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <div class="footer">
                    <div class="o_footer_content border-top pt-2">
                        <div class="row" style="padding-left: 60px; padding-right: 60px;">
                            <div class="col-6" style="text-align: left;">
                                Mob.: <span t-esc="o.company_id.partner_id.mobile or o.company_id.partner_id.phone"/>
                            </div>
                            <div class="col-6" style="text-align: right;">
                                P.O. Box: <span t-esc="o.company_id.po_box"/>
                            </div>
                        </div>
                        <div t-if="report_type == 'pdf'" class="text-center text-muted">
                            Page <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>
                </div>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 14px; color: #222; padding: 30px 40px;">
                    <style>
                        .o_total_table tr:nth-child(odd) {
                            background-color: #f2f2f2;
                        }
                        .o_total_table tr:nth-child(even) {
                            background-color: #ffffff;
                        }
                    </style>

                    <t t-if="doc.company_id.company_header">
                        <div class="header">
                            <div class="text-center">
                                <img t-if="doc.company_id.company_header"
                                     t-att-src="image_data_uri(doc.company_id.company_header)"
                                     style="width:100% ; max-height: 180px; object-fit: contain;"/>
                            </div>
                        </div>
                        <div style="margin-bottom: 10px;"/>
                    </t>

                    <t t-else="">
                        <div class="header" style="margin-bottom: 10px;">
                            <div class="row align-items-start">
                                <div class="col-auto">
                                    <img t-if="doc.company_id.logo"
                                         t-att-src="image_data_uri(doc.company_id.logo)"
                                         style="max-height: 110px;"/>
                                </div>
                                <div class="col text-start">
                                    <div class="float-end" style="line-height: 1.4;">
                                        <t t-if="doc.company_id.company_details">
                                            <span t-field="doc.company_id.company_details"/>
                                        </t>
                                        <t t-else="">
                                            <div style="font-weight: bold;">
                                                <t t-esc="doc.company_id.name"/>
                                            </div>
                                            <div t-if="doc.company_id.street">
                                                <t t-esc="doc.company_id.street"/>
                                            </div>
                                            <div>
                                                <t t-if="doc.company_id.city"><t t-esc="doc.company_id.city"/></t>
                                                <t t-if="doc.company_id.country_id">, <t t-esc="doc.company_id.country_id.name"/></t>
                                            </div>
                                            <div t-if="doc.company_id.phone">Tel: <t t-esc="doc.company_id.phone"/></div>
                                            <div t-if="doc.company_id.email"><t t-esc="doc.company_id.email"/></div>
                                            <div t-if="doc.company_id.vat">TRN: <t t-esc="doc.company_id.vat"/></div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <!-- TITLE -->
                    <div style="text-align: center; margin-bottom: 10px;">
                        <div style="font-size: 22px; font-weight: normal; direction: rtl;">عرض سعر</div>
                        <div style="font-size: 22px; font-weight: normal; margin-top: 5px;">Quotation</div>
                    </div>
                    <br/>
                    <!-- HEADER INFO -->
                    <table style="width: 100%; margin-bottom: 30px; font-size: 14px; border-collapse: collapse;">
                        <tr>
                            <td style="width: 50%; vertical-align: top; padding: 0;">
                                <div style="margin-bottom: 6px;">
                                    <strong>Customer :</strong>
                                    <span t-esc="doc.partner_id.name"/>
                                </div>

                                        <div t-if="doc.partner_id.phone" class="mt-2">
                                <strong>Customer Phone :</strong>
                                <span t-esc="doc.partner_id.phone"/>
                            </div>

                                  <div t-if="doc.partner_id.mobile" class="mt-2">
                                <strong>Customer Mobile :</strong>
                                <span t-esc="doc.partner_id.mobile"/>
                            </div>


                                <t t-if="doc.partner_id.vat">
                                    <div class="mt-2">
                                        <strong>Customer TRN :</strong>
                                        <span t-esc="doc.partner_id.vat"/>
                                    </div>
                                </t>
                            </td>
                            <td style="width: 50%; vertical-align: top; padding: 0;">
                                <div style="margin-bottom: 6px;">
                                    <strong>Quotation No :</strong>
                                    <span t-esc="doc.name"/>
                                </div>
                                <div style="margin-bottom: 6px;">
                                    <strong>Quotation Date :</strong>
                                    <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                                </div>
                                <div>
                                    <strong>Salesperson :</strong>
                                    <span t-esc="doc.user_id.name"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                    <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
                    <t t-set="has_images" t-value="any(l.product_image for l in doc.order_line)"/>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 15px;">
                        <thead>
                            <tr>
                                <t t-if="has_images">
                                    <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: left;">Image</th>
                                </t>
                                <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: left;">Description</th>
                                <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: left;">Quantity</th>
                                <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: left;">Unit Price</th>
                                <t t-if="display_discount">
                                    <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: left;">Disc.%</th>
                                </t>
                                <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: center;">Taxes</th>
                                <th style="border-bottom: 1px solid #dee2e6; padding: 8px 6px; text-align: right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="current_section" t-value="None"/>

                            <t t-foreach="lines_to_report.filtered(lambda l: l.product_id and not l.product_id.is_discount)"
                               t-as="line">

                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                                <t t-if="line.display_type == 'line_section' or line.product_type == 'combo'">
                                    <tr t-attf-style="border-bottom: 2px solid #eef0f2; background-color: #{line_index % 2 == 0 and '#f2f2f2' or 'white'};">
                                        <td colspan="99" style="padding: 8px 6px; font-weight: bold; text-align: left;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>

                                <t t-elif="line.display_type == 'line_note'">
                                    <tr t-attf-style="border-bottom: 2px solid #eef0f2; background-color: #{line_index % 2 == 0 and '#f2f2f2' or 'white'};">
                                        <td colspan="99" style="padding: 8px 6px; font-style: italic; color: #666; text-align: left;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>

                                <t t-else="">
                                    <tr t-attf-style="border-bottom: 2px solid #eef0f2; background-color: #{line_index % 2 == 0 and '#f2f2f2' or 'white'};">
                                        <t t-if="has_images">
                                            <td style="padding: 6px; vertical-align: middle;">
                                                <img t-if="line.product_image"
                                                     t-att-src="image_data_uri(line.product_image)"
                                                     style="max-width: 40px; max-height: 40px; display: block;"/>
                                            </td>
                                        </t>
                                        <td style="padding: 8px 6px; vertical-align: middle; text-align: left;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding: 8px 6px; vertical-align: middle; text-align: left;">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom" groups="uom.group_uom"/>
                                            <t t-if="line.product_packaging_id">
                                                (<span t-field="line.product_packaging_qty"
                                                       t-options='{"widget": "integer"}'/>
                                                <span t-field="line.product_packaging_id"/>)
                                            </t>
                                        </td>
                                        <td style="padding: 8px 6px; vertical-align: middle; text-align: left;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <t t-if="display_discount">
                                            <td style="padding: 8px 6px; vertical-align: middle; text-align: left;">
                                                <span t-field="line.discount"/>
                                            </td>
                                        </t>
                                        <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                        <td style="padding: 8px 6px; vertical-align: middle; text-align: center;">
                                            <span t-out="taxes"/>
                                        </td>
                                        <td t-if="not line.is_downpayment"
                                            style="padding: 8px 6px; vertical-align: middle; text-align: right;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>

                            </t>
                        </tbody>
                    </table>

                    <div class="clearfix" name="so_total_summary">
                        <div id="total" class="row mt-n3" name="total">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">

                                <!-- Discount line (white background, shown above tax totals) -->
                                <table class="mt-5 mb-0 table avoid-page-break-inside table-borderless">
                                    <tr t-if="doc.has_discount_line">
                                        <td style="border-bottom: 1px solid #eef0f2; background : white !important;">
                                            <strong>
                                                <t t-out="doc.discount_line_name"/>
                                                <t t-if="doc.discount_line_percent">
                                                    (<t t-out="doc.discount_line_percent"/>%)
                                                </t>
                                            </strong>
                                        </td>
                                        <td class="text-end" style="border-bottom: 1px solid #eef0f2; background : white !important; padding: 8px 12px !important;">
                                            <span t-out="doc.discount_line_amount"/> AED
                                        </td>
                                    </tr>
                                </table>

                                <!-- Standard Odoo tax totals widget -->
                                <table class="o_total_table table table-borderless">
                                    <t t-call="sale.document_tax_totals">
                                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                        <t t-set="currency" t-value="doc.currency_id"/>
                                    </t>
                                </table>

                            </div>
                        </div>
                    </div>
                    <t t-if="doc.signature">
                        <div style="margin-top: 30px; float: right; text-align: center; width: 35%;">
                            <strong>Signature</strong><br/>
                            <img t-att-src="image_data_uri(doc.signature)"
                                 style="max-height: 4cm; max-width: 8cm; margin-top: 6px;"/>
                            <div style="margin-top: 4px;">
                                <span t-field="doc.signed_by"/>
                            </div>
                        </div>
                        <div style="clear: both;"></div>
                    </t>

                    <div style="margin-top: 10px; font-size: 13px;">
                        <span t-field="doc.note"
                              t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}"/>
                        <p t-if="not is_html_empty(doc.payment_term_id.note)">
                            <span t-field="doc.payment_term_id.note"/>
                        </p>
                        <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)">
                            <strong>Fiscal Position Remark:</strong>
                            <span t-field="doc.fiscal_position_id.sudo().note"/>
                        </p>
                    </div>
                    <br/>
                    <div class = "avoid-page-break-inside" style="font-size: 16px;">
                        <div style="margin-bottom: 8px;">
                            - The listed prices are valid Until the date :
                            <t t-esc="doc.validity_date" t-options='{"widget": "date"}'/>
                            . And the vendor is not responsible for price changes after this date.
                        </div>
                        <div style="direction: ltl; text-align: left;">
                            - الاسعار المعروضة صالحة حتى تاريخ :
                            <t t-esc="doc.validity_date" t-options='{"widget": "date"}'/>
                            . والمورد غير مسؤول عن تغير السعر بعد هذا التاريخ.
                        </div>
                    </div>

                </div>
                <t t-if="not doc_last">
                    <div style="page-break-after: always;"/>
                </t>
            </t>

        </t>
    </template>

</odoo>