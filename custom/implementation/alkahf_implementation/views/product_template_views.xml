<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_is_discount" model="ir.ui.view">
        <field name="name">product.template.form.is_discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_discount" groups = "dekad_super_user.group_de_support"/>
            </xpath>
        </field>
    </record>

</odoo>