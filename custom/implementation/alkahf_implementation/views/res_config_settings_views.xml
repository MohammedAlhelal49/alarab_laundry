<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_sale_cost_validation"
                model="ir.ui.view">

            <field name="name">
                res.config.settings.sale.cost.validation
            </field>

            <field name="model">res.config.settings</field>

            <field name="inherit_id"
                   ref="sale.res_config_settings_view_form"/>

            <field name="arch" type="xml">

                <xpath expr="//block[@id='pricing_setting_container']"
                       position="after">

                    <block id="sale_cost_validation_block"
                           title="Sale Cost Validation">

                        <setting string="Enable Sale Cost Validation"
                                 help="Prevent salespersons from confirming quotations below cost.">

                            <field name="enable_sale_cost_validation"/>

                        </setting>

                    </block>

                </xpath>

            </field>

        </record>

    </data>
</odoo>
