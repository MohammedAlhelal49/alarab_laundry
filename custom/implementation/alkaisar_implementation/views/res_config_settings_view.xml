<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_default_customer" model="ir.ui.view">
        <field name="name">res.config.settings.default.customer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='sale_management']/block[@name='quotation_order_setting_container']"
                   position="after">
                <block title="Default Sale Customer" name="sale_customer_id_container">
                    <setting
                            id="sale_customer_id_setting"
                            name="sale_customer_id"
                            type="config"
                            help="This customer will be selected by default when creating new quotations.">

                        <field name="sale_customer_id"/>

                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>
