<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_journal" model="ir.ui.view">
        <field name="name">res.users.form.inherit.journal</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//group[@name='messaging']" position="after">
                <group string="Accounting">
                    <field name="default_payment_journal_id"
                           options="{'no_create': True, 'no_create_edit': True}" domain = "[('type' , 'in' , ('cash' , 'bank'))]"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>