<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_sale_customer_price_history_list" model="ir.ui.view">
        <field name="name">sale.customer.price.history.list</field>
        <field name="model">sale.customer.price.history</field>
        <field name="arch" type="xml">
            <list create = "0">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="price_unit"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_sale_customer_price_history" model="ir.actions.act_window">
        <field name="name">Customer Price History</field>
        <field name="res_model">sale.customer.price.history</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sale_customer_price_history_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Customer-specific selling price history will appear here.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
            id="menu_sale_customer_price_history"
            name="Customer Price History"
            parent="sale.menu_sale_report"
            action="action_sale_customer_price_history"
            sequence="60"
    />

</odoo>
