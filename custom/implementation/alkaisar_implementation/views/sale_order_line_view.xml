<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_unit_cost_list_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.unit.cost.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- list view inside the order_line field -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="unit_cost" optional="show" groups="base.group_user" readonly = "1"/>
                <field name="use_price_from_history" invisible = "1"/>
            </xpath>
        </field>
    </record>


    <template id="web.external_layout_striped">
        <div t-attf-class="o_company_#{company.id}_layout header">

            <div t-if="company.id in (1,3)">
                <img src="/alkaisar_implementation/static/src/img/alkaisar_header.png" style="width:100% !important"
                     t-if="company.id == 1"/>

                <img src="/alkaisar_implementation/static/src/img/paradise_header.png" style="width:100% !important"
                     t-if="company.id == 3"/>
            </div>


            <div class="d-flex" t-if="company.id == 2">
                <div>
                    <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)"
                         alt="Logo"/>
                    <div t-if="company.report_header" t-field="company.report_header"
                         class="o_company_tagline fw-bold mt-2">Company tagline
                    </div>
                </div>
                <div class="ms-3" name="company_address">
                    <ul class="list-unstyled" name="company_address_list">
                        <li t-if="company.is_company_details_empty">
                            <span t-field="company.partner_id"
                                  t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company address block</strong>
                                    <div>Contains the company address.</div>
                                </div>
                            </span>
                        </li>
                        <li t-else="">
                            <span t-field="company.company_details">
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company details block</strong>
                                    <div>Contains the company details.</div>
                                </div>
                            </span>
                        </li>
                        <li t-if="not forced_vat"/>
                        <li t-else="">
                            <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                            <span t-esc="forced_vat">US12345671</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <t t-set="layout_background_url"
           t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else
                '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''"/>
        <div t-attf-class="o_company_#{company.id}_layout article o_report_layout_striped o_table_striped o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">


            <t t-call="web.address_layout"/>
            <h2 t-out="layout_document_title"/>


            <t t-out="0"/>


        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <div t-if="company.id == 1">
                <div class="py-5"/>
                <img src="/alkaisar_implementation/static/src/img/alkaisar_footer.png" style="width:100% !important"
                />
            </div>

            <div class="o_footer_content border-top pt-2 text-center" t-else="">
                <div t-field="company.report_footer"/>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted" t-out="o.name">(document
                    name)
                </div>
                <div t-if="report_type == 'pdf'" class="text-muted">Page
                    <span class="page"/>
                    /
                    <span class="topage"/>
                </div>
            </div>
        </div>
    </template>
</odoo>
