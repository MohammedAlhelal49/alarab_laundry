<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transfer_company_wizard_form" model="ir.ui.view">
        <field name="name">transfer.company.wizard.form</field>
        <field name="model">transfer.company.wizard</field>
        <field name="arch" type="xml">

            <form string="Transfer Leads &amp; Contacts">

                <group>

                    <field name="user_id"/>

                    <field name="target_company_id"
                           options="{'no_create': True}"/>

                </group>

                <group string="Transfer Summary">

                    <div class="alert alert-warning" role="alert">

                        <strong>
                            You are about to transfer:
                        </strong>

                        <br/>

                        <div style="display:flex; align-items:center; gap:8px;">
                            <span>•</span>
                            <span>
                                <field name="contact_count" readonly="1" nolabel="1" class="oe_inline"/>
                            </span>
                            <span>contacts</span>
                        </div>

                        <div style="display:flex; align-items:center; gap:8px; margin-top:8px;">
                            <span>•</span>
                            <span>
                                <field name="lead_count" readonly="1" nolabel="1" class="oe_inline"/>
                            </span>
                            <span>leads/opportunities</span>
                        </div>

                        <br/>

                        to company:
                        <strong>
                            <field name="target_company_id" readonly="1"/>
                        </strong>

                    </div>

                </group>

                <footer>

                    <button
                        name="action_transfer"
                        type="object"
                        string="Transfer"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>