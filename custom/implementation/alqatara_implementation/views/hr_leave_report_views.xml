<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_employee_type_report_view_list" model="ir.ui.view">
        <field name="name">hr.leave.employee.type.report.view.list</field>
        <field name="model">hr.leave.employee.type.report</field>
        <field name="arch" type="xml">
            <list string="Time Off Summary" sample="1" create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="leave_type"/>
                <field name="holiday_status"/>
                <field name="state"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days" sum="Total Days"/>
                <field name="number_of_hours" sum="Total Hours"/>
            </list>
        </field>
    </record>
</odoo>