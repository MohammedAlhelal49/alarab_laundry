<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_purchase_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.default.vendor</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="default_vendor_setting"
                         string="Default Vendor"
                         help="Temporary vendor assigned to new RFQs when no supplier is chosen.">
                    <div class="content-group">
                        <div class="mt16">
                            <field name="vendor_id" class="w-75"/>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>

</odoo>