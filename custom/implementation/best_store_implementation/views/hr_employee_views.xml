<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_pin_password" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.pin.password</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pin']" position="attributes">
                <attribute name="password">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
