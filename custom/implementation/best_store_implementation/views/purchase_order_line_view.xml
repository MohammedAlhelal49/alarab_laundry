<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_line_image_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.image</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="before">
                <field name="product_image" widget="image" optional="hide" class="o_image_small" options="{'preview_image': 'product_image'}" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <field name="barcode" string="Barcode" readonly="1" optional="show"/>
                <field name="link" string="Link" optional="hide"/>

            </xpath>

        </field>
    </record>
</odoo>

