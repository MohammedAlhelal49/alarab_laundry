<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_unit_cost_list_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.unit.cost.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="product_image"
                       widget="image"
                       optional="hide"
                       options="{'preview_image': 'product_image'}"
                       style="max-width: 20px; max-height: 20px;"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="barcode" string="Barcode" readonly="1" optional="show"/>
                <field name="link" string="Link" optional="hide"/>

            </xpath>

        </field>
    </record>
     <function model="sale.order.line" name="handle_old_order_line_images" eval="[[]]"/>
</odoo>




