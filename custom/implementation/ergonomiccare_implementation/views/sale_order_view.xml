<odoo>
    <record id="view_order_form_inherit_extra_fields" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.extra.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">


            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="product_ids" widget="many2many_tags"/>
                <field name="product_description"/>
                <field name="claim_number" />
                <field name="lpo_authorization_type"/>
                      <!-- LPO Field -->
                <field name="lpo_number"
                       invisible="lpo_authorization_type != 'lpo'"
                       required="lpo_authorization_type == 'lpo'"/>

                <!-- Authorization Field -->
                <field name="authorization_number"
                       invisible="lpo_authorization_type != 'authorization'"
                        required="lpo_authorization_type == 'authorization'"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="patient_id"/>
                <field name="mrn"/>
                <field name="patient_code"/>
                <field name="theqa_no"/>
                <field name="manufacturer"/>
                <label for="warranty_value" string="Warranty"/>
                <div>
                    <field name="warranty_value" style="width: 4rem;"/>
                    <field name="warranty_unit" class="oe_inline"/>
                </div>


                <!-- Delivery Duration -->
                <label for="delivery_duration_from" string="Delivery Duration"/>
                <div>
                    <field name="delivery_duration_from" style="width: 4rem;"/>
                    <span style="margin: 0 0.5rem;">to</span>
                    <field name="delivery_duration_to" style="width: 4rem;"/>
                    <field name="delivery_duration_unit" class="oe_inline"/>
                </div>

            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_onboarding_inherit_patient" model="ir.ui.view">
        <field name="name">sale.order.tree.onboarding.inherit.patient</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="patient_id" optional="show" string="Patient Name"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_list_patient_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.patient</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="patient_id" optional="show" string="Patient Name"/>
            </xpath>
        </field>
    </record>

</odoo>