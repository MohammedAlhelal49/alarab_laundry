<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_order_lines_main">
        <t t-call="web.html_container">
            <t t-foreach="docs.order_line" t-as="line">
                <t t-call="web.external_layout">

                    <div class="page"
                         style="page-break-after: always; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2d3748; font-size: 10pt; line-height: 1.5; padding-top: 5px;">

                        <div style="margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">
                            <h4 style="font-weight: bold; color: #2b6cb0; margin: 0; text-transform: uppercase; font-size: 13pt;">
                                Line Specification Sheet
                            </h4>
                        </div>

                        <table style="width: 100%; border: 1px solid #e2e8f0; background-color: #f7fafc; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="padding: 10px; border: 1px solid #e2e8f0; width: 50%;">
                                    <div style="font-size: 8pt; font-weight: bold; color: #718096; text-transform: uppercase;">
                                        Product / Description
                                    </div>
                                    <div style="font-size: 10.5pt; font-weight: 500;">
                                        <span t-field="line.product_id.name"/>
                                    </div>
                                    <div style="font-size: 9pt; color: #4a5568; margin-top: 3px;" t-field="line.name"/>
                                </td>
                                <td style="padding: 10px; border: 1px solid #e2e8f0; width: 50%; vertical-align: top;">
                                    <div style="font-size: 8pt; font-weight: bold; color: #718096; text-transform: uppercase;">
                                        Logistics Metadata
                                    </div>
                                    <div>
                                        <strong>Service Type:</strong>
                                        <span t-field="line.service_type"/>
                                    </div>
                                    <t t-if="line.service_type == 'ticket'">
                                        <div>
                                            <strong>Ticket Type:</strong>
                                            <span t-field="line.ticket_type"/>
                                        </div>
                                    </t>
                                    <div>
                                        <strong>Pricing Context:</strong>
                                        <span t-field="line.product_uom_qty"/>
                                        Unit(s) x
                                        <span t-field="line.price_unit"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <t t-if="line.service_type == 'ticket'">

                            <t t-if="line.ticket_type in ['departure', 'round_trip']">
                                <div style="font-size: 11pt; font-weight: bold; color: #2b6cb0; background-color: #ebf8ff; padding: 5px 8px; margin-top: 15px; border-left: 4px solid #3182ce;">
                                    Ticket Information (Outbound)
                                </div>
                                <table style="width: 100%; margin-top: 8px; border-collapse: collapse; border: 1px solid #e2e8f0;">
                                    <thead>
                                        <tr style="background-color: #f7fafc; font-size: 8.5pt; text-transform: uppercase;">
                                            <th style="padding: 6px; border: 1px solid #e2e8f0;">Flight Logistics</th>
                                            <th style="padding: 6px; border: 1px solid #e2e8f0;">Schedule</th>
                                            <th style="padding: 6px; border: 1px solid #e2e8f0;">PNR / BNR</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="font-size: 9.5pt;">
                                            <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                                Airline:
                                                <span t-field="line.ticket_x_number"/>
                                                <br/>
                                                Plane No:
                                                <span t-field="line.ticket_x_plane_number"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                                Leave:
                                                <span t-field="line.ticket_x_leave_date"/>
                                                <br/>
                                                Arrive:
                                                <span t-field="line.ticket_x_arrive_date"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #e2e8f0; font-weight: bold; color: #2b6cb0;">
                                                <span t-field="line.ticket_x_bnr"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div style="font-size: 8.5pt; font-weight: bold; color: #4a5568; margin-top: 10px; margin-bottom: 4px;">
                                    Ticket Bag Allocation Ledger:
                                </div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                    <thead>
                                        <tr style="background-color: #edf2f7; text-align: left;">
                                            <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Bag Type
                                            </th>
                                            <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Allowed
                                                Weight
                                            </th>
                                            <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Special
                                                Instructions / Notes
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="line.ticket_x_bag_weight_ids" t-as="bag_x">
                                            <tr>
                                                <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7;">
                                                    <span t-field="bag_x.bag_type_id.name"/>
                                                </td>
                                                <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7;">
                                                    <span t-field="bag_x.weight"/>
                                                </td>
                                                <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7; color: #718096;">
                                                    <span t-field="bag_x.note"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <t t-if="line.ticket_type in ['return', 'round_trip']">
                                <div style="font-size: 11pt; font-weight: bold; color: #2b6cb0; background-color: #ebf8ff; padding: 5px 8px; margin-top: 25px; border-left: 4px solid #3182ce;">
                                    Ticket Information (Return Journey)
                                </div>
                                <table style="width: 100%; margin-top: 8px; border-collapse: collapse; border: 1px solid #e2e8f0;">
                                    <thead>
                                        <tr style="background-color: #f7fafc; font-size: 8.5pt; text-transform: uppercase;">
                                            <th style="padding: 6px; border: 1px solid #e2e8f0;">Flight Logistics</th>
                                            <th style="padding: 6px; border: 1px solid #e2e8f0;">Schedule</th>
                                            <th style="padding: 6px; border: 1px solid #e2e8f0;">PNR / BNR</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="font-size: 9.5pt;">
                                            <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                                Airline:
                                                <span t-field="line.ticket_y_number"/>
                                                <br/>
                                                Plane No:
                                                <span t-field="line.ticket_y_plane_number"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                                Leave:
                                                <span t-field="line.ticket_y_leave_date"/>
                                                <br/>
                                                Arrive:
                                                <span t-field="line.ticket_y_arrive_date"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #e2e8f0; font-weight: bold; color: #2b6cb0;">
                                                <span t-field="line.ticket_x_bnr"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div style="font-size: 8.5pt; font-weight: bold; color: #4a5568; margin-top: 10px; margin-bottom: 4px;">
                                    Ticket Bag Allocation Ledger:
                                </div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                    <thead>
                                        <tr style="background-color: #edf2f7; text-align: left;">
                                            <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Bag Type
                                            </th>
                                            <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Allowed
                                                Weight
                                            </th>
                                            <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Special
                                                Instructions / Notes
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="line.ticket_y_bag_weight_ids" t-as="bag_y">
                                            <tr>
                                                <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7;">
                                                    <span t-field="bag_y.bag_type_id.name"/>
                                                </td>
                                                <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7;">
                                                    <span t-field="bag_y.weight"/>
                                                </td>
                                                <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7; color: #718096;">
                                                    <span t-field="bag_y.note"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <t t-elif="line.service_type == 'hotel'">

                            <div style="font-size: 11pt; font-weight: bold; color: #c05621; background-color: #feebc8; padding: 5px 8px; margin-top: 15px; border-left: 4px solid #dd6b20;">
                                Accommodation Information
                            </div>
                            <table style="width: 100%; margin-top: 8px; border-collapse: collapse; border: 1px solid #e2e8f0;">
                                <thead>
                                    <tr style="background-color: #f7fafc; font-size: 8.5pt; text-transform: uppercase;">
                                        <th style="padding: 6px; border: 1px solid #e2e8f0; width: 33%;">Property
                                            Context
                                        </th>
                                        <th style="padding: 6px; border: 1px solid #e2e8f0; width: 33%;">Address
                                            Logistics
                                        </th>
                                        <th style="padding: 6px; border: 1px solid #e2e8f0; width: 33%;">Scheduling</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="font-size: 9.5pt;">
                                        <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                            <strong>Hotel:</strong>
                                            <span t-field="line.hotel_name"/>
                                            <br/>
                                            <strong>Contact No:</strong>
                                            <span t-field="line.hotel_number"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                            <span t-field="line.hotel_street"/>
                                            <br/>
                                            <span t-field="line.hotel_country_id.name"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #e2e8f0;">
                                            <strong>Check-In:</strong>
                                            <span t-field="line.hotel_check_in_date"/>
                                            <br/>
                                            <strong>Check-Out:</strong>
                                            <span t-field="line.hotel_check_out_date"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div style="font-size: 8.5pt; font-weight: bold; color: #4a5568; margin-top: 15px; margin-bottom: 4px;">
                                Room Allocation &amp; Details Ledger:
                            </div>
                            <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                <thead>
                                    <tr style="background-color: #edf2f7; text-align: left;">
                                        <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Room Type</th>
                                        <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Room No.</th>
                                        <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Occupancy</th>
                                        <th style="padding: 4px 8px; border-bottom: 1px solid #cbd5e0;">Special
                                            Instructions / Notes
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="line.hotel_room_ids" t-as="room">
                                        <tr>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7;">
                                                <span t-field="room.room_type_id.name"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7; font-weight: bold;">
                                                <span t-field="room.room_number"/>
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7;">
                                                <span t-field="room.persons_number"/>
                                                Person(s)
                                            </td>
                                            <td style="padding: 5px 8px; border-bottom: 1px solid #edf2f7; color: #718096;">
                                                <span t-field="room.note"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <t t-elif="line.service_type == 'transportation'">
                            <div style="font-size: 11pt; font-weight: bold; color: #234e52; background-color: #e6fffa; padding: 5px 8px; margin-top: 15px; border-left: 4px solid #319795;">
                                Transportation Journey Routing Details
                            </div>

                            <div style="font-size: 8.5pt; font-weight: bold; color: #4a5568; margin-top: 15px; margin-bottom: 4px;">
                                Schedule &amp; Routing Stops Ledger:
                            </div>
                            <table style="width: 100%; border-collapse: collapse; font-size: 9pt; border: 1px solid #cbd5e0;">
                                <thead>
                                    <tr style="background-color: #f0fff4; text-align: left;">
                                        <th style="padding: 6px 8px; border: 1px solid #cbd5e0; width: 50%;">Departure
                                            Framework (From)
                                        </th>
                                        <th style="padding: 6px 8px; border: 1px solid #cbd5e0; width: 50%;">Arrival
                                            Framework (To)
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="line.transportation_location_ids" t-as="loc">
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #edf2f7; vertical-align: top;">
                                                <strong>Location:</strong>
                                                <span t-field="loc.from_location"/>
                                                <br/>
                                                <span style="color: #4a5568; font-size: 8.5pt;"
                                                      t-field="loc.from_datetime"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #edf2f7; vertical-align: top;">
                                                <strong>Location:</strong>
                                                <span t-field="loc.to_location"/>
                                                <br/>
                                                <span style="color: #4a5568; font-size: 8.5pt;"
                                                      t-field="loc.to_datetime"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <t t-else="">
                            <div style="margin-top: 30px; border-top: 1px dashed #cbd5e0; padding-top: 15px; color: #718096; font-style: italic;">
                                No automated specific logistics breakdown is configured for this line's service type.
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>