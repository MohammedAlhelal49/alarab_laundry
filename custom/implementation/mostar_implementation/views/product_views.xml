<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_variant_form_inherit_voucher_image" model="ir.ui.view">
        <field name="name">product.product.form.inherit.voucher.image</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Voucher Settings" name="voucher_settings">
                    <group>
                        <group>
                            <field name="voucher_image" widget="image" options="{'size': [256, 256]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>