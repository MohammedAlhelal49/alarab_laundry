<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_purchase_amount" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.purchase.amount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="partner_salutation"/>
            </xpath>

            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="purchase_order_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       domain="[('related_sale_order_id', '=', False)]"
                       placeholder="Select unlinked purchase orders..."/>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="purchase_order_amount" widget="monetary" readonly="1"/>
                <field name="margin" widget="monetary" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_margin" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="purchase_order_amount" widget="monetary" optional="show" readonly="1" sum="Total"/>
                <field name="margin" widget="monetary" optional="show" readonly="1" sum="Total"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_margin" model="ir.ui.view">
        <field name="name">sale.order.tree.order.inherit.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="purchase_order_amount" widget="monetary" optional="show" readonly="1"/>
                <field name="margin" widget="monetary" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_mostar" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.mostar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="before">
                <field name="service_type" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <button name="action_open_line_form_view"
                        type="object"
                        icon="fa-external-link"
                        title="Configure Details"
                        class="btn-sm btn-link"/>
            </xpath>

        </field>
    </record>

    <record id="view_sale_order_line_form_modal" model="ir.ui.view">
        <field name="name">sale.order.line.form.modal.extended</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Detailed Order Line Configurations">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                            <field name="service_type"/>
                            <field name="ticket_type" invisible="service_type not in ('ticket', 'tours_packages')"/>
                        </group>
                    </group>

                    <notebook invisible="not service_type">
                        <page string="Departure Ticket Information"
                              invisible="service_type not in ('ticket', 'tours_packages') or ticket_type == 'return'">
                            <group>
                                <group string="Flight Logistics">
                                    <field name="ticket_x_number" string="Ticket number"/>
                                    <field name="ticket_x_plane_number" string="Plane number"/>
                                    <field name="ticket_x_bnr" string="PNR"/>
                                    <field name="ticket_x_seat_number" string="Seat number"/>
                                    <field name="ticket_x_passenger_ids"
                                           widget="many2many_tags"
                                           placeholder="Select or create passengers..."
                                           invisible="service_type not in ('ticket', 'tours_packages')"/>
                                </group>

                                <group string="Schedule &amp; Routing">
                                    <!-- Departure Block -->
                                    <label for="ticket_x_leave_date" string="Departure"/>
                                    <div class="o_row">
                                        <field name="ticket_x_leave_date" placeholder="Date &amp; Time"
                                               style="width: 55%; margin-right: 10px;"/>
                                        <span class="text-muted" style="margin-right: 5px; font-weight: bold;">From:
                                        </span>
                                        <field name="ticket_x_from" placeholder="e.g. DXB" style="width: 35%;"/>
                                    </div>
                                    <field name="ticket_x_leave_notes" string="Description"
                                           placeholder="Notes regarding departure..." rows="2"/>

                                    <!-- Separator -->
                                    <separator style="margin-top: 12px; margin-bottom: 12px;"/>

                                    <!-- Arrival Block -->
                                    <label for="ticket_x_arrive_date" string="Arrival"/>
                                    <div class="o_row">
                                        <field name="ticket_x_arrive_date" placeholder="Date &amp; Time"
                                               style="width: 55%; margin-right: 10px;"/>
                                        <span class="text-muted" style="margin-right: 5px; font-weight: bold;">To:
                                        </span>
                                        <field name="ticket_x_to" placeholder="e.g. LHR" style="width: 35%;"/>
                                    </div>
                                    <field name="ticket_x_arrive_notes" string="Description"
                                           placeholder="Notes regarding arrival..." rows="2"/>
                                </group>
                            </group>

                            <group string="Baggage Weights Configuration">
                                <field name="ticket_x_bag_weight_ids" string="Ticket bag weights"
                                       context="{'default_ticket_x_sale_line_id': id}">
                                    <list editable="bottom">
                                        <field name="bag_type_id"/>
                                        <field name="weight"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Return Ticket Information"
                              invisible="service_type not in ('ticket', 'tours_packages') or ticket_type == 'departure'">
                            <group>
                                <group string="Flight Logistics">
                                    <field name="ticket_y_number" string="Ticket number"/>
                                    <field name="ticket_y_plane_number" string="Plane number"/>
                                    <field name="ticket_y_bnr" string="PNR"/>
                                    <field name="ticket_y_seat_number" string="Seat number"/>
                                    <field name="ticket_y_passenger_ids"
                                           widget="many2many_tags"
                                           placeholder="Select or create passengers..."
                                           invisible="service_type not in ('ticket', 'tours_packages')"/>
                                </group>

                                <group string="Schedule &amp; Routing">
                                    <!-- Departure Block -->
                                    <label for="ticket_y_leave_date" string="Departure"/>
                                    <div class="o_row">
                                        <field name="ticket_y_leave_date" placeholder="Date &amp; Time"
                                               style="width: 55%; margin-right: 10px;"/>
                                        <span class="text-muted" style="margin-right: 5px; font-weight: bold;">From:
                                        </span>
                                        <field name="ticket_y_from" placeholder="e.g. DXB" style="width: 35%;"/>
                                    </div>
                                    <field name="ticket_y_leave_notes" string="Description"
                                           placeholder="Notes regarding departure..." rows="2"/>

                                    <!-- Separator -->
                                    <separator style="margin-top: 12px; margin-bottom: 12px;"/>

                                    <!-- Arrival Block -->
                                    <label for="ticket_y_arrive_date" string="Arrival"/>
                                    <div class="o_row">
                                        <field name="ticket_y_arrive_date" placeholder="Date &amp; Time"
                                               style="width: 55%; margin-right: 10px;"/>
                                        <span class="text-muted" style="margin-right: 5px; font-weight: bold;">To:
                                        </span>
                                        <field name="ticket_y_to" placeholder="e.g. LHR" style="width: 35%;"/>
                                    </div>
                                    <field name="ticket_y_arrive_notes" string="Description"
                                           placeholder="Notes regarding arrival..." rows="2"/>
                                </group>
                            </group>

                            <group string="Baggage Weights Configuration">
                                <field name="ticket_y_bag_weight_ids" string="Ticket bag weights"
                                       context="{'default_ticket_y_sale_line_id': id}">
                                    <list editable="bottom">
                                        <field name="bag_type_id"/>
                                        <field name="weight"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Hotel Information" invisible="service_type not in ('hotel')">
                            <group>
                                <group string="Property Details">
                                    <field name="hotel_name"/>
                                    <field name="hotel_number"/>
                                    <field name="hotel_country_id" options="{'no_create': True}"/>
                                    <field name="hotel_street"/>
                                    <field name="booking_id"/>
                                </group>
                                <group string="Stay Duration">
                                    <field name="hotel_check_in_date"/>
                                    <field name="hotel_check_out_date"/>
                                </group>
                            </group>
                            <group string="Rooms Details">
                                <field name="hotel_room_ids" context="{'default_sale_line_id': id}">
                                    <list editable="bottom">
                                        <field name="room_number"/>
                                        <field name="persons_number"/>
                                        <field name="gender"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Hotel Information" invisible="service_type not in ('tours_packages')">
                            <field name="tour_hotel_ids" context="{'default_sale_line_id': id}">
                                <list editable="bottom">
                                    <field name="booking_id"/>
                                    <field name="hotel_name"/>
                                    <field name="hotel_number" string="HCN"/>
                                    <field name="hotel_type_id" context="{'show_attribute': False}"/>
                                    <field name="meal_id" context="{'show_attribute': False}"/>
                                    <field name="hotel_check_in_date"/>
                                    <field name="hotel_check_out_date"/>
                                    <field name="guest_number"/>
                                    <field name="night_number"/>
                                </list>
                            </field>
                        </page>

                        <page string="Transportation Details"
                              invisible="service_type not in ('transportation', 'tours_packages')">
                            <group>
                                <field name="transportation_type" widget="radio" options="{'horizontal': True}"/>
                            </group>
                            <group string="Route Locations Ledger">
                                <field name="transportation_location_ids" context="{'default_sale_line_id': id}">
                                    <list editable="bottom">
                                        <field name="vehicle_type_id" options="{'no_create': False}"/>
                                        <field name="vehicle_count"/>
                                        <field name="from_location"/>
                                        <field name="from_datetime"/>
                                        <field name="to_location"/>
                                        <field name="to_datetime"/>
                                    </list>
                                </field>
                            </group>
                        </page>


                        <page string="Tours Details"
                              invisible="service_type != 'tours_packages'">
                            <field name="tours_ids" context="{'default_sale_line_id': id}">
                                <list editable="bottom">
                                    <field name="details"/>
                                    <field name="details_date"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <footer>
                    <button string="Save &amp; Close" type="object" special="save" class="btn-primary"/>
                    <button string="Discard" type="object" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
