<!-- attendance_location/views/medical_note_history_views.xml -->
<odoo>

  <!-- List View for Medical Notes -->
  <record id="view_medical_note_history_list" model="ir.ui.view">
    <field name="name">attendance_location.medical_note_history.list</field>
    <field name="model">attendance_location.medical_note_history</field>
    <field name="arch" type="xml">
      <list string="Medical Notes History">
        <field name="create_date" widget="datetime"/>
        <field name="title"/>
      </list>
    </field>
  </record>

  <!-- Form View for Medical Note Entry -->
  <record id="view_medical_note_history_form" model="ir.ui.view">
    <field name="name">attendance_location.medical_note_history.form</field>
    <field name="model">attendance_location.medical_note_history</field>
    <field name="arch" type="xml">
      <form string="Medical Note">
        <sheet>
          <group>
            <field name="title"/>
            <field name="note_text"/>
            <field name="attachment" filename="attachment_filename"/>
          </group>
        </sheet>
        <!-- Odoo 18 Compliant Chatter Section -->
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Window Action to Open Medical Notes -->
  <record id="action_medical_note_history" model="ir.actions.act_window">
    <field name="name">Medical Notes History</field>
    <field name="res_model">attendance_location.medical_note_history</field>
    <field name="view_mode">list,form</field>
    <field name="target">new</field>
    <field name="context">{'default_patient_id': active_id}</field>
  </record>

</odoo>
