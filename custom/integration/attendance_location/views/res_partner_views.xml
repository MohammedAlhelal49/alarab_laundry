<!-- attendance_location/views/res_partner_views.xml -->
<odoo>
  <record id="view_attendance_location_res_partner" model="ir.ui.view">
    <field name="name">res.partner.form.attendance_location</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <!-- New Page: GPS Location -->
        <page string="GPS Location">
          <group string="Geolocation Details">
            <field name="gps_latitude"/>
            <field name="gps_longitude"/>
            <button name="action_get_gps_coordinates"
                    type="object"
                    string="Locate Me"
                    class="btn-primary"
                    icon="fa-crosshairs"/>
            <button name="action_open_gps_location"
                    type="object"
                    string="View on Maps"
                    class="btn-secondary"
                    icon="fa-map-marker"/>
            <field name="gps_last_updated" readonly="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
