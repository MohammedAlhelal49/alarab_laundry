<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Gantt View -->
    <!-- ===================================================== -->

    <record id="view_sale_order_availability_gantt" model="ir.ui.view">
        <field name="name">sale.order.availability.gantt</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <gantt
                string="Availability"
                date_start="rental_start_date"
                date_stop="end_date"
                color="partner_id"
                default_scale="year"
                display_unavailability="true"/>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Inherit Sale Order List -->
    <!-- ===================================================== -->

    <record id="view_sale_order_tree_availability" model="ir.ui.view">
        <field name="name">sale.order.tree.availability</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">

                <!-- Replace with account_analytic_account_id if renamed -->
                <field name="account_analytic_account_id" optional="show"/>

            </xpath>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Action -->
    <!-- ===================================================== -->

    <record id="action_real_estate_availability" model="ir.actions.act_window">
        <field name="name">Availability</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">gantt,list,form</field>

        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'gantt', 'view_id': ref('view_sale_order_availability_gantt')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale.view_order_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form')})
        ]"/>
    </record>

    <record id="filter_availability_default" model="ir.filters">
        <field name="name">Availability</field>
        <field name="model_id">sale.order</field>
        <field name="user_id" eval="False"/>
        <field name="is_default">True</field>
        <field name="action_id" ref="dekad_enterprise_real_estate.action_real_estate_availability"/>
        <field name="domain">[]</field>
        <field name="context">
            {
                'group_by': [
                    'related_building_id',
                    'account_analytic_account_id'
                ]
            }
        </field>
        <field name="sort">[]</field>
    </record>
</odoo>