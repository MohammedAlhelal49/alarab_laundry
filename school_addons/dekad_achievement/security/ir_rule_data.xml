        <record id="group_de_achievement" model="res.groups">
            <field name="name">Achievements</field>
            <field name="category_id" ref="dekad_core.module_category_school"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">70</field>
        </record>

        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
