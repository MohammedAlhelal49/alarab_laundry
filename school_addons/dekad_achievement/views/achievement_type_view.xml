<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_de_achievement_type_list" model="ir.ui.view">
            <field name="name">de.achievement.type.list</field>
            <field name="model">de.achievement.type</field>
            <field name="arch" type="xml">
                <list string="Achievement Type" editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_de_achievement_type_view" model="ir.actions.act_window">
            <field name="name">Achievement Types</field>
            <field name="res_model">de.achievement.type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_de_achievement_type_view_list">
            <field name="act_window_id" ref="action_de_achievement_type_view"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_de_achievement_type_list"/>
        </record>
    </data>
</odoo>