<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_de_activity" model="res.groups">
            <field name="name">Activities</field>
            <field name="category_id" ref="dekad_core.module_category_student"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">20</field>
        </record>

        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_activity'))]"/>
        </record>

        <record model="ir.rule" id="teacher_de_activity_rule">
            <field name="name">Teacher Activity rule</field>
            <field name="model_id" ref="model_de_activity"/>
            <field name="groups"
                   eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('student_id.id','in',user.student_ids.ids)]
            </field>
        </record>


        <record model="ir.rule" id="portal_de_activity_rule">
            <field name="name">Portal Activity rule</field>
            <field name="model_id" ref="model_de_activity"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|', ('student_id.user_id','=',user.id),
                ('student_id.user_id','in',user.child_ids.ids) , ('state' , '!=' , 'draft')]
            </field>
        </record>
    </data>
</odoo>
