<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_de_student_form_activity_inherited" model="ir.ui.view">
            <field name="name">de.student.form.activity.inherited</field>
            <field name="model">de.student</field>
            <field name="inherit_id" ref="dekad_core.view_de_student_form"/>
            <field name="priority" eval="5"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_show_activity" type="object" class="oe_stat_button" icon="fa-file-text"
                            groups="dekad_activity.group_de_activity">
                        <field string="Activity" name="activity_count" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>