    <!-- breadcrumb -->
    <template id="portal_student_activity_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name=='Activities'" t-attf-class="breadcrumb-item">
                <a t-att-href="page_url">Activities
                </a>
            </li>

            <li t-if="page_name=='Activity show'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Activities
                </a>
                <span>/</span>
                <a t-att-href="page_url">
                    <t t-esc="record.display_name"/>
                </a>
            </li>
        </xpath>
    </template>
    <!-- breadcrumb -->


    <!-- list -->
    <template id="student_activity" name="Activity list">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
            </t>

            <div class="card dynamic-website-card-holder">

                <div class="card-body dynamic-website-card">
                    <t t-if="activity_records" t-call="portal.portal_table">
                        <table
                                class="table"
                        >
                            <thead>
                                <tr>

                                    <th scope="col">
                                        Activity type
                                    </th>
                                    <th scope="col">
                                        Activity time
                                    </th>
                                    <th scope="col">
                                        The Responsible
                                    </th>

                                    <th scope="col">
                                        Status
                                    </th>

                                    <th scope="col">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="activity_records"
                                   t-as="activity">
                                    <tr>


                                        <td>
                                            <span t-esc="activity.type_id.name"/>
                                        </td>

                                        <td>
                                            <span t-esc="activity.activity_time" t-options="{'widget':'datetime'}"/>
                                        </td>


                                        <td>
                                            <span t-esc="activity.responsible_id.name"/>
                                        </td>


                                        <td>
                                            <t t-if="activity.state == 'confirm'">
                                                <span class="badge badge-pill bg-info"
                                                      t-out="'Pending accept'"/>
                                            </t>
                                            <t t-elif="activity.state == 'accept'">
                                                <span class="badge badge-pill bg-success"
                                                      t-out="'Accepted'"/>
                                            </t>

                                            <t t-else="activity.state == 'reject'">
                                                <span class="badge badge-pill bg-warning"
                                                      t-out="'Rejected'"/>
                                            </t>
                                        </td>

                                        <td class="action-btn-links">
                                            <t t-if="parent_student_param">
                                                <t t-set="show_url"
                                                   t-value="'/student/activity/' + str(activity.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="show_url"
                                                   t-value="'/student/activity/' + str(activity.id)"/>
                                            </t>

                                            <a
                                                    t-if="parent_student_param and activity.state =='confirm'"
                                                    t-att-href="'/student/activity/' + str(activity.id) +  '/accept' + '?parent_student_param=' + str(parent_student_param)">
                                                <button
                                                        class="btn btn-outline-secondary btn-sm">
                                                    Accept
                                                </button>
                                            </a>

                                            <a
                                                    t-if="parent_student_param and activity.state =='confirm'"
                                                    t-att-href="'/student/activity/' + str(activity.id) +  '/reject' + '?parent_student_param=' + str(parent_student_param)">
                                                <button
                                                        class="btn btn-outline-secondary btn-sm">
                                                    Reject
                                                </button>
                                            </a>

                                            <a
                                                    t-att-href="show_url">
                                                <button class="btn btn-outline-secondary btn-sm">
                                                    Show
                                                </button>
                                            </a>
                                        </td>


                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <div class="alert alert-info" role="alert">
                            There are no Activities to display.
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    <!-- list -->


    <!-- show -->
    <template id="student_activity_show" name="Activity show">
        <t t-call="portal.portal_layout">

            <div class="card portal-page-content show-page">
                <div class="card-body row">
                    <div class="col-12"
                    >
                        <h5>Activity full information
                        </h5>
                    </div>
                    <div class=" col-12 col-md-6"
                    >
                        <strong class="">Classroom :</strong>
                        <span t-esc="record.classroom_id.display_name"/>
                    </div>
                    <div class=" col-12 col-md-6"
                    >
                        <strong class="">Activity type :</strong>
                        <span t-esc="record.type_id.name"/>

                    </div>

                    <div class=" col-12 col-md-6"
                    >
                        <strong class="">Activity Time :</strong>
                        <span t-esc="record.create_date" t-options="{'widget':'datetime'}"/>
                    </div>

                    <div class="col-12 col-md-6"
                    >
                        <strong class="">The responsible :</strong>
                        <span t-esc="record.responsible_id.name"/>
                    </div>

                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Status :</strong>

                        <t t-if="record.state == 'confirm'">
                            <span class="badge badge-pill bg-info"
                                  t-out="'Pending accept'"/>
                        </t>
                        <t t-elif="record.state == 'accept'">
                            <span class="badge badge-pill bg-success"
                                  t-out="'Accepted'"/>
                        </t>

                        <t t-else="record.state == 'reject'">
                            <span class="badge badge-pill bg-warning"
                                  t-out="'Rejected'"/>
                        </t>
                    </div>

                    <div class="col-12 col-md-6" t-if="record.file_name"
                    >

                        <strong class="">Attachment :</strong>
                        <span t-esc="file_name"/>

                        <a
                                t-attf-href="/student/activity/download/#{record.id}">
                            <i class="fa fa-download form-file-download-icon"
                            />
                        </a>


                    </div>


                    <div class=" col-12"
                    >
                        <strong class="">Full description :</strong>
                        <span t-esc="record.description"/>

                    </div>

                </div>
            </div>
        </t>

    </template>
    <!-- show -->


</odoo>
