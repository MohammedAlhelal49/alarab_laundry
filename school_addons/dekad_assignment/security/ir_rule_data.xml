<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="group_de_assignment" model="res.groups">
            <field name="name">Assignments</field>
           <field name="category_id" ref="dekad_core.module_category_student"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">50</field>
        </record>

        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_assignment'))]"/>
        </record>

        <record model="ir.rule" id="teacher_de_assignment_rule">
            <field name="name">Teacher assignment rule</field>
            <field name="model_id" ref="model_de_assignment"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('teacher_id.user_id' , '=' , user.id)]</field>
        </record>

           <record model="ir.rule" id="teacher_de_assignment_submission_rule">
            <field name="name">Teacher assignment submission rule</field>
            <field name="model_id" ref="model_de_assignment_submission"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('assignment_id.teacher_id.user_id' , '=' , user.id)]</field>
        </record>

        <record model="ir.rule" id="portal_assignment_rule">
            <field name="name">Portal Assignment rule</field>
            <field name="model_id" ref="model_de_assignment"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|',('student_ids.user_id','=',user.id) , ('student_ids.user_id', 'in'
                ,user.child_ids.ids) , ('state' , '!=' , 'draft')]
            </field>
        </record>

        <record model="ir.rule" id="portal_assignment_submission_rule">
            <field name="name">Portal Assignment Submission Rule</field>
            <field name="model_id" ref="model_de_assignment_submission"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|',('student_id.user_id','=',user.id) , ('student_id.user_id', 'in'
                ,user.child_ids.ids), ('state' , '!=' , 'draft')]
            </field>
        </record>
    </data>
</odoo>