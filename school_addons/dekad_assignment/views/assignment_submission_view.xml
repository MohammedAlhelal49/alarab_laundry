<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_de_assignment_submission_form_quick_create" model="ir.ui.view">
            <field name="name">de.assignment.submission.form.quick.create</field>
            <field name="model">de.assignment.submission</field>
            <field name="arch" type="xml">
                <form string="Assignment submission" duplicate="0">
                    <field name="id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="is_assignment_user" invisible="1"/>

                    <header groups="base.group_user" invisible="id  == False">
                        <button name="set_confirm" invisible="state != 'draft'" type="object"
                                string="Confirm" class="oe_highlight"
                                groups="dekad_assignment.group_de_assignment"/>
                        <button name="set_draft" invisible="state != 'confirm'" type="object"
                                string="Draft" groups="dekad_assignment.group_de_assignment"
                        />
                        <button name="set_cancel" invisible="state not in  ('accept','reject')" type="object"
                                string="Cancel"/>
                        <button name="set_accept" invisible="state != 'confirm'" type="object"
                                string="Accept" class="oe_highlight"/>
                        <button name="set_reject" invisible="state != 'confirm'" type="object"
                                string="Reject"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>

                                <field name="student_id" options="{'no_open' : True}"
                                       readonly="1"
                                />

                                <field name="create_date" readonly="1"
                                       invisible="create_date  == False"/>
                            </group>
                            <group>
                                <field name="mark" string="mark"
                                />
                                <field name="file" readonly="is_assignment_user  == False" filename="file_name"/>
                                <field name="file_name" invisible="1"/>  <!-- Added by Ahmed -->


                            </group>

                            <separator string="Description"/>
                            <field name="description" readonly="is_assignment_user  == False"/>

                            <separator string="Correction notice" invisible="state not in ('accept' , 'reject')"
                            />
                            <field name="notice" invisible="state not in ('accept' , 'reject')"/>

                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_assignment_submission_tree" model="ir.ui.view">
            <field name="name">de.assignment.submission.list</field>
            <field name="model">de.assignment.submission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Assignment submission">
                    <field name="assignment_id"/>
                    <field name="student_id"/>
                    <field name="mark"/>
                    <field name="state"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="view_de_assignment_submission_form" model="ir.ui.view">
            <field name="name">de.assignment.submission.form</field>
            <field name="model">de.assignment.submission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Assignment submission" duplicate="0">
                    <field name="id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="student_ids" invisible="1"/>

                    <field name="is_assignment_user" invisible="1"/>

                    <header groups="base.group_user" invisible="id == False">
                        <button name="set_confirm" invisible="state != 'draft'" type="object"
                                string="Confirm" class="oe_highlight"
                                groups="dekad_assignment.group_de_assignment"/>
                        <button name="set_draft" invisible="state != 'confirm'" type="object"
                                string="Draft" groups="dekad_assignment.group_de_assignment"
                        />
                        <button name="set_cancel" invisible="state not in ('accept','reject')" type="object"
                                string="Cancel"/>
                        <button name="set_accept" invisible="state != 'confirm'" type="object"
                                string="Accept" class="oe_highlight"/>
                        <button name="set_reject" invisible="state != 'confirm'" type="object"
                                string="Reject"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="assignment_id"
                                       domain="[('state','=','confirm')]"
                                       options="{'no_create': True}"
                                       readonly="is_assignment_user == False and id != False"/>


                                <field name="student_id" options="{'no_create': True , 'no_open' : True}"
                                       domain="[('id','in',student_ids)]"
                                       readonly="is_assignment_user == False and id != False"
                                />

                                <field name="create_date" readonly="1"
                                       invisible="create_date == False"/>
                            </group>
                            <group>
                                <field name="mark" string="mark"
                                />
                                <field name="file" readonly="is_assignment_user == False and id != False" filename="file_name"/>
                                <field name="file_name" invisible="1"/>  <!-- Added by Ahmed -->


                            </group>

                            <separator string="Description"/>
                            <field name="description" readonly="is_assignment_user == False and id != False"
                            />

                            <separator string="Correction notice" invisible="state not in ('accept','reject')"
                            />
                            <field name="notice" invisible="state not in ('accept','reject')"/>

                        </group>

                    </sheet>


                        <field name="message_ids" widget="mail_thread"/>

                </form>
            </field>
        </record>


        <record id="view_de_assignment_submission_search" model="ir.ui.view">
            <field name="name">de.assignment.submission.search</field>
            <field name="model">de.assignment.submission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Assignment Submission">
                    <field name="assignment_id"/>
                    <field name="student_id"/>

                    <field name="state"/>
                    <filter string="Today" name="filter_submission_today"
                            domain="[('create_date', '&gt;=', time.strftime('%%Y-%%m-%%d 00:00:00')),('create_date', '&lt;=', time.strftime('%%Y-%%m-%%d 23:59:59'))]"/>
                    <filter string="Last Week" name="filter_submission_week"
                            domain="[('create_date', '&gt;=',(context_today()-relativedelta(days=6)).strftime('%Y-%m-%d 00:00:00')),
                                    ('create_date', '&lt;', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <group expand="0" string="Group By...">
                        <filter string="Assignment" domain="[]" name="group_by_assignment"
                                context="{'group_by':'assignment_id'}"/>
                        <filter string="Student" domain="[]" name="group_by_assignment_student"
                                context="{'group_by':'student_id'}"/>
                        <filter string="State" domain="[]" name="group_by_assignment_state"
                                context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_assignment_submission_view">
            <field name="name">Assignments Submissions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.assignment.submission</field>
            <field name="view_mode">list,form</field>
            <field name="binding_view_types">list,form</field>
            <field name="search_view_id" ref="view_de_assignment_submission_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_assignment_submission_view_tree">
            <field name="act_window_id" ref="act_open_de_assignment_submission_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_assignment_submission_tree"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_assignment_submission_view_form">
            <field name="act_window_id" ref="act_open_de_assignment_submission_view"/>
            <field name="view_mode">form</field>
            <field name="sequence" eval="20"/>
            <field name="view_id" ref="view_de_assignment_submission_form"/>
        </record>

    </data>
</odoo>
