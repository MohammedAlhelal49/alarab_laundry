<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_attendance_line_tree" model="ir.ui.view">
            <field name="name">de.attendance.line.list</field>
            <field name="model">de.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Attendance Line" create="0" delete="0">
                    <field name="classroom_id" optional="show"/>
                    <field name="attendance_sheet_id" optional="show"/>
                    <field name="student_id"/>
                    <field name="present"/>
                    <field name="absent"/>
                    <field name="leave"/>
                    <field name="remark" optional="show"/>
                    <field name="attendance_date"/>
                </list>
            </field>
        </record>

        <record id="view_de_attendance_line_form" model="ir.ui.view">
            <field name="name">de.attendance.line.form</field>
            <field name="model">de.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Attendance Line" delete="0" create="0">
                    <header/>
                    <sheet>
                        <group>
                            <group>

                                <field name="attendance_sheet_id" readonly="1"/>
                                <field name="classroom_id" options="{ 'no_open' :  True}"/>
                                <field name="student_id" options="{ 'no_open' :  True}" readonly="1"
                                />
                            </group>
                            <group>
                                <field name="present"/>
                                <field name="absent"/>
                                <field name="leave"/>

                                <field name="remark"/>
                                <field name="attendance_date"/>
                            </group>
                        </group>
                    </sheet>


                        <field name="message_ids" widget="mail_thread"/>

                </form>
            </field>
        </record>

        <record id="view_de_attendance_line_search" model="ir.ui.view">
            <field name="name">de.attendance.line.search</field>
            <field name="model">de.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Attendance Line">
                    <field name="attendance_sheet_id"/>
                    <field name="student_id"/>
                    <field name="present"/>
                    <filter string="Present" name="group_by_present"
                            domain="[('present', '=', True)]"/>
                    <filter string="Absent" name="group_by_absent"
                            domain="[('absent', '=', True)]"/>
                    <filter string="Leave" name="group_by_leave"
                            domain="[('leave', '=', True)]"/>
                    <filter string="Today" name="filter_attendance_today"
                            domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="Last Week" name="filter_attendance_week"
                            domain="[('attendance_date', '&gt;=', (context_today()-relativedelta(days=6)).strftime('%Y-%m-%d')),
                    (   'attendance_date', '&lt;=', context_today().strftime('%Y-%m-%d')    )]"/>
                    <filter string="Last Month" name="filter_attendance_month"
                            domain="[('attendance_date', '&gt;=', (context_today()-relativedelta(days=29)).strftime('%Y-%m-%d')),
                    (   'attendance_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>

                    <group string="Group By...">
                        <filter string="Attendance" name="group_by_attendance_sheet"
                                domain="[]" context="{'group_by':'attendance_sheet_id'}"/>
                        <filter string="Classroom" name="group_by_classroom"
                                domain="[]" context="{'group_by':'classroom_id'}"/>
                        <filter string="Student" name="group_by_student"
                                domain="[]" context="{'group_by':'student_id'}"/>
                        <filter string="Present ?" name="group_by_present"
                                domain="[]" context="{'group_by':'present'}"/>
                        <filter string="Absent ?" name="group_by_absent"
                                domain="[]" context="{'group_by':'absent'}"/>
                        <filter string="Leave ?" name="group_by_leave"
                                domain="[]" context="{'group_by':'leave'}"/>
                        <filter string="Date" name="group_by_attendance_date"
                                domain="[]" context="{'group_by':'attendance_date'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record model="ir.ui.view" id="view_de_attendance_line_graph">
            <field name="name">de.attendance.line.graph</field>
            <field name="model">de.attendance.line</field>
            <field name="arch" type="xml">
                <graph string="Attendance Line" type="bar">
                    <field name="classroom_id"/>
                    <field name="absent"/>
                </graph>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_attendance_line_view">
            <field name="name">Student attendance</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.attendance.line</field>
            <field name="view_mode">list,form</field>
            <field name="binding_view_types">list,form,graph</field>
            <field name="search_view_id" ref="view_de_attendance_line_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_attendance_line_view_tree">
            <field name="act_window_id" ref="act_open_de_attendance_line_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_attendance_line_tree"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_attendance_line_view_form">
            <field name="act_window_id" ref="act_open_de_attendance_line_view"/>
            <field name="view_mode">form</field>
            <field name="sequence" eval="20"/>
            <field name="view_id" ref="view_de_attendance_line_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_attendance_line_view_graph">
            <field name="act_window_id" ref="act_open_de_attendance_line_view"/>
            <field name="view_mode">graph</field>
            <field name="sequence" eval="30"/>
            <field name="view_id" ref="view_de_attendance_line_graph"/>
        </record>

    </data>
</odoo>
