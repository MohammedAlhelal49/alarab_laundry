<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_student_form_attendance_inherited" model="ir.ui.view">
            <field name="name">de.student.form.attendance.inherited</field>
            <field name="model">de.student</field>
            <field name="inherit_id" ref="dekad_core.view_de_student_form"/>
            <field name="priority" eval="4"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button"
                            type="object"
                            name="action_show_attendance"
                            icon="fa-calendar"
                            groups="dekad_attendance.group_de_attendance"
                    >
                        <span>Attendance</span>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>