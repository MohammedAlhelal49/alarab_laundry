<?xml version="1.0"?>
<odoo>

    <!-- document -->
    <template id="student_attendance_doc_entry" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="student_attendance_document and student_attendance_document['show']"
               t-call="portal.portal_docs_entry">
                <t t-set="url" t-value="student_attendance_document['url']"/>
                <t t-set="title" t-value="'Attendance'"/>
                <t t-set="icon"><i class="fa fa-list"/></t>


                <t t-set="count">
                    <span class="document_item_count" t-esc="student_attendance_document['count']"/>
                </t>
                <div class="clearing"/>

            </t>

        </xpath>
    </template>
    <!-- document -->


    <!-- breadcrumb -->
    <template id="portal_student_attendance_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name=='Attendance'" t-attf-class="breadcrumb-item">
                <a t-att-href="page_url">Attendance
                </a>
            </li>
        </xpath>
    </template>
    <!-- breadcrumb -->


    <!-- list -->
    <template id="student_attendance" name="Attendance list">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
            </t>

            <div class="card dynamic-website-card-holder">

                <div class="card-body dynamic-website-card">
                    <t t-if="attendance_records" t-call="portal.portal_table">
                        <table
                                class="table"
                        >
                            <thead>
                                <tr>
                                    <th scope="col">
                                        Classroom
                                    </th>
                                    <th scope="col">
                                        Sheet
                                    </th>
                                    <th scope="col">
                                        Date
                                    </th>
                                    <th scope="col">
                                        Remark
                                    </th>
                                    <th scope="col">
                                        Status
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="attendance_records"
                                   t-as="attendance">
                                    <tr>

                                        <td>
                                            <span t-esc="attendance.classroom_id.name_get()[0][1]"/>
                                        </td>

                                        <td>
                                            <span t-esc="attendance.attendance_sheet_id.sequence"/>
                                        </td>

                                        <td>
                                            <span t-esc="attendance.attendance_date" t-options="{'widget':'date'}"/>
                                        </td>
                                        <td>
                                            <span t-esc="attendance.remark"/>
                                        </td>
                                        <td>
                                            <t t-if="attendance.present">
                                                <span class="badge badge-pill bg-success"
                                                      t-out="'Present'"/>
                                            </t>
                                            <t t-elif="attendance.absent">
                                                <span class="badge badge-pill bg-warning"
                                                      t-out="'Absent'"/>
                                            </t>
                                            <t t-else="">
                                                <span class="badge badge-pill bg-info"
                                                      t-out="'Leave'"/>
                                            </t>
                                        </td>

                                    </tr>
                                </t>
                            </tbody>
                        </table>


                    </t>
                    <t t-else="">
                        <div class="alert alert-info" role="alert">
                            There are no attendance to display.
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    <!-- list -->


</odoo>
