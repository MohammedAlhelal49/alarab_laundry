<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- products -->
        <record id="de_product_category_1" model="de.product.category">
            <field name="name">Classroom assets</field>
        </record>

        <record id="de_product_1" model="de.product">
            <field name="category_id" ref="de_product_category_1"/>
            <field name="name">Classroom table</field>
            <field name="image" type="base64"
                   file="dekad_classroom/static/img/table.jpg"/>
        </record>
        <record id="de_product_2" model="de.product">
            <field name="category_id" ref="de_product_category_1"/>
            <field name="name">Classroom board</field>
            <field name="image" type="base64"
                   file="dekad_classroom/static/img/board.jpg"/>
        </record>

        <!-- classrooms -->
        <record id="de_classroom_1" model="de.classroom">
            <field name="grade_id" ref="dekad_core.de_grade_1"/>
            <field name="name">Classroom 1</field>
            <field name="sequence">10</field>
            <field name="capacity">30</field>
        </record>
        <record id="de_classroom_2" model="de.classroom">
            <field name="grade_id" ref="dekad_core.de_grade_1"/>
            <field name="name">Classroom 2</field>
            <field name="sequence">20</field>
            <field name="capacity">30</field>
        </record>
        <record id="de_classroom_3" model="de.classroom">
            <field name="grade_id" ref="dekad_core.de_grade_1"/>
            <field name="name">Classroom 3</field>
            <field name="sequence">30</field>
            <field name="capacity">30</field>
        </record>


        <record id="de_classroom_4" model="de.classroom">
            <field name="grade_id" ref="dekad_core.de_grade_2"/>
            <field name="name">Classroom 1</field>
            <field name="sequence">10</field>
            <field name="capacity">30</field>
        </record>
        <record id="de_classroom_5" model="de.classroom">
            <field name="grade_id" ref="dekad_core.de_grade_2"/>
            <field name="name">Classroom 2</field>
            <field name="sequence">20</field>
            <field name="capacity">30</field>
        </record>
        <record id="de_classroom_6" model="de.classroom">
            <field name="grade_id" ref="dekad_core.de_grade_2"/>
            <field name="name">Classroom 3</field>
            <field name="sequence">30</field>
            <field name="capacity">30</field>
        </record>
        <!-- assets -->
        <record id="de_asset_1" model="de.asset">
            <field name="classroom_id" ref="de_classroom_4"/>
            <field name="product_id" ref="de_product_1"/>
            <field name="qty">1</field>
        </record>

        <record id="de_asset_2" model="de.asset">
            <field name="classroom_id" ref="de_classroom_4"/>
            <field name="product_id" ref="de_product_2"/>
            <field name="qty">1</field>
        </record>


        <record id="de_asset_3" model="de.asset">
            <field name="classroom_id" ref="de_classroom_1"/>
            <field name="product_id" ref="de_product_1"/>
            <field name="qty">1</field>
        </record>

        <record id="de_asset_4" model="de.asset">
            <field name="classroom_id" ref="de_classroom_1"/>
            <field name="product_id" ref="de_product_2"/>
            <field name="qty">1</field>
        </record>
    </data>
</odoo>
