<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- asset form view -->
        <record id="view_de_asset_form" model="ir.ui.view">
            <field name="name">de.asset.form</field>
            <field name="model">de.asset</field>
            <field name="arch" type="xml">
                <form string="Asset">
                    <sheet>
                        <group>
                            <field name="product_id" context="{
                                'form_view_ref': 'dekad_classroom.view_de_product_form'
                                }"/>
                            <field name="product_category"/>
                            <field name="product_image" widget="image" class=" o_avatar role_image mb-3"/>

                            <field name="qty"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- product form view -->
        <record id="view_de_product_form" model="ir.ui.view">
            <field name="name">de.product.form</field>
            <field name="model">de.product</field>
            <field name="arch" type="xml">
                <form string="Product">
                    <sheet>
                        <group>
                            <field name="image" widget="image" class=" o_avatar role_image mb-3"/>
                            <field name="category_id"/>
                            <field name="name"/>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_classroom_list" model="ir.ui.view">
            <field name="name">de.classroom.list</field>
            <field name="model">de.classroom</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Classroom">
                    <field name="sequence" widget="handle"/>
                    <field name="grade_id"/>
                    <field name="name"/>
                    <field name="capacity" string="Students capacity" sum="Students capacity"/>
                    <field name="student_count" sum="Students count"/>
                </list>
            </field>
        </record>

        <record id="view_de_classroom_form" model="ir.ui.view">
            <field name="name">de.classroom.form</field>
            <field name="model">de.classroom</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Classroom" duplicate="0">
                    <field name="id" invisible="1"/>
                    <field name="filtered_student_count" invisible="1"/>
                    <field name="student_count" invisible="1"/>


                    <sheet>
                        <div name="button_box" class="o_button_box" invisible='id == False'>
                            <button name="action_show_student" type="object" class="o_stat_button" icon="fa-users"
                                    groups="dekad_core.group_de_student">
                                <field name="student_count" widget="statinfo"/>
                            </button>
                        </div>
                        <field name="active" invisible="1"/>
                        <field name="filtered_students" invisible="1" groups="dekad_classroom.group_de_classroom"
                        />


                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"

                                invisible='active == True'

                        />
                        <group>
                            <group>
                                <field name="grade_id" options="{'no_create': True , 'no_open' : True}"
                                />
                            </group>
                            <group>
                                <field name="name"/>
                                <field name="capacity"/>
                            </group>

                            <separator string="Students" groups="dekad_classroom.group_de_classroom"

                                       invisible="grade_id == False or filtered_student_count &lt; 1"
                            />
                            <field groups="dekad_classroom.group_de_classroom" can_create="false"
                                   name="student_ids"
                                   domain="[('id', 'in', filtered_students)

                                   ]"
                                   widget="many2many_tags" string="Students"
                                   placeholder="Add students to the Classroom"
                                   invisible="grade_id == False or filtered_student_count &lt; 1"

                            />

                            <button type="object" name="clear_all_students" class="one2many-clear-all"
                                    confirm="Are you sure you want to unlink all students from this classroom?"
                                    groups="dekad_classroom.group_de_classroom"
                                    invisible='student_count &lt; 1'
                            >
                                <i class="fa fa-close"/>
                                Clear all
                            </button>
                            <separator string="Assets"/>
                            <field name="asset_ids" string="Assets" context="{
                                'form_view_ref': 'dekad_classroom.view_de_asset_form'
                                }">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_classroom_search" model="ir.ui.view">
            <field name="name">de.classroom.search</field>
            <field name="model">de.classroom</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Classroom">
                    <field name="name"/>
                    <field name="capacity"/>
                    <filter string="Archived" name="inactive"
                            domain="[('active', '=', False)]"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter string="Grade" name="group_by_grade"
                                domain="[]" context="{'group_by':'grade_id'}"/>
                        <filter string="Capacity" name="group_by_capacity"
                                domain="[]" context="{'group_by':'capacity'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_de_classroom_graph">
            <field name="name">de.classroom.graph</field>
            <field name="model">de.classroom</field>
            <field name="arch" type="xml">
                <graph string="Classrooms per grade" type="bar" stacked="False">
                    <field name="name"/>
                    <field name="grade_id"/>
                    <field name="capacity" type="measure"/>
                </graph>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_classroom_view">
            <field name="name">ClassRooms</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.classroom</field>
            <field name="binding_view_types">list,form</field>
            <field name="view_mode">list,form,graph</field>
            <field name="search_view_id" ref="view_de_classroom_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_classroom_view_form">
            <field name="act_window_id" ref="act_open_de_classroom_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_de_classroom_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_classroom_view_graph">
            <field name="act_window_id" ref="act_open_de_classroom_view"/>
            <field name="sequence" eval="30"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_de_classroom_graph"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_classroom_view_list">
            <field name="act_window_id" ref="act_open_de_classroom_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_de_classroom_list"/>
        </record>
    </data>
</odoo>
