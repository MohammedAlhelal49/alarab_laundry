<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="de_complaint_category_1" model="de.complaint.category">
            <field name="name">Bad service</field>
            <field name="type">non-academic</field>
        </record>

        <record id="de_complaint_category_2" model="de.complaint.category">
            <field name="name">Grade correction</field>
            <field name="type">academic</field>
        </record>

        <record id="de_complaint_category_3" model="de.complaint.category">
            <field name="name">Mistreatment</field>
            <field name="type">non-academic</field>
        </record>


        <record id="de_complaint_1" model="de.complaint">
            <field name="category_id" ref="de_complaint_category_3"/>
            <field name="created_by">teacher</field>
            <field name="teacher_id" ref="dekad_core.de_teacher_1"/>
            <field name="subject">Mistreatment of school staff</field>
        </record>
        <record id="de_complaint_2" model="de.complaint">
            <field name="category_id" ref="de_complaint_category_1"/>
            <field name="created_by">parent</field>
            <field name="parent_id" ref="dekad_parent.de_parent_1"/>
            <field name="subject">My son is enrolled in the fifth grade and the service is bad in the school cafeteria </field>

        </record>

        <record id="de_complaint_3" model="de.complaint">
            <field name="category_id" ref="de_complaint_category_2"/>
            <field name="created_by">student</field>
            <field name="student_id" ref="dekad_core.de_student_2"/>
            <field name="subject">Please review the correction of the exams in the sixth grade in English</field>
        </record>
        <function model="de.complaint" name="set_reject" eval="[(ref('de_complaint_2'))]"/>
        <function model="de.complaint" name="set_action" eval="[(ref('de_complaint_1'))]"/>
        <record id="de_complaint_1" model="de.complaint">
            <field name="action">The matter will be reviewed by the competent authority</field>
        </record>
    </data>
</odoo>