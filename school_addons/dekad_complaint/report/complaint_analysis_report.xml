<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="de_complaint_analysis_report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="font">
                        <div class="page">
                            <br/>
                            <br/>
                            <br/>

                            <div class="text-center">
                                <h3>
                                    <strong>Complaint Analysis</strong>
                                </h3>
                            </div>
                            <div class="row  mt-5">
                                <div style="width:50%; margin-left:15px;">
                                    <b>Created by:</b>
                                    <span t-esc="data['created_by']"/>
                                </div>

                            </div>
                            <br/>
                            <table t-if = "len(complaints)" class="table table-bordered">
                                <thead class="text-center"
                                       style="background-color:#eeeeee; font-size:14px; font-weight:600;">
                                    <th t-if="data['created_by'] == 'teacher'">Teacher</th>
                                    <th t-if="data['created_by'] == 'parent'">Parent</th>
                                    <th t-if="data['created_by'] == 'student'">Student</th>
                                    <th>Subject</th>
                                    <th>Category</th>
                                    <th>Created at</th>
                                </thead>
                                <tbody class="text-center"
                                       style="font-size:12px;border-top: 1px solid #dbdbdb !important;">
                                    <tr t-foreach="complaints" t-as="complaint">
                                        <td t-if="data['created_by'] == 'teacher'">
                                            <span t-esc="complaint.teacher_id.name"/>
                                        </td>

                                        <td t-if="data['created_by'] == 'parent'">
                                            <span t-esc="complaint.parent_id.name"/>
                                        </td>
                                        <td t-if="data['created_by'] == 'student'">
                                            <span t-esc="complaint.student_id.name"/>
                                        </td>


                                        <td>
                                            <span t-esc="complaint.subject"/>
                                        </td>

                                        <td>
                                            <span t-esc="complaint.category_id.name"/>
                                        </td>

                                        <td>
                                            <span
                                                    t-esc="complaint.create_date"
                                                    t-options="{'widget':'date'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">
                                            <b>Total complaint</b>
                                        </td>
                                        <td class="text-center">
                                            <b>
                                                <span t-esc="len(complaints)"/>
                                            </b>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div t-else="" class="alert alert-secondary" role="alert">
                                There is no complaints to display
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
        <record id="act_open_de_complaint_analysis_report_view" model="ir.actions.report">
            <field name="name">complaint Analysis report</field>
            <field name="model">de.complaint.analysis.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dekad_complaint.de_complaint_analysis_report</field>
            <field name="report_file">dekad_complaint.de_complaint_analysis_report</field>
        </record>
    </data>
</odoo>
