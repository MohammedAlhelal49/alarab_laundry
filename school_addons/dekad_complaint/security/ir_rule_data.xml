<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="group_de_complaint" model="res.groups">
            <field name="name">Complaints</field>
            <field name="category_id" ref="dekad_core.module_category_school"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">80</field>
        </record>

        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_complaint'))]"/>
        </record>


        <record model="ir.rule" id="teacher_de_complaint_rule">
            <field name="name">Teacher complaint rule</field>
            <field name="model_id" ref="model_de_complaint"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('teacher_id.user_id' , '=' , user.id)]</field>
        </record>


        <record model="ir.rule" id="portal_de_complaint_rule">
            <field name="name">Portal complaint rule</field>
            <field name="model_id" ref="model_de_complaint"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|' , '|' , ( 'student_id.user_id', '=' , user.id) , ( 'student_id.user_id',
                'in' ,
                user.child_ids.ids) , ( 'parent_id.user_id', '=' , user.id), ('state' , '!=' , 'draft')]
            </field>
        </record>

    </data>
</odoo>