<?xml version="1.0"?>
<odoo>
    <!-- document -->
    <template id="student_complaint_doc_entry" inherit_id="portal.portal_my_home" priority="80">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="student_complaint_document and student_complaint_document['show']"
               t-call="portal.portal_docs_entry">
                <t t-set="url" t-value="student_complaint_document['url']"/>
                <t t-set="title" t-value="'Complaints'"/>
                <t t-set="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor"
                         class="bi bi-envelope-paper-fill" viewBox="0 0 16 16">
                        <path fill-rule="evenodd"
                              d="M6.5 9.5 3 7.5v-6A1.5 1.5 0 0 1 4.5 0h7A1.5 1.5 0 0 1 13 1.5v6l-3.5 2L8 8.75l-1.5.75ZM1.059 3.635 2 3.133v3.753L0 5.713V5.4a2 2 0 0 1 1.059-1.765ZM16 5.713l-2 1.173V3.133l.941.502A2 2 0 0 1 16 5.4v.313Zm0 1.16-5.693 3.337L16 13.372v-6.5Zm-8 3.199 7.941 4.412A2 2 0 0 1 14 16H2a2 2 0 0 1-1.941-1.516L8 10.072Zm-8 3.3 5.693-3.162L0 6.873v6.5Z"/>
                    </svg>
                </t>


                <t t-set="count">
                    <span class="document_item_count" t-esc="student_complaint_document['count']"/>
                </t>
                <div class="clearing"/>
            </t>
        </xpath>
    </template>
    <!-- document -->

    <!-- breadcrumb -->
    <template id="student_complaint_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">

            <li t-if="page_name=='Complaints'" t-attf-class="breadcrumb-item">
                <a t-att-href="page_url">Complaints
                </a>
            </li>

            <li t-if="page_name=='Complaint Show'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Complaints
                </a>
                <span>/</span>
                <a t-att-href="page_url">
                    <t t-esc="record.name_get()[0][1]"/>
                </a>
            </li>


            <li t-if="page_name=='Complaint Create'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Complaints
                </a>
                <span>/</span>
                <a t-att-href="page_url">Create
                </a>
            </li>

            <li t-if="page_name=='Complaint Update'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Complaints
                </a>
                <span>/</span>
                <a t-att-href="show_url">
                    <t t-esc="record.name_get()[0][1]"/>
                </a>
                <span>/</span>
                <a t-att-href="page_url">
                    Update
                </a>
            </li>


        </xpath>
    </template>
    <!-- breadcrumb -->


    <!-- list -->
    <template id="student_complaint" name="Complaints">

        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
            </t>

            <div class="card dynamic-website-card-holder">
                <div class="alert alert-success alert-dismissible fade show success-alert" role="alert"
                     t-if="success_message">
                    <i class="fa fa-check-circle"/>
                    <span t-esc="success_message"/>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <div class="card-body">
                    <a t-att-href="create_url">
                        <button class="btn btn-primary" t-if="not parent_student_param">
                            Create
                        </button>
                    </a>
                    <div class="dynamic-website-card" t-if="complaint_records">

                        <t t-call="portal.portal_table">
                            <table
                                    class="table mt-3"
                            >
                                <thead>
                                    <tr>


                                        <th scope="col">
                                            Category
                                        </th>

                                        <th scope="col">
                                            Subject
                                        </th>


                                        <th scope="col">
                                            Created at
                                        </th>

                                        <th scope="col">
                                            State
                                        </th>
                                        <th scope="col">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="complaint_records"
                                       t-as="complaint">
                                        <tr>


                                            <td>
                                                <span t-esc="complaint.category_id.name"/>
                                            </td>

                                            <td>
                                                <span t-esc="complaint.subject"/>
                                            </td>

                                            <td>
                                                <span t-esc="complaint.create_date" t-options="{'widget':'datetime'}"/>
                                            </td>


                                            <td>
                                                <t t-if="complaint.state == 'confirm'">
                                                    <span class="badge badge-pill bg-info"
                                                          t-out="'Sent'"/>
                                                </t>


                                                <t t-elif="complaint.state == 'action'">
                                                    <span class="badge badge-pill bg-success"
                                                          t-out="'Action taken'"/>
                                                </t>

                                                <t t-elif="complaint.state == 'reject'">
                                                    <span class="badge badge-pill bg-warning"
                                                          t-out="'Rejected'"/>
                                                </t>


                                            </td>

                                            <td class="website-actions-td">

                                                <t t-if="parent_student_param">

                                                    <t t-set="edit_url"
                                                       t-value="'/student/complaint/update/' + str(complaint.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                                    <t t-set="show_url"
                                                       t-value="'/student/complaint/' + str(complaint.id) + '?parent_student_param=' + str(parent_student_param)"/>

                                                    <t t-set="delete_url"
                                                       t-value="'/student/complaint/delete/' + str(complaint.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="edit_url"
                                                       t-value="'/student/complaint/update/' + str(complaint.id)"/>
                                                    <t t-set="show_url"
                                                       t-value="'/student/complaint/' + str(complaint.id)"/>
                                                    <t t-set="delete_url"
                                                       t-value="'/student/complaint/delete/' + str(complaint.id)"/>
                                                </t>


                                                <a t-att-href="show_url">
                                                    <button class="btn btn-outline-secondary btn-sm">
                                                        Show
                                                    </button>
                                                </a>
                                                <t t-if="complaint.state == 'confirm' and (not parent_student_param)">
                                                    <a
                                                            t-att-href="edit_url">
                                                        <button
                                                                class="btn btn-outline-secondary btn-sm">
                                                            Update
                                                        </button>
                                                    </a>

                                                    <a t-if="not parent_student_param"
                                                       t-att-href="delete_url" onclick="if(!confirm('Are you sure that you want to delete the record?'))return false">
                                                        <button type="button"
                                                                class="btn btn-outline-secondary btn-sm">
                                                            Delete
                                                        </button>
                                                    </a>
                                                </t>


                                            </td>


                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                    </div>
                    <t t-else="">

                        <div class=" mt-3 alert alert-info" role="alert">
                            There are no Complaints to display.
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>
    <!-- list -->

    <!-- show -->
    <template id="student_complaint_show" name="Complaint show">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content show-page">
                <div class="card-body row">
                    <div class="col-12"
                    >

                        <h5>Complaint full information
                        </h5>
                    </div>
                    <div class="col-12 col-md-6"
                    >

                        <strong>Category :</strong>
                        <span t-esc="record.category_id.name"/>


                    </div>

                    <div class="col-12 col-md-6"
                    >

                        <strong class="">Subject :</strong>
                        <span t-esc="record.subject"/>


                    </div>


                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Created at :</strong>
                        <span t-esc="record.create_date" t-options="{'widget':'datetime'}"/>
                    </div>
                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Sequence :</strong>
                        <span t-esc="record.sequence"/>
                    </div>
                    <div class="col-12 col-md-6"
                    >

                        <strong class="">State :</strong>

                        <t t-if="record.state == 'confirm'">
                            <span class="badge badge-pill bg-info"
                                  t-out="'Sent'"/>
                        </t>


                        <t t-elif="record.state == 'action'">
                            <span class="badge badge-pill bg-success"
                                  t-out="'Action Taken'"/>
                        </t>

                        <t t-elif="record.state == 'reject'">
                            <span class="badge badge-pill bg-warning"
                                  t-out="'Rejected'"/>
                        </t>

                    </div>


                    <div class="col-12 col-md-6" t-if="file_name"
                    >

                        <strong class="">Attachment :</strong>
                        <span t-esc="file_name"/>

                        <t t-if="parent_student_param">
                            <a
                                    t-attf-href="/student/complaint/download/#{record.id}?parent_student_param=#{parent_student_param}">
                                <i class="fa fa-download form-file-download-icon"
                                />
                            </a>
                        </t>
                        <t t-else="">
                            <a
                                    t-attf-href="/student/complaint/download/#{record.id}">
                                <i class="fa fa-download form-file-download-icon"
                                />
                            </a>
                        </t>


                    </div>

                    <div class=" col-12"
                    >
                        <strong>Description :</strong>
                        <span t-esc="record.description"/>

                    </div>
                    <div class=" col-12" t-if="record.state == 'action'"
                    >
                        <strong>Action to be take :</strong>
                        <span t-esc="record.action"/>

                    </div>


                </div>
            </div>
        </t>

    </template>
    <!-- show -->

    <!-- create -->
    <template id="student_complaint_create" name="Complaint create">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content">
                <div class="card-body">
                    <div class="alert alert-danger error-alert" role="alert" id="complaint_create_error"/>

                    <form action="/student/complaint/create" method="POST" class="row"
                          enctype='multipart/form-data' id="complaint_create_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="student_id" t-att-value="student_id" id="student_id"/>
                        <input type="hidden" name="parent_student_param" t-att-value="parent_student_param"
                               id="parent_student_param"/>
                        <div class=" col-12"
                        >
                            <span class="file-size-alert">Attachment size must be less than 2mb</span>
                            <h5>Create new complaint
                            </h5>
                        </div>


                        <div class=" col-12 col-md-6"
                        >
                            <label class="col-form-label" for="category">Category</label>
                            <span class="important-field-asterisk">*</span>
                            <select class="form-control"
                                    name="category_id"
                                    id="category_id"
                                    required="true"
                            >
                                <option value="">Select category</option>
                                <t t-foreach="categories" t-as="category">
                                    <option t-att-value="category.id"
                                    >
                                        <t t-esc="category.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="col-12 col-md-6"
                        >

                            <label class="col-form-label" for="start_date">Subject</label>
                            <span class="important-field-asterisk">*</span>
                            <input class="form-control"
                                   name="subject"
                                   id="subject"
                                   required="true"

                            />
                        </div>

                        <div class=" col-12 col-md-6 file-field-container"
                        >
                            <label class="col-form-label" for="create_complaint_file">Attachment</label>
                            <span class="clear-icon">Clear</span>
                            <input class="form-control"
                                   name="file"
                                   id="file"
                                   type="file"
                            />
                        </div>
                        <div class=" col-12 col-md-6"
                        >
                            <label class="col-form-label" for="description">Description</label>
                            <span class="important-field-asterisk">*</span>
                            <textarea class="form-control"
                                      name="description"
                                      id="description"
                                      required="true"
                            >
                                <t t-if="description" t-esc="description"/>
                            </textarea>


                        </div>

                        <div class="form-buttons-holder">
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>

    </template>
    <!-- create -->

    <!-- update -->
    <template id="student_complaint_update" name="Complaint update">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content">
                <div class="card-body">
                    <div class="alert alert-danger error-alert" role="alert" id="complaint_update_error"/>

                    <form action="/student/complaint/update" method="POST" class="row"
                          enctype='multipart/form-data' id="complaint_update_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="student_id" t-att-value="student_id" id="student_id"/>
                        <input type="hidden" name="parent_student_param" t-att-value="parent_student_param"
                               id="parent_student_param"/>
                        <input type="hidden" name="id" t-att-value="record.id" id="record_id"/>
                        <div class=" col-12"
                        >
                            <span class="file-size-alert">Attachment size must be less than 2mb</span>
                            <h5>Update complaint data
                            </h5>
                        </div>

                        <div class="col-12 col-md-6"
                        >

                            <label class="col-form-label" for="start_date">Subject</label>
                            <span class="important-field-asterisk">*</span>
                            <input class="form-control"
                                   name="subject"
                                   id="subject"
                                   required="true"
                                   t-att-value="record.subject"

                            />
                        </div>

                        <div class=" col-12 col-md-6"
                        >
                            <label class="col-form-label" for="category">Category</label>
                            <span class="important-field-asterisk">*</span>
                            <select class="form-control"
                                    name="category_id"
                                    id="category_id"
                                    required="true"
                            >
                                <option value="">Select category</option>
                                <t t-foreach="categories" t-as="category">
                                    <option t-att-value="category.id"
                                            t-att-selected="category.id == record.category_id.id"
                                    >
                                        <t t-esc="category.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>


                        <div class="col-12 col-md-6"
                        >
                            <label class="col-form-label" for="description">Description</label>
                            <span class="important-field-asterisk">*</span>
                            <textarea class="form-control"
                                      name="description"
                                      id="description"
                                      required="true"
                            >
                                <t t-esc="record.description"/>
                            </textarea>


                        </div>

                        <div t-if="file_name" class=" col-12 col-md-6 file-field-container update-file-holder"
                        >
                            <label class="col-form-label" for="file">Attachment</label>
                            <span>
                                :
                                <t t-esc="file_name"/>

                                <t t-if="parent_student_param">
                                    <a
                                            t-attf-href="/student/complaint/download/#{record.id}?parent_student_param=#{parent_student_param}">
                                        <i class="fa fa-download update-form-file-download-icon "
                                        />
                                    </a>
                                </t>
                                <t t-else="">
                                    <a
                                            t-attf-href="/student/complaint/download/#{record.id}">
                                        <i class="fa fa-download update-form-file-download-icon "
                                        />
                                    </a>
                                </t>


                                <span class="btn btn-outline-info btn-sm ml-2 file-update-trigger">
                                    Change
                                </span>
                            </span>
                            <span t-attf-class="clear-icon #{'hidden-file' if file_name else ''}">Clear</span>
                            <input
                                    name="file"
                                    id="file"
                                    type="file"
                                    t-attf-class="form-control #{'hidden-file' if file_name else ''}"
                            />
                        </div>
                        <div t-else="" class="col-12 col-md-6 file-field-container"
                        >

                            <label class="col-form-label" for="update_complaint_file">Attachment</label>
                            <span t-if="file_name">
                                :
                                <t t-esc="file_name"/>

                                <t t-if="parent_student_param">
                                    <a
                                            t-attf-href="/student/complaint/download/#{record.id}?parent_student_param=#{parent_student_param}">
                                        <i class="fa fa-download update-form-file-download-icon "
                                        />
                                    </a>
                                </t>
                                <t t-else="">
                                    <a
                                            t-attf-href="/student/complaint/download/#{record.id}">
                                        <i class="fa fa-download update-form-file-download-icon "
                                        />
                                    </a>
                                </t>


                                <span class="btn btn-outline-info btn-sm ml-2 file-update-trigger">
                                    Change
                                </span>
                            </span>
                            <span t-attf-class="clear-icon #{'hidden-file' if file_name else ''}">Clear</span>
                            <input
                                    name="file"
                                    id="file"
                                    type="file"
                                    t-attf-class="form-control #{'hidden-file' if file_name else ''}"
                            />
                        </div>

                        <div class="form-buttons-holder">
                            <button type="submit" class="btn btn-primary">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
    <!-- update -->


</odoo>