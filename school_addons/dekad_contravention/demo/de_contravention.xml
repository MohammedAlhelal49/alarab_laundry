<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="de_contravention_category_1" model="de.contravention.category">
            <field name="name">Tampering with school properties</field>
            <field name="type">major</field>
        </record>

        <record id="de_contravention_category_2" model="de.contravention.category">
            <field name="name">Misbehaving with other students</field>
            <field name="type">major</field>
        </record>


        <record id="de_contravention_1" model="de.contravention">
            <field name="category_id" ref="de_contravention_category_1"/>
            <field name="grade_id" ref="dekad_core.de_grade_1"/>
            <field name="student_id" ref="dekad_core.de_student_1"/>
            <field name="priority">1</field>
        </record>

        <record id="de_contravention_2" model="de.contravention">
            <field name="category_id" ref="de_contravention_category_2"/>
            <field name="grade_id" ref="dekad_core.de_grade_2"/>
            <field name="student_id" ref="dekad_core.de_student_2"/>
            <field name="priority">2</field>
        </record>
        <function model="de.contravention" name="set_confirm" eval="[(ref('de_contravention_1'), ref('de_contravention_2'))]"/>

    </data>
</odoo>