<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="de_student_contravention_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <br></br>
                            <br></br>
                            <br></br>
                            <div class="text-center">
                                <h3>
                                    <strong>Student Contravention Details</strong>
                                </h3>
                            </div>
                            <br></br>
                            <div class="row mt24">
                                <div style=" margin-left:15px;">
                                    <b>Student Name:</b>
                                    <span t-esc="o.name"/>
                                </div>

                            </div>
                            <br/>
                            <table class="table table-bordered"  t-if="len(o.contravention_ids)">
                                <thead class="text-center"
                                       style="background-color:#eeeeee; font-size:14px; font-weight:600;">
                                    <th class="text-center">Grade</th>
                                    <th class="text-center">Category</th>
                                    <th class="text-center">Penalty</th>
                                    <th class="text-center">Suspend from</th>
                                    <th class="text-center">Suspend to</th>

                                </thead>
                                <tbody class="text-center"
                                       style="font-size:12px;border-top: 1px solid #dbdbdb !important;">
                                    <t t-foreach="o.contravention_ids" t-as="contravention">
                                        <tr>
                                            <td class="text-center">
                                                <span t-esc="contravention.grade_id.name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="contravention.category_id.name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="contravention.penalty_ids[0].penalty"
                                                      t-if="len(contravention.penalty_ids)"/>
                                            </td>

                                            <td class="text-center">
                                                <span t-if="len(contravention.suspend_ids)"
                                                      t-esc="contravention.suspend_ids[0].start_date"/>
                                            </td>

                                            <td class="text-center">
                                                <span t-if="len(contravention.suspend_ids)"
                                                      t-esc="contravention.suspend_ids[0].end_date"/>
                                            </td>

                                        </tr>
                                    </t>
                                    <tr>
                                        <td class="text-center">
                                            <b>Total contravention</b>
                                        </td>
                                        <td class="text-center">
                                            <b>
                                                <span t-esc="len(o.contravention_ids)"/>
                                            </b>
                                        </td>
                                    </tr>
                                </tbody>

                            </table>
                                 <div t-else="" class="alert alert-secondary" role="alert">
                                    There is no contraventions to display
                                </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="act_open_de_student_contravention_report_view" model="ir.actions.report">
            <field name="name">Student contraventions</field>
            <field name="model">de.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dekad_contravention.de_student_contravention_report</field>
            <field name="report_file">dekad_contravention.de_student_contravention_report</field>
            <field name="print_report_name">'Student contravention - %s' % (object.name)</field>
            <field name="binding_model_id" ref="dekad_core.model_de_student"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">form</field>
        </record>

    </data>
</odoo>
