<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_contravention_category_list" model="ir.ui.view">
            <field name="name">de.contravention.category.list</field>
            <field name="model">de.contravention.category</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="contravention category" editable = "bottom">
                    <field name="name"/>
                    <field name="type"/>
                </list>
            </field>
        </record>

        <record id="view_de_contravention_category_search" model="ir.ui.view">
            <field name="name">de.contravention.category.search</field>
            <field name="model">de.contravention.category</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="contravention category">
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record model="ir.actions.act_window" id="act_open_de_contravention_category_view">
            <field name="name">Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.contravention.category</field>
            <field name="view_mode">list</field>
            <field name="binding_view_types">list,form</field>
            <field name="search_view_id" ref="view_de_contravention_category_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_contravention_category_view_list">
            <field name="act_window_id" ref="act_open_de_contravention_category_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_contravention_category_list"/>
        </record>
    </data>
</odoo>