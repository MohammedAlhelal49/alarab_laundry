<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_student_penalty_list" model="ir.ui.view">
            <field name="name">de.student.penalty.list</field>
            <field name="model">de.student.penalty</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Student penalty"  create="0" edit="0" delete="0">
                    <field name="contravention_id"/>
                    <field name="student_id"/>
                    <field name="penalty"/>
                </list>
            </field>
        </record>

        <record id="view_de_student_penalty_form" model="ir.ui.view">
            <field name="name">de.student.penalty.form</field>
            <field name="model">de.student.penalty</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="contravention student penalty"  create="0"  duplicate = "0" delete="0">
                    <header/>
                    <sheet>
                        <group>
                            <field name="contravention_id" readonly="1"/>
                            <field name="student_id" readonly="1"/>
                            <field name="penalty"/>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="view_de_student_penalty_search" model="ir.ui.view">
            <field name="name">de.student.penalty.search</field>
            <field name="model">de.student.penalty</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="contravention student penalty">
                    <field name="student_id"/>
                    <field name="penalty"/>
                    <group string="Group By...">
                        <filter name="group_by_student"
                                string="Student" domain="[]"
                                context="{'group_by':'student_id'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record model="ir.actions.act_window" id="act_open_de_student_penalty_view">
            <field name="name">Students Penalties</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.student.penalty</field>
            <field name="view_mode">list,form</field>
            <field name="binding_view_types">list,form</field>
            <field name="search_view_id" ref="view_de_student_penalty_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_student_penalty_view_list">
            <field name="act_window_id" ref="act_open_de_student_penalty_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_student_penalty_list"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_student_penalty_view_form">
            <field name="act_window_id" ref="act_open_de_student_penalty_view"/>
            <field name="view_mode">form</field>
            <field name="sequence" eval="20"/>
            <field name="view_id" ref="view_de_student_penalty_form"/>
        </record>

    </data>
</odoo>
