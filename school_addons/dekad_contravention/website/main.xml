    <!-- document -->

    <!-- breadcrumb -->
    <template id="student_contravention_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name=='Contraventions'" t-attf-class="breadcrumb-item">
                <a t-att-href="page_url">Contraventions
                </a>
            </li>
            <li t-if="page_name=='Contravention show'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Contraventions
                </a>
                <span>/</span>
                <a t-att-href="page_url">
                    <t t-esc="record.name_get()[0][1]"/>
                </a>
            </li>
        </xpath>
    </template>
    <!-- breadcrumb -->

    <!-- list -->
    <template id="student_contravention" name="Student contraventions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
            </t>

            <div class="card dynamic-website-card-holder">

                <div class="card-body dynamic-website-card">
                    <t t-if="contravention_records" t-call="portal.portal_table">
                        <table
                                class="table"
                        >
                            <thead>
                                <tr>
                                    <th scope="col">
                                        Category
                                    </th>

                                    <th scope="col">
                                        Priority
                                    </th>

                                    <th scope="col">
                                        Created at
                                    </th>


                                    <th scope="col">
                                        Status
                                    </th>

                                    <th scope="col">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="contravention_records"
                                   t-as="contravention">
                                    <tr>

                                        <td>
                                            <span t-esc="contravention.category_id.name"/>
                                        </td>

                                        <td>
                                            <span t-if="contravention.priority == '0'" t-esc="'Very low'"/>
                                            <span t-if="contravention.priority == '1'" t-esc="'Low'"/>
                                            <span t-if="contravention.priority == '2'" t-esc="'High'"/>
                                        </td>


                                        <td>
                                            <span t-esc="contravention.create_date" t-options="{'widget':'datetime'}"/>
                                        </td>


                                        <td>
                                            <t t-if="contravention.state == 'action'">
                                                <span class="badge badge-pill bg-success"
                                                      t-out="'Action taken'"/>
                                            </t>
                                            <t t-else="">
                                                <span class="badge badge-pill bg-info"
                                                      t-out="'Confirmed'"/>
                                            </t>
                                        </td>


                                        <td>

                                            <t t-if="parent_student_param">
                                                <t t-set="show_url"
                                                   t-value="'/student/contravention/' + str(contravention.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="show_url"
                                                   t-value="'/student/contravention/' + str(contravention.id)"/>
                                            </t>


                                            <a
                                                    t-att-href="show_url">
                                                <button class="btn btn-outline-secondary btn-sm">
                                                    Show
                                                </button>
                                            </a>
                                        </td>


                                    </tr>
                                </t>
                            </tbody>
                        </table>


                    </t>
                    <t t-else="">
                        <div class="alert alert-info" role="alert">
                            There are no Contraventions to display.
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>
    <!-- list -->

    <!-- show -->
    <template id="student_contravention_show" name="Contravention show">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content show-page">
                <div class="card-body row">
                    <div class="col-12"
                    >
                        <h5>Contravention full information
                        </h5>
                    </div>
                    <div class=" col-12 col-md-6"
                    >
                        <strong class="">Grade :</strong>
                        <span t-esc="record.grade_id.name"/>
                    </div>
                    <div class=" col-12 col-md-6"
                    >
                        <strong class="">Category :</strong>
                        <span t-esc="record.category_id.name"/>

                    </div>

                    <div class=" col-12 col-md-6"
                    >
                        <strong class="">Priority :</strong>
                        <span t-if="record.priority == '0'" t-esc="'Very low'"/>
                        <span t-if="record.priority == '1'" t-esc="'Low'"/>
                        <span t-if="record.priority == '2'" t-esc="'High'"/>
                    </div>

                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Sequence :</strong>
                        <span t-esc="record.sequence"/>
                    </div>

                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Created at :</strong>
                        <span t-esc="record.create_date" t-options="{'widget':'datetime'}"/>
                    </div>

                    <div class="col-12 col-md-6" t-if="file_name"
                    >

                        <strong class="">Attachment :</strong>
                        <span t-esc="file_name"/>

                        <a
                                t-attf-href="/student/contravention/download/#{record.id}">
                            <i class="fa fa-download form-file-download-icon"
                            />
                        </a>


                    </div>


                    <div class=" col-12 col-md-6"
                    >

                        <strong class="">State :</strong>

                        <t t-if="record.state == 'confirm'">
                            <span class="badge badge-pill bg-info"
                                  t-out="'Confirmed'"/>
                        </t>


                        <t t-elif="record.state == 'action'">
                            <span class="badge badge-pill bg-warning"
                                  t-out="'Action Taken'"/>
                        </t>


                    </div>


                    <hr t-if = "record.is_alert or record.suspend_ids or record.penalty_ids" />

                    <div class=" col-12 col-md-6" t-if="record.is_alert"
                    >
                        <strong class="">Alert :</strong>
                        <span t-esc="record.alert"/>

                    </div>

                    <div class=" col-12 col-md-6" t-if="record.penalty_ids"
                    >
                        <strong class="">Penalty :</strong>
                        <span t-esc="record.penalty_ids[0].penalty"/>

                    </div>


                    <div class=" col-12 col-md-6" t-if="record.suspend_ids"
                    >
                        <strong class="">Suspend from :</strong>
                        <span t-esc="record.suspend_ids[0].start_date" t-options="{'widget':'date'}"/>

                    </div>

                    <div class=" col-12 col-md-6" t-if="record.suspend_ids"
                    >
                        <strong class="">Suspend to :</strong>
                        <span t-esc="record.suspend_ids[0].end_date" t-options="{'widget':'date'}"/>

                    </div>
                    <hr/>

                    <div class=" col-12"
                    >
                        <strong class="">Details :</strong>
                        <span t-esc="record.details"/>

                    </div>
                </div>
            </div>
        </t>

    </template>
    <!-- show -->

</odoo>
