<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- subjects of the grade 1 -->
        <record id="de_subject_1" model="de.subject">
            <field name="name">Mathmatics</field>
        </record>
        <record id="de_subject_2" model="de.subject">
            <field name="name">English</field>
        </record>
        <record id="de_subject_3" model="de.subject">
            <field name="name">Sport</field>
        </record>
        <!-- subjects of the grade 6 -->
        <record id="de_subject_4" model="de.subject">
            <field name="name">Mathmatics</field>
        </record>
        <record id="de_subject_5" model="de.subject">
            <field name="name">Chemistry</field>
        </record>
        <record id="de_subject_6" model="de.subject">
            <field name="name">Physics</field>
        </record>

        <record id="de_grade_1" model="de.grade">
            <field name="name">Grade 1</field>
            <field name="section">primary</field>
            <field name="subject_ids" eval="[(6, 0, [ref('de_subject_1'), ref('de_subject_2'), ref('de_subject_3')])]"/>
        </record>
        <record id="de_grade_2" model="de.grade">
            <field name="name">Grade 6</field>
            <field name="section">intermediate</field>
            <field name="subject_ids" eval="[(6, 0, [ref('de_subject_4'), ref('de_subject_5'), ref('de_subject_6')])]"/>
        </record>
    </data>
</odoo>