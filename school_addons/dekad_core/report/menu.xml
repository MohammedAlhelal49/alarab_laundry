            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dekad_core.teacher_idcard_report</field>
            <field name="report_file">dekad_core.teacher_idcard_report</field>
            <field name="print_report_name">'Teacher ID Carf - %s' %(object.name)</field>
            <field name="binding_model_id" ref="dekad_core.model_de_teacher"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>