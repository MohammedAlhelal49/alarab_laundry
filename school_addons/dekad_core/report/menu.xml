<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="act_open_de_student_idcard_report_view" model="ir.actions.report">
            <field name="name">Student ID Card</field>
            <field name="model">de.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dekad_core.student_idcard_report</field>
            <field name="report_file">dekad_core.student_idcard_report</field>
            <field name="print_report_name">'Student ID Carf - %s' %(object.name)</field>
            <field name="binding_model_id" ref="dekad_core.model_de_student"/>
            <field name="binding_type">report</field>
        </record>

        <record id="act_open_de_teacher_idcard_report_view" model="ir.actions.report">
            <field name="name">Teacher ID Card</field>
