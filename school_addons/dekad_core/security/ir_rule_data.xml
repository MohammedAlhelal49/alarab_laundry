<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--add the admin user-->
        <record id="module_category_school" model="ir.module.category">
            <field name="name">School</field>
            <field name="description">Manage school data</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_de_teacher" model="res.groups">
            <field name="name">Teacher user</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_de_back_office_admin" model="res.groups">
            <field name="name">Super admin</field>
            <field name="category_id" ref="base.module_category_administration_administration"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_system')) ,(4, ref('mail.group_mail_template_editor')),(3, ref('group_de_teacher')), (4, ref('base.group_erp_manager')) , (4, ref('base.user_root')) , (4,ref('base.group_allow_export'))]"/>
        </record>


        <!-- grades group -->
        <record id="group_de_grade" model="res.groups">
            <field name="name">Grades</field>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_school"/>
        </record>
        <!-- grades group -->

        <!-- students -->
        <record id="module_category_student" model="ir.module.category">
            <field name="name">Students</field>
            <field name="description">Manage Students data</field>
            <field name="sequence">30</field>

        </record>

        <record id="group_de_student" model="res.groups">
            <field name="name">Students</field>
            <field name="category_id" ref="module_category_student"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_erp_manager'))]"/>
            <field name="sequence">10</field>
        </record>

        <!-- students -->

        <!-- teachers and specialist -->
        <record id="group_de_teacher_manage" model="res.groups">
            <field name="name">Teachers</field>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_erp_manager'))]"/>
            <field name="sequence">50</field>
            <field name="category_id" ref="module_category_school"/>
        </record>


        <record model="ir.rule" id="teacher_de_teacher_rule">
            <field name="name">Teacher teacher rule</field>
            <field name="model_id" ref="model_de_teacher"/>
            <field name="groups"
                   eval="[(4, ref('group_de_teacher'))]"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
        </record>

        <record model="ir.rule" id="teacher_de_subject_rule">
            <field name="name">Teacher subject rule</field>
            <field name="model_id" ref="model_de_subject"/>
            <field name="groups"
                   eval="[(4, ref('group_de_teacher'))]"/>
            <field name="domain_force">[('teacher_ids.user_id','=',user.id)]</field>
        </record>

        <record model="ir.rule" id="teacher_de_grade_rule">
            <field name="name">Teacher grade rule</field>
            <field name="model_id" ref="model_de_grade"/>
            <field name="groups"
                   eval="[(4, ref('group_de_teacher'))]"/>
            <field name="domain_force">[('teacher_ids.user_id','=',user.id)]</field>
        </record>

        <record model="ir.rule" id="teacher_de_student_rule">
            <field name="name">Teacher student rule</field>
            <field name="model_id" ref="model_de_student"/>
            <field name="groups"
                   eval="[(4, ref('group_de_teacher'))]"/>
            <field name="domain_force">[('student_grade_ids.grade_id.teacher_ids.user_id','=',user.id)]</field>
        </record>
        <!-- teachers and specialist -->

        <!-- add the groups to the admin group-->
        <record id="group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_grade')),(4, ref('group_de_teacher_manage')),(4, ref('group_de_student'))]"/>
        </record>
        <!-- add the groups to the admin group-->


        <record model="ir.rule" id="portal_de_student_grade_rule">
            <field name="name">Portal student grade Rule</field>
            <field name="model_id" ref="model_de_student_grade"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>

            <field name="domain_force">['|',('student_id.user_id','=',user.id) , ('student_id.user_id', 'in'
                ,user.child_ids.ids) ]
            </field>

        </record>

        <record model="ir.rule" id="portal_de_student_rule">
            <field name="name">Portal student rule</field>
            <field name="model_id" ref="model_de_student"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[ '|' , ('user_id','=',user.id) , ('user_id', 'in', user.child_ids.ids)]
            </field>
        </record>

        <record model="ir.rule" id="portal_de_teacher_rule">
            <field name="name">Portal teacher rule</field>
            <field name="model_id" ref="dekad_core.model_de_teacher"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[(1 , '=' , 1)]
            </field>
        </record>

    </data>
</odoo>
