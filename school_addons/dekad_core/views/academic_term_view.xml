<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_de_academic_term_list" model="ir.ui.view">
            <field name="name">de.academic.term.list</field>
            <field name="model">de.academic.term</field>
            <field name="arch" type="xml">
                <list string="Academic Term">
                    <field name="academic_year_id"/>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </list>
            </field>
        </record>

        <record id="view_de_academic_term_form" model="ir.ui.view">
            <field name="name">de.academic.term.form</field>
            <field name="model">de.academic.term</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Academic Term" duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="academic_year_id"/>
                                <field name="name"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_academic_term_list_quick_create" model="ir.ui.view">
            <field name="name">de.academic.term.list.quick.create</field>
            <field name="model">de.academic.term</field>
            <field name='arch' type="xml">
                <list string="Academic term quick create">
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </list>
            </field>
        </record>

        <record id="view_de_academic_term_form_quick_create" model="ir.ui.view">
            <field name="name">de.academic.term.form.quick.create</field>
            <field name="model">de.academic.term</field>
            <field name='arch' type="xml">
                <form string="Academic term quick create" duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_academic_term_search" model="ir.ui.view">
            <field name="name">de.academic.term.search</field>
            <field name="model">de.academic.term</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Academic Term">
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <group string="Group by ...">
                        <filter name="academic_year" string="Academic Year"
                                domain="[]" context="{'group_by':'academic_year_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="act_open_de_academic_term_view" model="ir.actions.act_window">
            <field name="name">Academic terms</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.academic.term</field>
            <field name="view_mode">list,form</field>
            <field name="binding_view_types">list,form</field>
            <field name="search_view_id" ref="view_de_academic_term_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record id="act_open_de_academic_term_view_list" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_de_academic_term_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_academic_term_list"/>
        </record>

        <record id="act_open_de_academic_term_view_form" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_de_academic_term_view"/>
            <field name="view_mode">form</field>
            <field name="sequence" eval="20"/>
            <field name="view_id" ref="view_de_academic_term_form"/>
        </record>
    </data>
</odoo>