<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_de_academic_year_list" model="ir.ui.view">
            <field name="name">de.academic.year.list</field>
            <field name="model">de.academic.year</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Academic Year">
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </list>
            </field>
        </record>

        <record id="view_de_academic_year_form" model="ir.ui.view">
            <field name="name">de.academic.year.form</field>
            <field name="model">de.academic.year</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Academic Year" duplicate="0">
                    <header/>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <separator string="Academic terms"/>
                        <field name="academic_term_ids" context="{'tree_view_ref' : 'dekad_core.view_de_academic_term_tree_quick_create' ,
                                'form_view_ref' : 'dekad_core.view_de_academic_term_form_quick_create'
                                }"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_academic_year_search" model="ir.ui.view">
            <field name="name">de.academic.year.search</field>
            <field name="model">de.academic.year</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Academic Year">
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </search>
            </field>
        </record>

        <record id="act_open_de_academic_year_view" model="ir.actions.act_window">
            <field name="name">Academic Years</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.academic.year</field>
            <field name="view_mode">list,form</field>
            <field name="binding_view_types">list,form</field>
            <field name="search_view_id" ref="view_de_academic_year_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_academic_year_view_list">
            <field name="act_window_id" ref="act_open_de_academic_year_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_academic_year_list"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_academic_year_view_form">
            <field name="act_window_id" ref="act_open_de_academic_year_view"/>
            <field name="view_mode">form</field>
            <field name="sequence" eval="20"/>
            <field name="view_id" ref="view_de_academic_year_form"/>
        </record>
    </data>
</odoo>