<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_de_holiday_list" model="ir.ui.view">
            <field name="name">de.holiday.list</field>
            <field name="model">de.holiday</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Holiday">
                    <field name="name"/>
                    <field name="is_range"/>
                    <field name="date"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </list>
            </field>
        </record>

        <record id="view_de_holiday_form" model="ir.ui.view">
            <field name="name">de.holiday.form</field>
            <field name="model">de.holiday</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Holiday" duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="is_range"/>
                                <field name="date" invisible="is_range == True" required="is_range == False"/>
                                <field name="start_date" invisible="is_range == False" required="is_range == True"/>
                                <field name="end_date" invisible="is_range == False" required="is_range == True"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_de_holiday_search" model="ir.ui.view">
            <field name="name">de.holiday.search</field>
            <field name="model">de.holiday</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Holiday">
                    <field name="name"/>
                    <field name="is_range"/>
                    <field name="date"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </search>
            </field>
        </record>

        <record id="act_open_de_holiday_view" model="ir.actions.act_window">
            <field name="name">Holidays</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.holiday</field>
            <field name="view_mode">list,form</field>
            <field name="binding_view_types">tree,form</field>
            <field name="search_view_id" ref="view_de_holiday_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record id="act_open_de_holiday_view_list" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_de_holiday_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_holiday_list"/>
        </record>

        <record id="act_open_de_holiday_view_form" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_de_holiday_view"/>
            <field name="view_mode">form</field>
            <field name="sequence" eval="20"/>
            <field name="view_id" ref="view_de_holiday_form"/>
        </record>

    </data>
</odoo>