<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_de_specialist_list" model="ir.ui.view">
            <field name="name">de.specialist.list</field>
            <field name="model">de.specialist</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="specialist" editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_de_specialist_search" model="ir.ui.view">
            <field name="name">de.specialist.search</field>
            <field name="model">de.specialist</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="specialist">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_specialist_view">
            <field name="name">Teachers Specialists</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.specialist</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_de_specialist_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_specialist_view_list">
            <field name="act_window_id" ref="act_open_de_specialist_view"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_de_specialist_list"/>
        </record>
    </data>
</odoo>
