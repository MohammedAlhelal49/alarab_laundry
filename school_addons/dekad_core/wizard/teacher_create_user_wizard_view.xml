<odoo>
    <data>
        <record id="de_teacher_create_user_wizard_form" model="ir.ui.view">
            <field name="name">de.teacher.create.user.wizard.form</field>
            <field name="model">de.teacher.create.user.wizard</field>
            <field name="arch" type="xml">
                <form string="Create Users">
                    <p class="oe_grey">Create User for selected Teacher(s)</p>
                    <separator string="Teacher"/>

                    <field name="teacher_ids" widget="many2many_tags" readonly="1"/>
                    <footer>
                        <button string="Create User" name="create_user" type="object" default_focus="1"
                                class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="act_open_de_teacher_create_user_wizard_view" model="ir.actions.act_window">
            <field name="name">Create User</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.teacher.create.user.wizard</field>
            <field name="binding_view_types">list,form</field>
            <field name="binding_model_id" ref="model_de_teacher"/>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

         <record id="act_open_de_teacher_create_user_wizard_view_form" model="ir.actions.act_window.view">
              <field name="act_window_id" ref="act_open_de_teacher_create_user_wizard_view"/>
             <field name="sequence" eval="10"/>
             <field name="view_mode">form</field>
             <field name="view_id" ref="de_teacher_create_user_wizard_form"/>
         </record>
    </data>
</odoo>