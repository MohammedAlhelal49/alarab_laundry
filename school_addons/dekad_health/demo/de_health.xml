<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="de_health_1" model="de.health">
            <field name="height">140</field>
            <field name="weight">50</field>
            <field name="blood_group">A+</field>
            <field name="type">student</field>
            <field name="student_id" ref="dekad_core.de_student_1"/>
            <field name="major_disease" eval="True"/>
            <field name="major_disease_note">Has Anemia</field>
        </record>

        <record id="de_health_2" model="de.health">
            <field name="height">160</field>
            <field name="weight">66</field>
            <field name="blood_group">B+</field>
            <field name="type">student</field>
            <field name="student_id" ref="dekad_core.de_student_2"/>
        </record>

        <record id="de_health_3" model="de.health">
            <field name="height">180</field>
            <field name="weight">80</field>
            <field name="blood_group">A+</field>
            <field name="type">teacher</field>
            <field name="teacher_id" ref="dekad_core.de_teacher_1"/>
        </record>

        <record id="de_health_4" model="de.health">
            <field name="height">170</field>
            <field name="weight">77</field>
            <field name="blood_group">B+</field>
            <field name="type">teacher</field>
            <field name="teacher_id" ref="dekad_core.de_teacher_2"/>
            <field name="eye_glasses" eval="True"/>
            <field name="eye_glasses_note">Optical aberration</field>
        </record>


        <record id="de_health_checkup_1" model="de.health.checkup">
            <field name="name">Blood test</field>
            <field name="recommendation">Full Recommendation</field>
            <field name="type">student</field>
            <field name="student_id" ref="dekad_core.de_student_1"/>
        </record>


        <record id="de_health_checkup_2" model="de.health.checkup">
            <field name="name">Eyesight examination</field>
            <field name="recommendation">Full Recommendation</field>
            <field name="type">teacher</field>
            <field name="teacher_id" ref="dekad_core.de_teacher_2"/>
        </record>
    </data>
</odoo>