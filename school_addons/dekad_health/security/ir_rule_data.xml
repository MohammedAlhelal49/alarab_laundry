<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_de_health" model="res.groups">
            <field name="name">Health Data and medical checkups</field>
            <field name="category_id" ref="dekad_core.module_category_school"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
              <field name="sequence">100</field>
        </record>
        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_health'))]"/>
        </record>

        <record model="ir.rule" id="portal_de_student_health_checkup_rule">
            <field name="name">Portal health checkups Rule</field>
            <field name="model_id" ref="model_de_health_checkup"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|',('student_id.user_id','=',user.id) , ('student_id.user_id', 'in'
                ,user.child_ids.ids)]
            </field>
        </record>

    </data>
</odoo>
