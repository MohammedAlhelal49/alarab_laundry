<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="group_de_leave" model="res.groups">
            <field name="name">Leaves</field>
             <field name="category_id" ref="dekad_core.module_category_student"/>
                  <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
               <field name="sequence">30</field>
        </record>

        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_leave'))]"/>
        </record>

        <record model="ir.rule" id="portal_de_leave_rule">
            <field name="name">portal leave rule</field>
            <field name="model_id" ref="model_de_leave"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|' , ( 'student_id.user_id', '=' , user.id) , ( 'student_id.user_id', 'in' ,
                user.child_ids.ids) , ('state' , '!=' , 'draft')]
            </field>
        </record>
    </data>
</odoo>


