<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_leave_type_tree" model="ir.ui.view">
            <field name="name">de.leave.type.list</field>
            <field name="model">de.leave.type</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Types" editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="act_open_de_leave_type_view">
            <field name="name">Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.leave.type</field>
            <field name="view_mode">list</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        <record model="ir.actions.act_window.view" id="act_open_de_leave_type_tree">
            <field name="act_window_id" ref="act_open_de_leave_type_view"/>
            <field name="view_mode">list</field>
            <field name="sequence" eval="10"/>
            <field name="view_id" ref="view_de_leave_type_tree"/>
        </record>
    </data>
</odoo>
