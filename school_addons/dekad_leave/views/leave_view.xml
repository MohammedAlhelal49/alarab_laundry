<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_leave_tree" model="ir.ui.view">
            <field name="name">de.leave.list</field>
            <field name="model">de.leave</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="leave">
                    <field name="leave_type"/>
                    <field name="student_id"/>
                    <field name="start_date"/>

                    <field name="duration"/>
                    <field name="state"/>
                    <field name="end_date" optional="hide"/>
                    <field name="sequence" optional="hide"/>
                    <field name="create_date" widget="datetime" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_de_leave_form" model="ir.ui.view">
            <field name="name">de.leave.form</field>
            <field name="model">de.leave</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Student leave" duplicate="0">
                    <field name="state" invisible="1"/>
                    <field name="id" invisible="1"/>
                    <header invisible="id  == False">
                        <button name="set_confirm" invisible="state != 'draft'"
                                type="object" string="Confirm"
                                class="oe_highlight"/>
                        <button name="set_draft"
                                type="object" string="Draft" invisible="state != 'confirm'"
                        />

                        <button name="set_cancel" invisible="state not in  ('accept','reject',  'start' , 'finish')"
                                string="Cancel" type="object"/>
                        <button name="set_accept" class="oe_highlight"
                                invisible="state  != 'confirm'"
                                type="object"
                                string="Accept"/>
                        <button name="set_reject" class="oe_highlight"
                                invisible="state  != 'confirm'"
                                type="object"
                                string="Reject"/>
                        <field name="state" widget="statusbar"
                        />
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active  == True"/>
                        <group>
                            <group>

                                <field name="leave_type" readonly="state != 'draft'"/>
                                <field name="student_id" readonly="state != 'draft'"
                                       domain="[('student_grade_ids.state','=', 'running')]"
                                       options="{'no_create': True , 'no_open' : True}"/>
                                <field name="parent_id" readonly="state != 'draft'" invisible="parent_id == False"

                                       options="{'no_create': True , 'no_open' : True}"/>
                                <field name="sequence" readonly="1"/>
                                <field name="file_name" invisible="1"/>
                                <field name="file" filename="file_name" readonly="state != 'draft'"/>                               </group>
                            <group>
                                <field name="start_date" readonly="state != 'draft'"/>
                                <field name="end_date" readonly="state != 'draft'"/>
                                <field name="duration"/>
                                <field name="create_date" invisible="create_date == False"/>
                            </group>
                            <separator string="Description"/>
                            <field name="description" readonly="state != 'draft'"/>


                        </group>
                    </sheet>


                        <field name="message_ids" widget="mail_thread"/>

                </form>
            </field>
        </record>


        <record id="view_de_leave_search" model="ir.ui.view">
            <field name="name">de.leave.search</field>
            <field name="model">de.leave</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Leave">
                    <field name="student_id"/>
                    <field name="leave_type"/>
                    <field name="state"/>
                    <filter string="Start Today" name="filter_leave_today"
                            domain="[('start_date', '&gt;=', time.strftime('%%Y-%%m-%%d 00:00:00')),('start_date', '&lt;=', time.strftime('%%Y-%%m-%%d 23:59:59'))]"/>
                    <filter string="Start in current Week" name="filter_assigenment_week"
                            domain="[('start_date', '&gt;=', (context_today()+relativedelta(weeks=-1,days=1,weekday=0)).strftime('%Y-%m-%d 00:00:00')),
                                    ('start_date', '&lt;', (context_today()+relativedelta(weekday=6)).strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Start in current Month" name="filter_leave_month"
                            domain="[('start_date', '&lt;=', (datetime.date.today()+relativedelta(day=31)).strftime('%Y-%m-%d')),
                                    ('start_date', '&gt;=', (datetime.date.today()-relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                    <group expand="0" string="Group By...">
                        <filter string="Type" domain="[]" name="group_by_type"
                                context="{'group_by':'leave_type'}"/>
                        <filter string="Student" domain="[]" name="group_by_student"
                                context="{'group_by':'student_id'}"/>
                        <filter string="State" domain="[]" name="group_by_state"
                                context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="view_de_leave_calendar" model="ir.ui.view">
            <field name="name">de.leave.calendar</field>
            <field name="model">de.leave</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <calendar string="Student Leaves" date_start="start_date" mode="month"
                          color="student_id" date_stop="end_date" quick_create="0">
                    <field name="leave_type" filters="1"/>
                    <field name="duration"/>
                </calendar>
            </field>
        </record>

        <record model="ir.ui.view" id="view_de_leave_graph">
            <field name="name">de.leave.graph</field>
            <field name="model">de.leave</field>
            <field name="arch" type="xml">
                <graph string="Time off" type="bar" stacked="False">
                    <field name="leave_type"/>
                    <field name="state"/>
                </graph>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_leave_view">
            <field name="name">Leaves</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.leave</field>
            <field name="binding_view_types">list,form</field>
            <field name="view_mode">list,calendar,form,graph</field>
            <field name="search_view_id" ref="view_de_leave_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>


        <record model="ir.actions.act_window.view" id="act_open_de_leave_view_form">
            <field name="act_window_id" ref="act_open_de_leave_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_de_leave_form"/>
        </record>


        <record model="ir.actions.act_window.view" id="act_open_de_leave_view_graph">
            <field name="act_window_id" ref="act_open_de_leave_view"/>
            <field name="sequence" eval="30"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_de_leave_graph"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_leave_view_tree">
            <field name="act_window_id" ref="act_open_de_leave_view"/>
            <field name="sequence" eval="5"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_de_leave_tree"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_leave_view_calendar">
            <field name="act_window_id" ref="act_open_de_leave_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="view_de_leave_calendar"/>
        </record>
    </data>
</odoo>
