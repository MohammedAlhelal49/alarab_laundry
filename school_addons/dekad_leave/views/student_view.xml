<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_student_form_leave_inherited" model="ir.ui.view">
            <field name="name">view.de.student.form.leave.inherited</field>
            <field name="model">de.student</field>
            <field name="inherit_id" ref="dekad_core.view_de_student_form"/>
            <field name="priority" eval="3"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="btn oe_stat_button" groups="dekad_leave.group_de_leave"

                            type="object"
                            name="action_show_leave"
                            icon="fa-calendar">
                        <field string="Leave" name="leave_count" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
