    <!-- breadcrumb -->
    <template id="student_leave_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">

            <li t-if="page_name=='Leaves'" t-attf-class="breadcrumb-item">
                <a t-att-href="page_url">Days off
                </a>
            </li>

            <li t-if="page_name=='Leave Show'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Days off
                </a>
                <span>/</span>
                <a t-att-href="page_url">
                    <t t-esc="record.name_get()[0][1]"/>
                </a>
            </li>


            <li t-if="page_name=='Leave Create'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Days off
                </a>
                <span>/</span>
                <a t-att-href="page_url">Create
                </a>
            </li>

            <li t-if="page_name=='Leave Update'" t-attf-class="breadcrumb-item">
                <a t-att-href="list_url">Days off
                </a>
                <span>/</span>
                <a t-att-href="show_url">
                    <t t-esc="record.name_get()[0][1]"/>
                </a>
                <span>/</span>
                <a t-att-href="page_url">
                    Update
                </a>
            </li>
        </xpath>
    </template>
    <!-- breadcrumb -->


    <!-- list -->
    <template id="student_leave" name="Days off">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
            </t>

            <div class="card dynamic-website-card-holder">
                <div class="alert alert-success alert-dismissible fade show success-alert" role="alert"
                     t-if="success_message">
                    <i class="fa fa-check-circle"/>
                    <span t-esc="success_message"/>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <div class="card-body">
                    <a t-att-href="create_url">
                        <button class="btn btn-primary">
                            Create
                        </button>
                    </a>
                    <div class="dynamic-website-card" t-if="leave_records">

                        <t t-call="portal.portal_table">
                            <table
                                    class="table mt-3"
                            >
                                <thead>
                                    <tr>
                                        <th scope="col">
                                            Day off Type
                                        </th>

                                        <th scope="col">
                                            Start Date
                                        </th>

                                        <th scope="col">
                                            Duration
                                        </th>
                                        <th scope="col">
                                            State
                                        </th>
                                        <th scope="col">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="leave_records"
                                       t-as="leave">
                                        <tr>
                                            <td>
                                                <span t-esc="leave.leave_type.name"/>
                                            </td>

                                            <td>
                                                <span t-esc="leave.start_date" t-options="{'widget':'date'}"/>
                                            </td>


                                            <td>
                                                <span t-esc="leave.duration"/>
                                            </td>

                                            <td>
                                                <t t-if="leave.state == 'confirm'">
                                                    <span class="badge badge-pill bg-info"
                                                          t-out="'Sent'"/>
                                                </t>

                                                <t t-elif="leave.state == 'start'">
                                                    <span class="badge badge-pill bg-success"
                                                          t-out="'Started'"/>
                                                </t>

                                                <t t-elif="leave.state == 'finish'">
                                                    <span class="badge badge-pill bg-warning"
                                                          t-out="'Finished'"/>
                                                </t>

                                                <t t-elif="leave.state == 'accept'">
                                                    <span class="badge badge-pill bg-success"
                                                          t-out="'Accepted'"/>
                                                </t>

                                                <t t-elif="leave.state == 'reject'">
                                                    <span class="badge badge-pill bg-warning"
                                                          t-out="'Rejected'"/>
                                                </t>


                                            </td>

                                            <td class="website-actions-td">

                                                <t t-if="parent_student_param">

                                                    <t t-set="edit_url"
                                                       t-value="'/student/leave/update/' + str(leave.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                                    <t t-set="show_url"
                                                       t-value="'/student/leave/' + str(leave.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                                    <t t-set="delete_url"
                                                       t-value="'/student/leave/delete/' + str(leave.id) + '?parent_student_param=' + str(parent_student_param)"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="edit_url"
                                                       t-value="'/student/leave/update/' + str(leave.id)"/>
                                                    <t t-set="show_url"
                                                       t-value="'/student/leave/' + str(leave.id)"/>
                                                    <t t-set="delete_url"
                                                       t-value="'/student/leave/delete/' + str(leave.id)"/>
                                                </t>

                                                <a
                                                        t-att-href="show_url">
                                                    <button class="btn btn-outline-secondary btn-sm">
                                                        Show
                                                    </button>
                                                </a>
                                                <t t-if="leave.state == 'confirm'">

                                                    <a
                                                            t-att-href="edit_url">
                                                        <button
                                                                class="btn btn-outline-secondary btn-sm">
                                                            Update
                                                        </button>
                                                    </a>

                                                    <a
                                                            t-att-href="delete_url" onclick="if(!confirm('Are you sure that you want to delete the record?'))return false">
                                                        <button type="button"
                                                                class="btn btn-outline-secondary btn-sm">
                                                            Delete
                                                        </button>
                                                    </a>
                                                </t>

                                            </td>


                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                    </div>
                    <t t-else="">

                        <div class=" mt-3 alert alert-info" role="alert">
                            There are no days off to display.
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>
    <!-- list -->

    <!-- show -->
    <template id="student_leave_show" name="Day off show">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content show-page">
                <div class="card-body row">
                    <div class="col-12"
                    >
                        <h5>Day off full information
                        </h5>
                    </div>

                    <div class=" col-12 col-md-6"
                    >

                        <strong class="">Day off type :</strong>
                        <span t-esc="record.leave_type.name"/>


                    </div>


                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Start Date :</strong>
                        <span t-esc="record.start_date" t-options="{'widget':'date'}"/>
                    </div>

                    <div class=" col-12 col-md-6"
                    >

                        <strong class="">End Date :</strong>
                        <span t-esc="record.end_date" t-options="{'widget':'date'}"/>


                    </div>

                    <div class=" col-12 col-md-6"
                    >

                        <strong class="">Duration :</strong>
                        <span t-esc="record.duration"/>


                    </div>

                    <div class="col-12 col-md-6"
                    >
                        <strong class="">Sequence :</strong>
                        <span t-esc="record.sequence"/>
                    </div>


                    <div class=" col-12 col-md-6"
                    >

                        <strong class="">State :</strong>

                        <t t-if="record.state == 'confirm'">
                            <span class="badge badge-pill bg-info"
                                  t-out="'Sent'"/>
                        </t>

                        <t t-elif="record.state == 'start'">
                            <span class="badge badge-pill bg-success"
                                  t-out="'Started'"/>
                        </t>

                        <t t-elif="record.state == 'finish'">
                            <span class="badge badge-pill bg-warning"
                                  t-out="'Finished'"/>
                        </t>

                        <t t-elif="record.state == 'accept'">
                            <span class="badge badge-pill bg-success"
                                  t-out="'Accepted'"/>
                        </t>

                        <t t-elif="record.state == 'reject'">
                            <span class="badge badge-pill bg-warning"
                                  t-out="'Rejected'"/>
                        </t>


                    </div>


                    <div class=" col-12 col-md-6"
                    >

                        <strong class="">Created at :</strong>

                        <span t-esc="record.create_date" t-options="{'widget':'datetime'}"/>
                    </div>


                    <div class=" col-12 col-md-6" t-if="file_name"
                    >

                        <strong class="">Attachment :</strong>
                        <span t-esc="file_name"/>

                        <a
                                t-attf-href="/student/leave/download/#{record.id}">
                            <i class="fa fa-download form-file-download-icon"
                            />
                        </a>


                    </div>


                    <div class=" col-12"
                    >

                        <strong>Description :</strong>
                        <span t-esc="record.description"/>


                    </div>

                </div>
            </div>
        </t>

    </template>
    <!-- show -->

    <!-- create -->
    <template id="student_leave_create" name="Day off create">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content">
                <div class="card-body">
                    <div class="alert alert-danger error-alert" role="alert" id="leave_create_error"/>
                    <form action="/student/leave/create" method="POST" class="row"
                          enctype='multipart/form-data' id="leave_create_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="student_id" t-att-value="student_id" id="student_id"/>
                        <input type="hidden" name="parent_student_param" t-att-value="parent_student_param"
                               id="parent_student_param"/>
                        <div class=" col-12"
                        >
                            <span class="file-size-alert">Attachment size must be less than 2mb</span>
                            <h5>Create new Day off
                            </h5>


                        </div>
                        <div class=" col-12 col-md-6">
                        <label class="col-form-label" for="start_date">Start Date</label>
                        <span class="important-field-asterisk">*</span>
                        <input class="form-control"
                               name="start_date"
                               id="start_date"
                               required="true"
                               type="date"
                               autocomplete="off"
                        />
                    </div>

                                <div class=" col-12 col-md-6">
                                    <label class="col-form-label" for="end_date">End Date</label>
                                    <span class="important-field-asterisk">*</span>
                                    <input class="form-control"
                                           name="end_date"
                                           id="end_date"
                                           required="true"
                                           type="date"
                                           autocomplete="off"
                                    />
                                </div>

                        <div class=" col-12 col-md-6"
                        >
                            <label class="col-form-label" for="leave_type">Day off type</label>
                            <span class="important-field-asterisk">*</span>
                            <select class="form-control"
                                    name="leave_type"
                                    id="leave_type"
                                    required="true"
                            >
                                <option value="">Select Day off type</option>
                                <t t-foreach="leave_types" t-as="leave_type">
                                    <option t-att-value="leave_type.id"
                                    >
                                        <t t-esc="leave_type.name"/>

                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="  col-12 col-md-6 file-field-container"
                        >
                            <label class="col-form-label" for="file">Attachment</label>
                            <span class="clear-icon">Clear</span>
                            <input class="form-control"
                                   name="file"
                                   id="file"
                                   type="file"
                            />
                        </div>
                        <div class=" col-12"
                        >
                            <label class="col-form-label" for="description">Description</label>
                            <span class="important-field-asterisk">*</span>
                            <textarea class="form-control"
                                      name="description"
                                      id="description"
                                      required="true"
                            >
                                <t t-if="description" t-esc="description"/>
                            </textarea>


                        </div>

                        <div class="form-buttons-holder">
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>

    </template>
    <!-- create -->

    <!-- update -->
    <template id="student_leave_update" name="Day off update">
        <t t-call="portal.portal_layout">
            <div class="card portal-page-content">
                <div class="card-body">
                    <div class="alert alert-danger error-alert" role="alert" id="leave_update_error"/>

                    <form action="/student/leave/update" method="POST" class="row"
                          enctype='multipart/form-data' id="leave_update_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="student_id" t-att-value="student_id" id="student_id"/>
                        <input type="hidden" name="parent_student_param" t-att-value="parent_student_param"
                               id="parent_student_param"/>
                        <input type="hidden" name="id" t-att-value="record.id" id="record_id"/>
                        <div class=" col-12"
                        >
                            <span class="file-size-alert">Attachment size must be less than 2mb</span>
                            <h5>Update day off data
                            </h5>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="col-form-label" for="start_date">Start Date</label>
                            <span class="important-field-asterisk">*</span>
                            <input class="form-control"
                                   name="start_date"
                                   id="start_date"
                                   required="true"
                                   type="date"
                                   t-att-value="record.start_date"
                                   autocomplete="off"
                            />
                        </div>

                        <div class=" col-12 col-md-6">
                            <label class="col-form-label" for="end_date">End Date</label>
                            <span class="important-field-asterisk">*</span>
                            <input class="form-control"
                                   name="end_date"
                                   id="end_date"
                                   required="true"
                                   type="date"
                                   t-att-value="record.end_date"
                                   autocomplete="off"
                            />
                        </div>
                        <div class=" col-12 col-md-6"
                        >
                            <label class="col-form-label" for="leave_type">Day off type</label>
                            <span class="important-field-asterisk">*</span>
                            <select class="form-control"
                                    name="leave_type"
                                    id="leave_type"
                                    required="true"
                            >
                                <option value="">Select Day off type</option>
                                <t t-foreach="leave_types" t-as="leave_type">
                                    <option t-att-value="leave_type.id"
                                            t-att-selected="leave_type.id == record.leave_type.id"
                                    >
                                        <t t-esc="leave_type.name"/>


                                    </option>
                                </t>
                            </select>
                        </div>
                        <div t-if="file_name" class="col-12 col-md-6 file-field-container update-file-holder"
                        >
                            <label class="col-form-label" for="file">Attachment</label>
                            <span>
                                :
                                <t t-esc="file_name"/>

                                <a
                                        t-attf-href="/student/leave/download/#{record.id}">
                                    <i class="fa fa-download update-form-file-download-icon "
                                    />
                                </a>


                                <span class="btn btn-outline-info btn-sm ml-2 file-update-trigger">
                                    Change
                                </span>
                            </span>
                            <span t-attf-class="clear-icon #{'hidden-file' if file_name else ''}">Clear</span>
                            <input
                                    name="file"
                                    id="file"
                                    type="file"
                                    t-attf-class="form-control #{'hidden-file' if file_name else ''}"
                            />
                        </div>
                        <div t-else="" class="col-12 col-md-6  file-field-container"
                        >

                            <label class="col-form-label" for="file">Attachment</label>
                            <span t-if="file_name">
                                :
                                <t t-esc="file_name"/>

                                <a
                                        t-attf-href="/student/leave/download/#{record.id}">
                                    <i class="fa fa-download update-form-file-download-icon "
                                    />
                                </a>


                                <span class="btn btn-outline-info btn-sm ml-2 file-update-trigger">
                                    Change
                                </span>
                            </span>
                            <span t-attf-class="clear-icon #{'hidden-file' if file_name else ''}">Clear</span>
                            <input
                                    name="file"
                                    id="file"
                                    type="file"
                                    t-attf-class="form-control #{'hidden-file' if file_name else ''}"
                            />
                        </div>
                        <div class=" col-12"
                        >
                            <label class="col-form-label" for="description">Description</label>
                            <span class="important-field-asterisk">*</span>
                            <textarea class="form-control"
                                      name="description"
                                      id="description"
                                      required="true"
                            >
                                <t t-esc="record.description"/>
                            </textarea>


                        </div>
                        <div class="form-buttons-holder">
                            <button type="submit" class="btn btn-primary">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
    <!-- update -->


</odoo>
