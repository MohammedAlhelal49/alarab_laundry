<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_de_parent_relationship_list" model="ir.ui.view">
            <field name="name">parent.relationship.list</field>
            <field name="model">de.parent.relationship</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Parent relationship" editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="view_de_parent_relationship_search" model="ir.ui.view">
            <field name="name">parent.relationship.search</field>
            <field name="model">de.parent.relationship</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Parent relationship">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_parent_relationship_view">
            <field name="name">Relations with students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.parent.relationship</field>
            <field name="search_view_id" ref="view_de_parent_relationship_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_parent_relationship_view_list">
            <field name="act_window_id" ref="act_open_de_parent_relationship_view"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_de_parent_relationship_list"/>
        </record>

    </data>
</odoo>