<odoo>
    <data>
        <record id="de_parent_create_user_wizard_form" model="ir.ui.view">
            <field name="name">parent.create.user.wizard.form</field>
            <field name="model">de.parent.create.user.wizard</field>
            <field name="arch" type="xml">
                <form string="Create Users">
                    <p class="oe_grey">Create User for selected parent(s)</p>
                    <separator string="parents"/>
                    <field name="parent_ids" widget="many2many_tags" readonly="1"/>
                    <footer>
                        <button string="Create User" name="create_user" type="object" default_focus="1"
                                class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_parent_create_user_wizard_view">
            <field name="name">Create user</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.parent.create.user.wizard</field>
            <field name="binding_view_types">list,form</field>
            <field name="binding_model_id" ref="model_de_parent"/>
            <field name="view_mode">form,list</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_de_parent_create_user_wizard_view_form">
            <field name="act_window_id" ref="act_open_de_parent_create_user_wizard_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="de_parent_create_user_wizard_form"/>
        </record>

    </data>
</odoo>













