<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="group_de_quiz" model="res.groups">
            <field name="name">Quizzes</field>
            <field name="category_id" ref="dekad_core.module_category_student"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">60</field>
        </record>

        <record id="dekad_core.group_de_back_office_admin" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('group_de_quiz'))]"/>
        </record>

        <record model="ir.rule" id="teacher_de_quiz_question_group_rule">
            <field name="name">Teacher quiz question group rule</field>
            <field name="model_id" ref="model_de_quiz_question_group"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('create_uid' , '=' , user.id)]</field>
            <field name="perm_read" eval="False"/>
        </record>

        <record model="ir.rule" id="teacher_de_quiz_question_rule">
            <field name="name">Teacher quiz question rule</field>
            <field name="model_id" ref="model_de_quiz_question"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('create_uid' , '=' , user.id)]</field>
            <field name="perm_read" eval="False"/>
        </record>

        <record model="ir.rule" id="teacher_de_quiz_question_answer_rule">
            <field name="name">Teacher quiz question answer rule</field>
            <field name="model_id" ref="model_de_quiz_question_answer"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('create_uid' , '=' , user.id)]</field>
            <field name="perm_read" eval="False"/>
        </record>


