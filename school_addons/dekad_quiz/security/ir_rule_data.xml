        <record model="ir.rule" id="teacher_de_quiz_rule">
            <field name="name">Teacher quiz rule</field>
            <field name="model_id" ref="model_de_quiz"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('teacher_id.user_id' , '=' , user.id)]</field>
        </record>


        <record model="ir.rule" id="teacher_de_quiz_submission_rule">
            <field name="name">Teacher quiz submission rule</field>
            <field name="model_id" ref="model_de_quiz_submission"/>
            <field name="groups" eval="[(4, ref('dekad_core.group_de_teacher'))]"/>
            <field name="domain_force">[('quiz_id.teacher_id.user_id' , '=' , user.id)]</field>
        </record>

        <record model="ir.rule" id="portal_quiz_rule">
            <field name="name">Portal quiz rule</field>
            <field name="model_id" ref="model_de_quiz"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|',('student_ids.user_id','=',user.id) , ('student_ids.user_id', 'in'
                ,user.child_ids.ids) , ('state' , '!=' , 'draft')]
            </field>
        </record>

        <record model="ir.rule" id="portal_quiz_submission_rule">
            <field name="name">Portal quiz Submission Rule</field>
            <field name="model_id" ref="model_de_quiz_submission"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|',('student_id.user_id','=',user.id) , ('student_id.user_id', 'in'
                ,user.child_ids.ids), ('state' , '!=' , 'draft')]
            </field>
        </record>

        <record model="ir.rule" id="portal_quiz_submission_answer_rule">
            <field name="name">Portal quiz Submission answer Rule</field>
            <field name="model_id" ref="model_de_quiz_submission_answer"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|',('submission_id.student_id.user_id','=',user.id) ,
                ('submission_id.student_id.user_id', 'in'
                ,user.child_ids.ids)]
            </field>
        </record>
    </data>
