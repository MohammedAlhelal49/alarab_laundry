<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_de_quiz_list" model="ir.ui.view">
            <field name="name">de.quiz.list</field>
            <field name="model">de.quiz</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="quiz">
                    <field name="type_id" string="Type" optional="show"/>
                    <field name="name"/>
                    <field name="classroom_id"/>
                    <field name="subject_id"/>
                    <field name="correction_type"/>
                    <field name="submission_date"/>
                    <field name="mark" optional="hide"/>
                    <field name="student_ids" widget="many2many_tags" optional="hide"/>
                    <field name="teacher_id" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="state" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_de_quiz_form" model="ir.ui.view">
            <field name="name">de.quiz.form</field>
            <field name="model">de.quiz</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="quiz">
                    <field name="id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="classroom_student_ids" invisible="1"/>

                    <header groups="base.group_user" invisible="id == False">
                        <button name="set_confirm" invisible="state != 'draft'"
                                type="object" string="Confirm" class="oe_highlight"
                        />
                        <button name="set_draft" invisible="state != 'confirm'"
                                type="object" string="Draft"
                        />
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active == True"/>
                        <group>
                            <group string="Basic">
                                <field name="type_id" readonly="state != 'draft'"/>
                                <field name="name" invisible="name == ''"
                                />
                                <field name="grade_id" invisible="1"
                                />

                                <field name="classroom_id"
                                       readonly="state != 'draft'"
                                       options="{ 'no_create': True , 'no_open' : True}"/>

                                <field name="subject_id" domain="[('grade_id', '=', grade_id)]"
                                       readonly="state != 'draft'" invisible="classroom_id == False"

                                       options="{ 'no_create': True , 'no_open' : True}" required="1"/>


                            </group>
                            <group string="Correction">


                                <field name="teacher_id" invisible="teacher_id == False"
                                       options="{ 'no_create': True , 'no_open' : True}"/>
                                <field name="correction_type" readonly="state != 'draft'"/>
                                <field name="mark"/>

                            </group>


                            <group string="Timing">

                                <field
                                        style="width:50%;"
                                        name="hour_limit"

                                        readonly="state != 'draft'"
                                />
                                <field style="width:50%;"
                                       name="minute_limit"

                                       readonly="state != 'draft'"
                                />

                            </group>


                        </group>


                        <notebook>
                            <page name="additional_info" string="Additional info">
                                <group>
                                    <group>
                                        <field name="create_date"
                                               invisible="create_date == False"/>
                                        <field name="submission_date" readonly="state != 'draft'"/>

                                    </group>
                                    <group>
                                        <field name="file_name" invisible="1"/>
                                        <field name="file" filename="file_name" readonly="state != 'draft'"/>
                                        <field name="description" readonly="state != 'draft'"
                                        />
                                    </group>
                                </group>
                            </page>
                            <page name="students" string="Students" readonly="state != 'draft'"
                                  invisible="classroom_id == False">

                                <group>

                                    <field
                                            domain="[('id', 'in', classroom_student_ids),
                                   ('student_grade_ids.grade_id','=',grade_id) , ('student_grade_ids.state','=','running')
                                   ]"
                                            options="{ 'no_create': True , 'no_open' : True}"
                                            name="student_ids" widget="many2many_tags"
                                            readonly="state != 'draft'"
                                    />


                                </group>
                            </page>
                            <page name="questions_groups" string="Questions groups">
                                <field name="group_ids"
                                       options="{ 'no_create': True}"
                                       domain="[('type_id', '=', type_id)
                                   ]"
                                       readonly="state != 'draft'"

                                >
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                            <page name="questions" string="Questions">
                                <field name="question_ids"
                                       domain="[ '|', ('group_ids', '=', False), '&amp;', ('group_ids', '!=', False), ('group_ids', 'in', group_ids) ]"

                                       readonly="state != 'draft'"

                                >
                                    <list>
                                        <field name="name"/>
                                        <field name="type"/>
                                        <field name="mark"/>
                                    </list>
                                </field>
                            </page>

                            <page name="submissions" string="Submissions">
                                <field name="quiz_submission_ids"
                                       context="{
                                'form_view_ref' : 'dekad_quiz.view_de_quiz_submission_form_quick_create'
                                }"

                                >
                                    <list create="0">
                                        <field name="student_id"/>
                                        <field name="mark"/>
                                        <field name="state"/>
                                        <field name="create_date"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
<!--                    <div class="oe_chatter">-->
<!--                        <field name="message_ids" widget="mail_thread"/>-->
<!--                    </div>-->
                        <field name="message_ids" widget="mail_thread"/>
                </form>
            </field>
        </record>


        <record id="view_de_quiz_search" model="ir.ui.view">
            <field name="name">de.quiz.search</field>
            <field name="model">de.quiz</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="quiz">
                    <field name="type_id"/>
                    <field name="name"/>
                    <field name="classroom_id"/>
                    <field name="subject_id"/>
                    <field name="teacher_id"/>
                    <field name="mark"/>
                    <field name="state"/>
                    <filter string="Submission Today" name="filter_submission_today"
                            domain="[('submission_date', '&gt;=', time.strftime('%%Y-%%m-%%d 00:00:00')),('submission_date', '&lt;=', time.strftime('%%Y-%%m-%%d 23:59:59'))]"/>
                    <filter string="Submission after Week" name="filter_submission_week"
                            domain="[('submission_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                    ('submission_date', '&lt;', (context_today()+relativedelta(days=6)).strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                    <group string="Group By...">
                        <filter string="Grade" domain="[]" name="group_by_grade"
                                context="{'group_by':'grade_id'}"/>
                        <filter string="Classroom" domain="[]" name="group_by_classroom"
                                context="{'group_by':'classroom_id'}"/>
                        <filter string="Subject" domain="[]" name="group_by_subject"
                                context="{'group_by':'subject_id'}"/>
                        <filter string="Teacher" domain="[]" name="group_by_teacher"
                                context="{'group_by':'teacher_id'}"/>
                        <filter string="Type" domain="[]" name="group_by_type"
                                context="{'group_by':'type_id'}"/>
                        <filter string="Correction type" domain="[]" name="group_by_correction_type"
                                context="{'group_by':'correction_type'}"/>
                        <filter string="State" domain="[]" name="group_by_quiz_state"
                                context="{'group_by':'state'}"/>
                    </group>

                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_de_quiz_graph">
            <field name="name">de.quiz.graph</field>
            <field name="model">de.quiz</field>
            <field name="arch" type="xml">
                <graph string="quiz Graph View" type="bar">
                    <field name="classroom_id"/>
                    <field name="state"/>
                </graph>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_de_quiz_view">
            <field name="name">Quizzes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">de.quiz</field>
            <field name="view_mode">list,form,graph</field>
            <field name="binding_view_types">list,form</field>
            <field name="search_view_id" ref="view_de_quiz_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

