<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Portal users can read all periods and session slots (needed for timetable grid) -->
        <record id="de_period_portal_rule" model="ir.rule">
            <field name="name">Portal users can read all periods</field>
            <field name="model_id" ref="model_de_period"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="de_session_slot_portal_rule" model="ir.rule">
            <field name="name">Portal users can read all session slots</field>
            <field name="model_id" ref="model_de_session_slot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal users can read timetables (controller handles specific access control) -->
        <record id="de_timetable_portal_rule" model="ir.rule">
            <field name="name">Portal users can read timetables</field>
            <field name="model_id" ref="model_de_timetable"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal users can read timetable lines -->
        <record id="de_timetable_line_portal_rule" model="ir.rule">
            <field name="name">Portal users can read timetable lines</field>
            <field name="model_id" ref="model_de_timetable_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>