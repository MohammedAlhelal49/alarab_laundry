<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="view_list_de_period" model="ir.ui.view">
        <field name="name">de.period.list</field>
        <field name="model">de.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration"/>
                <field name="is_break" string="Break"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_form_de_period" model="ir.ui.view">
        <field name="name">de.period.form</field>
        <field name="model">de.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_break"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <label for="start_time" string="e.g., 11.5 = 11:30 AM"/>

                            <field name="end_time" widget="float_time"/>
                            <label for="end_time" string="e.g., 12.25 = 12:15 PM"/>

                            <field name="duration" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                        <strong>Time Format Help:</strong>
                        <ul>
                            <li>8.0 = 8:00 AM</li>
                            <li>8.5 = 8:30 AM</li>
                            <li>8.75 = 8:45 AM</li>
                            <li>11.25 = 11:15 AM</li>
                        </ul>
                        <strong>Break Period:</strong> Check "Is Break/Lunch" for non-teaching periods (no subject/teacher will be assigned)
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_de_period" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">de.period</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
<!--    <menuitem id="menu_de_period"-->
<!--              name="Periods"-->
<!--              parent="menu_timetable_app"-->
<!--              action="action_de_period"-->
<!--              sequence="15"/>-->
</odoo>