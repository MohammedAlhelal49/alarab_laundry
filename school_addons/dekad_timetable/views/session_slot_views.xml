<odoo>
    <record id="view_form_de_session_slot" model="ir.ui.view">
        <field name="name">de.session.slot.form</field>
        <field name="model">de.session.slot</field>
        <field name="arch" type="xml">
            <form string="Session Slot">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="day_of_week"/>
                            <field name="period_id"/>
                        </group>

                        <group string="Time">
                            <label for="period_start_time" string="Period Time"/>
                            <div class="o_row">
                                <field name="period_start_time" widget="float_time" readonly="1" class="oe_inline"/>
                                <span class="oe_inline"> - </span>
                                <field name="period_end_time" widget="float_time" readonly="1" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_list_de_session_slot" model="ir.ui.view">
        <field name="name">de.session.slot.list</field>
        <field name="model">de.session.slot</field>
        <field name="arch" type="xml">
            <list string="Session Slots" decoration-muted="is_break">
                <field name="day_of_week"/>
                <field name="period_id"/>
                <field name="period_start_time" widget="float_time"/>
                <field name="period_end_time" widget="float_time"/>
                <field name="is_break" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_de_session_slot" model="ir.actions.act_window">
        <field name="name">Session Slots</field>
        <field name="res_model">de.session.slot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_list_de_session_slot"/>
    </record>
</odoo>