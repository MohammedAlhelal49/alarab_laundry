<odoo>
  <data>
    <record id="inherit_weekly_timetable_tab" model="ir.ui.view">
      <field name="name">de.timetable.weekly.tab</field>
      <field name="model">de.timetable</field>
      <field name="inherit_id" ref="dekad_timetable.view_form_de_timetable"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='timetable_lines_page']" position="inside">
          <field name="line_ids">
            <list>
              <field name="session_slot_id"/>
              <field name="subject_id"/>
              <field name="teacher_id"/>
            </list>
          </field>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
