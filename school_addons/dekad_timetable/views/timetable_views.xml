<odoo>
  <data>
    <!-- Form View -->
    <record id="view_form_de_timetable" model="ir.ui.view">
      <field name="name">de.timetable.form</field>
      <field name="model">de.timetable</field>
      <field name="arch" type="xml">
        <form string="Timetable">
          <header>
            <button string="Print Timetable"
                    type="object"
                    name="print_timetable_report"
                    class="btn-primary"/>
          </header>
          <sheet>
            <group>
              <field name="name"/>
              <field name="academic_year_id"/>
              <field name="academic_term_id"/>
              <field name="grade_id"/>
              <field name="classroom_id"/>
            </group>
            <notebook>
              <page name="timetable_lines_page" string="Weekly Timetable"/>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

