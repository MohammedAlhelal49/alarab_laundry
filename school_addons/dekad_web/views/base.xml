        <template id="dekad_portal_my_home" name="Portal My Home " inherit_id="portal.portal_my_home">

            <!-- Method 2: Aggressive xpath replacement - Try these one by one -->

            <!-- Option 1: Replace portal category section -->
            <xpath expr="//div[@id='portal_common_category']" position="replace">
                <div id="portal_common_category" class="d-none">
                    <!-- Hidden default categories -->
                </div>
            </xpath>



            <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">

                <!-- STUDENT SECTION -->
                <div class="card mb-4" t-if="request.env.user.is_student">
                    <div class="card-body">
                        <div class="text-center mb-4">
                              <!-- Display student image if available -->
                                <t t-if="request.env.user.image_1920">
                                    <img t-attf-src="data:image/png;base64,{{request.env.user.image_1920.decode('utf-8')}}"
                                         alt="Student Avatar"
                                         class="rounded-circle"
                                         style="width: 40%; height: 40%; object-fit: cover;"/>
                                </t>
                                <t t-else="">
                                     <div class="rounded-circle bg-success d-inline-flex align-items-center justify-content-center text-white mb-3"
                                 style="width: 80px; height: 80px; font-size: 2rem;">
                                <i class="fa fa-graduation-cap"/>
                            </div>
                                </t>
                            <h4 class="mb-1" t-esc="request.env.user.name"/>
                            <p class="text-muted">Student Portal</p>
                        </div>

                        <hr class="mb-4"/>

                        <!-- Student Info -->
                        <div class="row">
                            <div class="col-md-6 mb-3" t-if="request.env.user.email">
                                <h6 class="text-uppercase small text-muted fw-bold">Email</h6>
                                <p class="mb-0">
                                    <a t-attf-href="mailto:{{request.env.user.email}}" class="text-decoration-none">
                                        <t t-esc="request.env.user.email"/>
                                    </a>
                                </p>
                            </div>
                            <div class="col-md-6 mb-3" t-if="request.env.user.phone">
                                <h6 class="text-uppercase small text-muted fw-bold">Phone</h6>
                                <p class="mb-0">
                                    <a t-attf-href="tel:{{request.env.user.phone}}" class="text-decoration-none">
                                        <t t-esc="request.env.user.phone"/>
                                    </a>
                                </p>
                            </div>
                        </div>

                        <!-- Student Quick Navigation -->
                        <div class="mt-4">
                            <h5 class="mb-3">Quick Access</h5>
                            <div class="list-group">
                                <!-- Profile -->
                                <a t-if="student_profile_document and student_profile_document.get('show')"
                                   t-att-href="student_profile_document.get('url')"
                                   class="list-group-item list-group-item-action d-flex align-items-center">
                                    <i class="fa fa-user text-primary me-3" style="width: 20px;"></i>
                                    <div>
                                        <div class="fw-medium">Profile</div>
                                        <small class="text-muted">View your profile information</small>
                                    </div>
                                </a>

                                <!-- Fees -->
                                <a t-if="student_fee_document and student_fee_document.get('show')"
