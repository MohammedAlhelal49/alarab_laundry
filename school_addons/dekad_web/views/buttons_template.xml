<?xml version="1.0"?>
<odoo>
    <!-- Reusable Student Page Buttons Template with Direct Translation Support -->
    <template id="student_page_buttons" name="Student Page Navigation Buttons">
        <div class="alert alert-info d-flex align-items-center mb-3" t-if="parent_student_param">
            <i class="fa fa-user me-2"></i>
            <span class="me-auto">
                <t t-if="page_type == 'submission'">
                    Viewing submission for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'submission_update'">
                    Updating submission for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'achievements'">
                    Viewing achievements for: <strong t-esc="student.name"/>
                </t>
                <t t-else="">
                    Viewing content for: <strong t-esc="student.name"/>
                </t>
            </span>
            <a t-attf-href="/my/home/#{parent_student_param}"
               class="btn btn-primary btn-sm">
                <i class="fa fa-home me-1"></i>
                Back to Student Dashboard
            </a>
        </div>
    </template>

    <!-- Extended Student Page Buttons with More Options -->
    <template id="student_page_buttons_extended" name="Extended Student Page Navigation">
        <div class="alert alert-info d-flex align-items-center mb-3" t-if="parent_student_param">
            <i class="fa fa-user me-2"></i>
            <span class="me-auto">
                <t t-if="page_type == 'assignments'">
                    Viewing assignments for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'assignment'">
                    Viewing assignment for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'activity'">
                    Viewing activity for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'attendance'">
                    Viewing attendance for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'complaint'">
                    Viewing complaint for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'contravention'">
                    Viewing contravention for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'health'">
                    Viewing health for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'leave'">
                    Viewing leave for: <strong t-esc="student.name"/>
                </t>
                <t t-elif="page_type == 'note'">
                    Viewing note for: <strong t-esc="student.name"/>
                </t>
                <t t-else="">
                    Viewing content for: <strong t-esc="student.name"/>
                </t>
            </span>
            <div class="btn-group" role="group">
                <a t-attf-href="/my/home/#{parent_student_param}"
                   class="btn btn-primary btn-sm">
                    <i class="fa fa-home me-1"></i>
                   Back to Student Dashboard
                </a>
                <a href="/my/students"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-users me-1"></i>
                    Back to My Children
                </a>
            </div>
        </div>
    </template>


    <!-- Add to Assignment List - Below Breadcrumb -->
    <template id="add_buttons_to_assignment_list" inherit_id="dekad_assignment.student_assignment">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="after">
            <t t-call="dekad_web.student_page_buttons_extended">
                <t t-set="page_type">assignments</t>
            </t>
        </xpath>
    </template>

