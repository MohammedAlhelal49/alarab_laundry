         URLs stay in English with /en prefix
         ============================================ -->

    <!-- ACTIVITIES -->
    <template id="student_activity_back" inherit_id="dekad_activity.student_activity">
        <xpath expr="//div[hasclass('card-body')]" position="inside">
            <t t-set="back_url" t-value="'/my/home'"/>
            <t t-call="dekad_web.student_back_button_single">
                <t t-set="back_text">Back to Dashboard</t>
            </t>
        </xpath>
    </template>

