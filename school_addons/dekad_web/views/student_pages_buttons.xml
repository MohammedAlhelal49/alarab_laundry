<?xml version="1.0"?>
<odoo>

    <!-- ============================================
         SMART BACK BUTTON TEMPLATES
         URLs forced to stay in English (not translated)
         Button text translates to Arabic
         ============================================ -->

    <!-- Template: Single Back Button -->
    <template id="student_back_button_single" name="Student Single Back Button">
        <div class="mt-3">
            <t t-set="base_url" t-value="'/en/my/home' if parent_student_param else '/my/home'"/>

            <t t-if="parent_student_param">
                <!-- For Parents: Add parent_student_param to URL -->
                <t t-if="'/my/home' in (back_url or '/my/home')">
                    <a t-attf-href="/en{{back_url or '/my/home'}}/{{parent_student_param}}"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-if="back_text">
                            <span t-out="back_text"/>
                        </t>
                        <t t-else="">
                            <span>Back to Dashboard</span>
                        </t>
                    </a>
                </t>
                <t t-else="">
                    <a t-attf-href="/en{{back_url or '/my/home'}}{{('/' + str(parent_student_param)) if back_url and back_url.endswith('s') else ('?parent_student_param=' + str(parent_student_param))}}"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-if="back_text">
                            <span t-out="back_text"/>
                        </t>
                        <t t-else="">
                            <span>Back to Dashboard</span>
                        </t>
                    </a>
                </t>
            </t>
            <t t-else="">
                <!-- For Students: Normal URL with /en prefix -->
                <a t-attf-href="/en{{back_url or '/my/home'}}" class="btn btn-outline-primary btn-sm">
                    <i class="fa fa-arrow-left me-1"></i>
                    <t t-if="back_text">
                        <span t-out="back_text"/>
                    </t>
                    <t t-else="">
                        <span>Back to Dashboard</span>
                    </t>
                </a>
            </t>
        </div>
    </template>

    <!-- Template: Double Back Buttons -->
    <template id="student_back_button_double" name="Student Double Back Buttons">
        <div class="col-12 mt-4">
            <div class="d-flex gap-2 flex-wrap">
                <t t-if="parent_student_param">
                    <!-- For Parents: Add parent_student_param to URLs with /en prefix -->
                    <a t-attf-href="/en{{back_list_url}}/{{parent_student_param}}"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-if="back_list_text">
                            <span t-out="back_list_text"/>
                        </t>
                        <t t-else="">
                            <span>Back to List</span>
                        </t>
                    </a>
                    <a t-attf-href="/en/my/home/{{parent_student_param}}"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        <span>Student Dashboard</span>
                    </a>
                </t>
                <t t-else="">
                    <!-- For Students: Normal URLs with /en prefix -->
                    <a t-attf-href="/en{{back_list_url}}" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-if="back_list_text">
                            <span t-out="back_list_text"/>
                        </t>
                        <t t-else="">
                            <span>Back to List</span>
                        </t>
                    </a>
                    <a href="/en/my/home" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        <span>Dashboard</span>
                    </a>
                </t>
            </div>
        </div>
    </template>

    <!-- Template: Triple Back Buttons -->
    <template id="student_back_button_triple" name="Student Triple Back Buttons">
        <div class="mt-3">
            <div class="d-flex gap-2 flex-wrap">
                <t t-if="parent_student_param">
                    <!-- For Parents: Add parent_student_param to URLs with /en prefix -->
                    <t t-if="'?' in (back_detail_url or '')">
                        <a t-attf-href="/en{{back_detail_url}}&amp;parent_student_param={{parent_student_param}}"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i>
                            <t t-if="back_detail_text">
                                <span t-out="back_detail_text"/>
                            </t>
                            <t t-else="">
                                <span>Back</span>
                            </t>
                        </a>
                    </t>
                    <t t-else="">
                        <a t-attf-href="/en{{back_detail_url}}?parent_student_param={{parent_student_param}}"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i>
                            <t t-if="back_detail_text">
                                <span t-out="back_detail_text"/>
                            </t>
                            <t t-else="">
                                <span>Back</span>
                            </t>
                        </a>
                    </t>
                    <a t-attf-href="/en{{back_list_url}}/{{parent_student_param}}"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-list me-1"></i>
                        <t t-if="back_list_text">
                            <span t-out="back_list_text"/>
                        </t>
                        <t t-else="">
                            <span>All Items</span>
                        </t>
                    </a>
                    <a t-attf-href="/en/my/home/{{parent_student_param}}"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        <span>Student Dashboard</span>
                    </a>
                </t>
                <t t-else="">
                    <!-- For Students: Normal URLs with /en prefix -->
                    <a t-attf-href="/en{{back_detail_url}}" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-if="back_detail_text">
                            <span t-out="back_detail_text"/>
                        </t>
                        <t t-else="">
                            <span>Back</span>
                        </t>
                    </a>
                    <a t-attf-href="/en{{back_list_url}}" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-list me-1"></i>
                        <t t-if="back_list_text">
                            <span t-out="back_list_text"/>
                        </t>
                        <t t-else="">
                            <span>All Items</span>
                        </t>
                    </a>
                    <a href="/en/my/home" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        <span>Dashboard</span>
                    </a>
                </t>
            </div>
        </div>
    </template>


