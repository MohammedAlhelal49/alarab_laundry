<?xml version="1.0"?>
<odoo>


    <!-- Template: Single Back Button -->
    <template id="student_back_button_single" name="Student Single Back Button">
        <div class="mt-3">
            <t t-if="parent_student_param">
                <!-- For Parents: Add parent_student_param to URL -->
                <t t-if="'/my/home' in (back_url or '/my/home')">
                    <a t-attf-href="{{back_url or '/my/home'}}/{{parent_student_param}}"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-esc="back_text or 'Back to Dashboard'"/>
                    </a>
                </t>
                <t t-else="">
                    <a t-attf-href="{{back_url or '/my/home'}}{{('/' + str(parent_student_param)) if back_url and back_url.endswith('s') else ('?parent_student_param=' + str(parent_student_param))}}"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-esc="back_text or 'Back to Dashboard'"/>
                    </a>
                </t>
            </t>
            <t t-else="">
                <!-- For Students: Normal URL -->
                <a t-att-href="back_url or '/my/home'" class="btn btn-outline-primary btn-sm">
                    <i class="fa fa-arrow-left me-1"></i>
                    <t t-esc="back_text or 'Back to Dashboard'"/>
                </a>
            </t>
        </div>
    </template>

    <!-- Template: Double Back Buttons (Back to List + Dashboard) -->
    <template id="student_back_button_double" name="Student Double Back Buttons">
        <div class="col-12 mt-4">
            <div class="d-flex gap-2 flex-wrap">
                <t t-if="parent_student_param">
                    <!-- For Parents: Add parent_student_param to URLs -->
                    <a t-attf-href="{{back_list_url}}/{{parent_student_param}}"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-esc="back_list_text or 'Back to List'"/>
                    </a>
                    <a t-attf-href="/my/home/{{parent_student_param}}"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        Student Dashboard
                    </a>
                </t>
                <t t-else="">
                    <!-- For Students: Normal URLs -->
                    <a t-att-href="back_list_url" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-esc="back_list_text or 'Back to List'"/>
                    </a>
                    <a href="/my/home" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        Dashboard
                    </a>
                </t>
            </div>
        </div>
    </template>

    <!-- Template: Triple Back Buttons (for submission/nested pages) -->
    <template id="student_back_button_triple" name="Student Triple Back Buttons">
        <div class="mt-3">
            <div class="d-flex gap-2 flex-wrap">
                <t t-if="parent_student_param">
                    <!-- For Parents: Add parent_student_param to URLs -->
                    <t t-if="'?' in (back_detail_url or '')">
                        <a t-attf-href="{{back_detail_url}}&amp;parent_student_param={{parent_student_param}}"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i>
                            <t t-esc="back_detail_text or 'Back'"/>
                        </a>
                    </t>
                    <t t-else="">
                        <a t-attf-href="{{back_detail_url}}?parent_student_param={{parent_student_param}}"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i>
                            <t t-esc="back_detail_text or 'Back'"/>
                        </a>
                    </t>
                    <a t-attf-href="{{back_list_url}}/{{parent_student_param}}"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-list me-1"></i>
                        <t t-esc="back_list_text or 'All Items'"/>
                    </a>
                    <a t-attf-href="/my/home/{{parent_student_param}}"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        Student Dashboard
                    </a>
                </t>
                <t t-else="">
                    <!-- For Students: Normal URLs -->
                    <a t-att-href="back_detail_url" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-arrow-left me-1"></i>
                        <t t-esc="back_detail_text or 'Back'"/>
                    </a>
                    <a t-att-href="back_list_url" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-list me-1"></i>
                        <t t-esc="back_list_text or 'All Items'"/>
                    </a>
                    <a href="/my/home" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        Dashboard
                    </a>
                </t>
            </div>
        </div>
    </template>


