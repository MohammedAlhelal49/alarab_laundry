         ============================================ -->

    <!-- Activity List -->
    <template id="student_activity_back" inherit_id="dekad_activity.student_activity">
        <xpath expr="//div[hasclass('card-body')]" position="inside">
            <t t-set="parent_student_param" t-value="parent_student_param"/>
            <t t-set="back_url" t-value="'/my/home'"/>
            <t t-set="back_text" t-value="'Back to Dashboard'"/>
            <t t-call="dekad_web.student_back_button_single"/>
        </xpath>
    </template>

    <!-- Activity Show -->
    <template id="student_activity_show_back" inherit_id="dekad_activity.student_activity_show">
