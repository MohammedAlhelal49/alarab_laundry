<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Access Groups for Weekly Planner -->
        <record id="group_weekly_planner_user" model="res.groups">
            <field name="name">Weekly Planner User</field>
            <field name="category_id" ref="dekad_core.module_category_school"/>
            <field name="comment">Teachers can view and edit their own weekly planners</field>
        </record>

        <record id="group_weekly_planner_manager" model="res.groups">
            <field name="name">Weekly Planner Manager</field>
            <field name="category_id" ref="dekad_core.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('group_weekly_planner_user'))]"/>
            <field name="comment">Managers can view and manage all weekly planners</field>
        </record>

        <!-- Add Weekly Planner User to existing Teacher group -->
        <record id="dekad_core.group_de_teacher" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_weekly_planner_user'))]"/>
        </record>

        <!-- Add Weekly Planner Manager to existing Teacher Manager group -->
        <record id="dekad_core.group_de_teacher_manage" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_weekly_planner_manager'))]"/>
        </record>

        <!-- Record Rules for Teachers (own records only) -->
        <record id="teacher_weekly_planner_teacher_rule" model="ir.rule">
            <field name="name">Teacher: Own Weekly Planners</field>
            <field name="model_id" ref="model_teacher_weekly_planner"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_weekly_planner_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="teacher_weekly_planner_line_teacher_rule" model="ir.rule">
            <field name="name">Teacher: Own Weekly Planner Lines</field>
            <field name="model_id" ref="model_teacher_weekly_planner_line"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_weekly_planner_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rules for Managers (all records) -->
        <record id="teacher_weekly_planner_manager_rule" model="ir.rule">
            <field name="name">Manager: All Weekly Planners</field>
            <field name="model_id" ref="model_teacher_weekly_planner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_weekly_planner_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="teacher_weekly_planner_line_manager_rule" model="ir.rule">
            <field name="name">Manager: All Weekly Planner Lines</field>
            <field name="model_id" ref="model_teacher_weekly_planner_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_weekly_planner_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Portal Access (Read Only) -->
        <record id="teacher_weekly_planner_portal_rule" model="ir.rule">
            <field name="name">Portal: Read Own Teacher's Planner</field>
            <field name="model_id" ref="model_teacher_weekly_planner"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>