<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list View -->
    <record id="view_teacher_weekly_planner_list" model="ir.ui.view">
        <field name="name">teacher.weekly.planner.list</field>
        <field name="model">teacher.weekly.planner</field>
        <field name="arch" type="xml">
            <list string="Weekly Planners" decoration-info="state=='draft'"
                  decoration-success="state=='confirmed'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="week_start_date"/>
                <field name="week_end_date"/>
                <field name="week_number"/>
                <field name="line_count"/>
                <field name="lesson_hours" widget="float_time"/>
                <field name="total_hours" widget="float_time"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_teacher_weekly_planner_form" model="ir.ui.view">
        <field name="name">teacher.weekly.planner.form</field>
        <field name="model">teacher.weekly.planner</field>
        <field name="arch" type="xml">
            <form string="Weekly Planner">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'cancelled'"
                            confirm="Are you sure you want to cancel this planner?"/>
                    <button name="action_generate_default_week" string="Generate Default Week"
                            type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_weekly_schedule" string="Print Schedule"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Activities"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="teacher_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="week_start_date" readonly="state != 'draft'"/>
                            <field name="week_end_date"/>
                            <field name="week_number"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="lesson_hours" widget="float_time"/>
                            <field name="total_hours" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Planning" name="planning">
                            <field name="line_ids" context="{'default_planner_id': id}">
                                <list string="Activities" editable="bottom">
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="duration" widget="float_time" readonly="1"/>
                                    <field name="activity_type"/>
                                    <field name="subject_id"
                                           options="{'no_create': True}"
                                           column_invisible="parent.state != 'draft'"
                                           required="activity_type == 'lesson'"/>
                                    <field name="classroom_id"
                                           options="{'no_create': True}"
                                           required="activity_type == 'lesson'"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Statistics" name="statistics">
                            <group>
                                <group string="Summary">
                                    <field name="line_count"/>
                                    <field name="lesson_hours" widget="float_time"/>
                                    <field name="total_hours" widget="float_time"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add any additional notes here..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_teacher_weekly_planner_calendar" model="ir.ui.view">
        <field name="name">teacher.weekly.planner.calendar</field>
        <field name="model">teacher.weekly.planner</field>
        <field name="arch" type="xml">
            <calendar string="Weekly Planners" date_start="week_start_date"
                      date_stop="week_end_date" color="teacher_id" mode="week">
                <field name="teacher_id"/>
                <field name="name"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View - Updated for Odoo 18 -->
    <record id="view_teacher_weekly_planner_kanban" model="ir.ui.view">
        <field name="name">teacher.weekly.planner.kanban</field>
        <field name="model">teacher.weekly.planner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="week_start_date"/>
                <field name="week_end_date"/>
                <field name="state"/>
                <field name="lesson_hours"/>
                <field name="line_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="float-end badge rounded-pill"
                                      t-attf-class="badge-{{record.state.raw_value == 'confirmed' ? 'success' : record.state.raw_value == 'draft' ? 'info' : 'secondary'}}">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="teacher_id"/>
                                <br/>
                                <i class="fa fa-calendar" title="Week Period" aria-label="Week Period"/>
                                <field name="week_start_date"/> - <field name="week_end_date"/>
                                <br/>
                                <i class="fa fa-list" title="Activities Count" aria-label="Activities"/>
                                <field name="line_count"/> Activities |
                                <i class="fa fa-clock-o" title="Teaching Hours" aria-label="Teaching Hours"/>
                                <field name="lesson_hours" widget="float_time"/> Teaching Hours
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_teacher_weekly_planner_search" model="ir.ui.view">
        <field name="name">teacher.weekly.planner.search</field>
        <field name="model">teacher.weekly.planner</field>
        <field name="arch" type="xml">
            <search string="Search Weekly Planners">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="week_start_date"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Current Week" name="current_week"
                        domain="[('week_start_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 ('week_end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('week_start_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('week_start_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Week" name="group_week" context="{'group_by': 'week_start_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_teacher_weekly_planner" model="ir.actions.act_window">
        <field name="name">Weekly Planners</field>
        <field name="res_model">teacher.weekly.planner</field>
        <field name="view_mode">list,form,calendar,kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first weekly planner
            </p>
            <p>
                Plan your weekly activities including lessons, preparation time, meetings, and more.
            </p>
        </field>
    </record>

    <record id="action_teacher_weekly_planner_my" model="ir.actions.act_window">
        <field name="name">My Weekly Planner</field>
        <field name="res_model">teacher.weekly.planner</field>
        <field name="view_mode">list,form,calendar,kanban</field>
        <field name="domain">[('teacher_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your weekly planner
            </p>
            <p>
                Plan your weekly schedule with lessons, preparation time, and meetings.
            </p>
        </field>
    </record>

</odoo>