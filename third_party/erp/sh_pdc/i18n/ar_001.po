#. module: sh_pdc
#: model:mail.template,body_html:sh_pdc.sh_pdc_company_to_customer_notification_1
msgid ""
"<div style=\"line-height: 28px;\">\n"
"            Dear <b><t t-out=\"object.partner_id.name\"/></b>,<br/>\n"
"            This is a gentle remainder that your cheque reference no.<b><t t-out=\"object.reference\"/></b> due on <b><t t-out=\"object.due_date\"/></b>.<br/>\n"
"\t        <div>Thank you...</div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"line-height: 28px;\">\n"
"            عزيزي <b><t t-out=\"object.partner_id.name\"/></b>,<br/>\n"
"            هذه تذكير لطيف بأن الشيك رقم <b><t t-out=\"object.reference\"/></b> مستحق في <b><t t-out=\"object.due_date\"/></b>.<br/>\n"
"\t        <div>شكراً لك...</div>\n"
"            </div>\n"
"        "

#. module: sh_pdc
#: model:mail.template,body_html:sh_pdc.sh_pdc_company_to_int_user_notification_1
msgid ""
"<div style=\"line-height: 28px;\">\n"
"            Hello,<br/>\n"
"            <b><t t-out=\"object.partner_id.name\"/></b><b>'s</b> cheuqe reference no.<b><t t-out=\"object.reference\"/></b> due on <b><t t-out=\"object.due_date\"/></b>.<br/>\n"
"            <a class=\"btn btn-primary\" role=\"button\" t-att-href=\"'%s'%object.env.context.get('customer_url')\">View Cheque</a><br/>\n"
"            <div>Thank you...</div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"line-height: 28px;\">\n"
"            مرحباً,<br/>\n"
"            الشيك رقم <b><t t-out=\"object.reference\"/></b> الخاص بـ <b><t t-out=\"object.partner_id.name\"/></b> مستحق في <b><t t-out=\"object.due_date\"/></b>.<br/>\n"
"            <a class=\"btn btn-primary\" role=\"button\" t-att-href=\"'%s'%object.env.context.get('customer_url')\">عرض الشيك</a><br/>\n"
"            <div>شكراً لك...</div>\n"
"            </div>\n"
"        "

