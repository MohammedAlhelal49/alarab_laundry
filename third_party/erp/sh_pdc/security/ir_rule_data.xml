<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- PDC User: Only own records -->
        <record id="pdc_wizard_user_rule" model="ir.rule">
            <field name="name">PDC User - Own Records</field>
            <field name="model_id" ref="model_pdc_wizard"/>
            <field name="groups" eval="[(4, ref('sh_pdc.group_pdc_user'))]"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids), ('user_id', '=', user.id)]
            </field>
        </record>

        <!-- PDC Administrator: All records -->
        <record id="pdc_wizard_admin_rule" model="ir.rule">
            <field name="name">PDC Administrator - All Records</field>
            <field name="model_id" ref="model_pdc_wizard"/>
            <field name="groups" eval="[(4, ref('sh_pdc.group_pdc_admin'))]"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>