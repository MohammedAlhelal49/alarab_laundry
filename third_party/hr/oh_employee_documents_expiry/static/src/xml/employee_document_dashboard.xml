<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="oh_employee_documents_expiry.EmployeeDocumentListView"
       t-inherit="web.ListView"
       t-inherit-mode="primary">

        <xpath expr="//t[@t-component='props.Renderer']"
               position="before">

            <!--
                Show dashboard only when there is at least one document.
                If dashboard.total = 0, all three KPI cards are hidden.
            -->
            <t t-if="dashboard.total > 0">

                <div class="employee_document_dashboard">

                    <!-- ================================================== -->
                    <!-- All Documents                                      -->
                    <!-- ================================================== -->
                    <div class="employee_document_kpi total"
                         t-on-click="() => this.filterDocuments('all')">

                        <div class="employee_document_kpi_count">
                            <t t-esc="dashboard.total"/>
                        </div>

                        <div class="employee_document_kpi_label">
                            Documents
                        </div>

                    </div>

                    <!-- ================================================== -->
                    <!-- Near Expiration                                    -->
                    <!-- ================================================== -->
                    <div class="employee_document_kpi near_expiration"
                         t-on-click="() => this.filterDocuments('near_expiration')">

                        <div class="employee_document_kpi_count">
                            <t t-esc="dashboard.nearExpiration"/>
                        </div>

                        <div class="employee_document_kpi_label">
                            Near Expiration
                        </div>

                        <div class="employee_document_kpi_subtitle">
                            <t t-esc="nearExpirationLabel"/>
                        </div>

                        <!-- Duration selector -->
                        <div class="employee_document_duration_selector">

                            <button type="button"
                                    t-att-class="dashboard.nearExpirationDays === 15 ? 'active' : ''"
                                    t-on-click="(ev) => this.setNearExpirationDays(15, ev)">
                                15D
                            </button>

                            <button type="button"
                                    t-att-class="dashboard.nearExpirationDays === 30 ? 'active' : ''"
                                    t-on-click="(ev) => this.setNearExpirationDays(30, ev)">
                                1M
                            </button>

                            <button type="button"
                                    t-att-class="dashboard.nearExpirationDays === 90 ? 'active' : ''"
                                    t-on-click="(ev) => this.setNearExpirationDays(90, ev)">
                                3M
                            </button>

                            <button type="button"
                                    t-att-class="dashboard.nearExpirationDays === 180 ? 'active' : ''"
                                    t-on-click="(ev) => this.setNearExpirationDays(180, ev)">
                                6M
                            </button>

                        </div>

                    </div>


                    <!-- ================================================== -->
                    <!-- Expired                                            -->
                    <!-- ================================================== -->
                    <div class="employee_document_kpi expired"
                         t-on-click="() => this.filterDocuments('expired')">

                        <div class="employee_document_kpi_count">
                            <t t-esc="dashboard.expired"/>
                        </div>

                        <div class="employee_document_kpi_label">
                            Expired
                        </div>

                    </div>

                </div>

            </t>

        </xpath>

    </t>

</templates>