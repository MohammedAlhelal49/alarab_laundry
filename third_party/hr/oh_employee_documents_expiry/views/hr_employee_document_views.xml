<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--   Adding document details as smart button in employee.-->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.oh.employee.documents.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button class="oe_stat_button" name="action_document_view"
                        type="object" icon="fa-list-ol">
                    <field string="Documents" name="document_count"
                           widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
    <!--    Form view of hr_employee_document model-->
    <record id='hr_employee_document_view_form' model='ir.ui.view'>
        <field name="name">hr.employee.document.view.form</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_renew_document"
                        string="Renew"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'expired'"/>

                    <field name="state" widget="statusbar" statusbar_visible="in_progress,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">

                        <!-- New renewed document -> original expired document -->
                        <button name="action_view_renewed_from"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="not renewed_from_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">1</span>
                                <span class="o_stat_text">Renewed From</span>
                            </div>
                        </button>

                        <!-- Original expired document -> renewed document(s) -->
                        <button name="action_view_renewed_documents"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-refresh"
                                invisible="renewed_document_count == 0">
                            <field name="renewed_document_count"
                                   widget="statinfo"
                                   string="Renewed"/>
                        </button>

                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_ref_id" string="Employee"/>
                            <field name="document_type_id"/>
                            <field name="doc_attachment_ids"
                                   widget="many2many_binary" class="oe_inline"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="remaining_days" readonly="1"/>
                            <field name="notification_type"/>
                            <field name="before_days"
                                   invisible="notification_type == 'single'"/>
                            <field name="notify_type"/>
                            <field name="notify_user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Tree view of hr_employee_document model-->
    <record id='hr_employee_document_view_tree' model='ir.ui.view'>
        <field name="name">hr.employee.document.view.tree</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list js_class="employee_document_dashboard_list">
                <field name="name"/>
                <field name="employee_ref_id" string="Employee"/>
                <field name="document_type_id"/>
                <field name="expiry_date"
                       decoration-danger="remaining_days &lt;= 0"
                       decoration-warning="remaining_days &gt; 0 and remaining_days &lt;= 15"/>

                <field name="remaining_days"
                       decoration-danger="remaining_days &lt;= 0"
                       decoration-warning="remaining_days &gt; 0 and remaining_days &lt;= 15"  optional="show"/>
                <field name="state"
                       string="Status"
                       widget="badge"
                       optional="show"
                       decoration-success="state == 'in_progress'"
                       decoration-danger="state == 'expired'"/>
                <field name="description" optional="hide"/>

            </list>
        </field>
    </record>
    <!--    Defines a search view for HR Employee Documents.-->
    <record id="hr_employee_document_view_search" model="ir.ui.view">
        <field name="name">hr.employee.document.view.search</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <search string="Employee Documents">
                <field name="name"/>
                <field name="employee_ref_id"/>
                <field name="document_type_id"/>
                <field name="expiry_date"/>
                <field name="state"/>

                <separator/>

                <!-- Status Filters -->
                <filter string="In Progress"
                        name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>

                <filter string="Expired"
                        name="filter_expired"
                        domain="[('state', '=', 'expired')]"/>

                <separator/>


                <group expand="0" string="Group By">
                    <filter string="Employee"
                            name="group_employee"
                            context="{'group_by': 'employee_ref_id'}"/>

                    <filter string="Document Type"
                            name="group_document_type"
                            context="{'group_by': 'document_type_id'}"/>

                    <filter string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"/>

                    <filter string="Expiration Date"
                            name="group_expiry_date"
                            context="{'group_by': 'expiry_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    Configures an action window for HR Employee Documents.-->
    <record id="hr_employee_document_action" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">hr.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="hr_employee_document_view_tree"/>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>
    <!--    Creates a menu item for HR Employee Documents.-->
    <menuitem id="hr_employee_document_menu"
              name="Documents"
              parent="hr.menu_hr_employee_payroll"
              action="hr_employee_document_action"
              groups="hr.group_hr_manager"/>
</odoo>
