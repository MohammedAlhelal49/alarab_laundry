<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Template for customizing layout-->
    <template id="boec_custom_layout" inherit_id="website.layout"
              name="Custom Layout">
        <xpath expr="//div[@id='wrapwrap']/main" position="inside">
            <!-- Preloader -->
            <div id="loader-wrapper" class="d-print-none">
                <div class="loading"/>
                <div class="loader-section section-left"/>
                <div class="loader-section section-right"/>
            </div>
        </xpath>
    </template>
</odoo>
