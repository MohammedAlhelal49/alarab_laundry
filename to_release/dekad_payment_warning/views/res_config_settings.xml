<!-- dekad_payment_warning/views/res_config_settings.xml -->
<odoo>
    <record id="res_config_settings_view_form_payment_warning_message_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payment.warning.message.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="///div[@id='invite_users']" position="inside">
                <block title="Payment Warning Message" name="warning_message">
                    <setting id="warning_message">
                        <field name="enable_payment_warning_message"/>
                        <div class="content-group" invisible="not enable_payment_warning_message">
                            <div class="row mt16">
                                <label for="payment_warning_message" class="col-lg-4 o_light_label"/>
                                <field name="payment_warning_message"/>
                            </div>
                            <div class="row mt16">
                                <label for="payment_warning_excluded_groups" class="col-lg-4 o_light_label">
                                    Excluded Groups
                                </label>
                                <field name="payment_warning_excluded_groups" widget="many2many_tags"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>
