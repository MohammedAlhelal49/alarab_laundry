<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fcm_notification_view_tree" model="ir.ui.view">
        <field name="name">fcm.notification.view.tree</field>
        <field name="model">fcm.notification</field>
        <field name="arch" type="xml">
            <list string="FCM Notifications" decoration-danger="status == 'failed'" decoration-success="status == 'sent'" decoration-info="status == 'pending'" create="false">
                <field name="create_date" string="Log Date"/>
                <field name="partner_id"/>
                <field name="device_id"/>
                <field name="title"/>
                <field name="notification_type"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="status"/>
                <field name="error_message" invisible="status != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="fcm_notification_view_form" model="ir.ui.view">
        <field name="name">fcm.notification.view.form</field>
        <field name="model">fcm.notification</field>
        <field name="arch" type="xml">
            <form string="FCM Notification" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="device_id"/>
                            <field name="notification_type"/>
                            <field name="title"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                            <field name="click_url" widget="url"/>
                            <field name="create_date" string="Log Date"/>
                        </group>
                    </group>
                    <group>
                        <field name="server_url"/>
                        <field name="dbname"/>
                        <field name="error_message" invisible="status != 'failed'"/>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body" readonly="1"/>
                        </page>
                        <page string="Raw Data">
                            <field name="fcm_data" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fcm_notification_action" model="ir.actions.act_window">
        <field name="name">FCM Notifications</field>
        <field name="res_model">fcm.notification</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="fcm_notification_menu"
              name="FCM Notification History"
              parent="base.menu_administration"
              action="fcm_notification_action"
              sequence="101"/>
</odoo>
