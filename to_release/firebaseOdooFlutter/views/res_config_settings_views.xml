<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.firebase_fcm</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Firebase" string="Firebase" name="firebaseOdooFlutter">
                    <block title="Firebase Cloud Messaging" name="firebaseOdooFlutter_block">
                        <setting string="Firebase Configuration" help="Set up your FCM credentials here.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="fcm_api_type" class="col-lg-3 o_light_label"/>
                                    <field name="fcm_api_type"/>
                                </div>
                                <div class="row" invisible="fcm_api_type != 'legacy'">
                                    <label for="fcm_server_key" class="col-lg-3 o_light_label"/>
                                    <field name="fcm_server_key"/>
                                </div>
                                <div class="row" invisible="fcm_api_type != 'v1'">
                                    <label for="fcm_service_account" class="col-lg-3 o_light_label"/>
                                    <field name="fcm_service_account" widget="text" placeholder="Paste Service Account JSON here..."/>
                                </div>
                                <div class="row">
                                    <label for="fcm_sender_id" class="col-lg-3 o_light_label"/>
                                    <field name="fcm_sender_id"/>
                                </div>
                                <div class="row">
                                    <label for="fcm_custom_data" class="col-lg-3 o_light_label"/>
                                    <field name="fcm_custom_data" placeholder='{"key": "value"}'/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
