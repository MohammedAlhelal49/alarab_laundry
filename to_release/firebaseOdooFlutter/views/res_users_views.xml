<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit User Form -->
    <record id="view_users_form_fcm_preferences" model="ir.ui.view">
        <field name="name">res.users.form.fcm.preferences</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Firebase Devices" name="firebase_notifications">
                    <p class="text-muted">
                        Configure notification preferences for each of your registered devices. 
                        Click on a device to manage its addon-specific settings.
                    </p>
                    <field name="fcm_device_ids">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="device_type"/>
                            <field name="server_url"/>
                            <button name="action_test_notification" type="object" string="Test" icon="fa-paper-plane"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Also inherit Preference form (the one users see for themselves) -->
    <record id="view_users_form_simple_modif_fcm_preferences" model="ir.ui.view">
        <field name="name">res.users.preferences.form.fcm</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <notebook>
                    <page string="Firebase Devices" name="firebase_notifications">
                        <p class="text-muted">
                            Configure notification preferences for each of your registered devices. 
                            Click on a device to manage its addon-specific settings.
                        </p>
                        <field name="fcm_device_ids">
                            <list create="0" delete="0">
                                <field name="name"/>
                                <field name="device_type"/>
                                <button name="action_test_notification" type="object" string="Test" icon="fa-paper-plane"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
