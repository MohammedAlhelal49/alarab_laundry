<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Category -->
        <record id="module_category_mobile_apps" model="ir.module.category">
            <field name="name">Mobile Applications Access</field>
            <field name="description">Manage access to specific mobile applications and features.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups for each mobile sub-app -->
        <record id="group_mobile_barcode" model="res.groups">
            <field name="name">Mobile Barcode User</field>
            <field name="category_id" ref="module_category_mobile_apps"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

