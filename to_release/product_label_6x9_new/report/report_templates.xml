<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_simple_label_6x9">
            <div class="o_label_sheet" style="width: 86mm; height: 56mm; padding: 2mm; overflow: hidden;">
                <div class="o_label_full">
                    <div class="o_label_name" style="font-size: 14pt; font-weight: bold;">
                        <span t-field="product.display_name"/>
                    </div>

                    <div class="row" style="margin-top: 10px;">
                        <div class="col-8">
                            <span t-field="product.default_code"/>
                        </div>
                        <div class="col-4 text-end">
                            <strong t-if="pricelist"
                                    t-out="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"
                                    t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
                        </div>
                    </div>

                    <div class="text-center" style="margin-top: 15px;">
                        <t t-if="barcode">
                            <div t-out="barcode"
                                 t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'img_style': 'width:100%;height:15mm;'}"/>
                            <span t-out="barcode"/>
                        </t>
                        <t t-else="">
                            <div style="border: 1px dashed #ccc; padding: 5px; font-size: 8pt;">
                                No Barcode Defined
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </template>

        <template id="report_productlabel_6x9">
            <t t-call="web.html_container">
                <t t-set="quantities" t-value="quantity if quantity else (data.get('quantity') if data else {})"/>
                <t t-set="active_model"
                   t-value="active_model if active_model else (data.get('active_model') if data else 'product.product')"/>

                <t t-set="pricelist_id"
                   t-value="pricelist if pricelist else (data.get('pricelist') if data else False)"/>

                <t t-if="pricelist_id">
                    <t t-set="pricelist_obj" t-value="env['product.pricelist'].browse(int(pricelist_id))"/>
                </t>
                <t t-else="">
                    <t t-set="pricelist_obj" t-value="env.user.company_id.partner_id.property_product_pricelist"/>
                </t>

                <t t-foreach="quantities.items()" t-as="barcode_and_qty_by_product">
                    <t t-set="product" t-value="env[active_model].browse(int(barcode_and_qty_by_product[0]))"/>

                    <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                        <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                        <t t-foreach="range(int(barcode_and_qty[1]))" t-as="qty">
                            <div class="page" style="page-break-after: always;">
                                <t t-call="product_label_6x9_new.report_simple_label_6x9">
                                    <t t-set="pricelist" t-value="pricelist_obj"/>
                                </t>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>