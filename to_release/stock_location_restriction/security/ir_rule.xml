<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Rule 1: تطبق على Stock User - تقيد الـ Locations المقيدة -->
        <record id="rule_stock_location_restricted_user" model="ir.rule">
            <field name="name">Stock Location: Restricted Access - User</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="active">True</field>
            <field name="domain_force">
                ['|', '|',
                    ('is_restricted', '=', False),
                    ('allowed_user_ids', 'in', user.ids),
                    ('allowed_user_ids', '=', False)
                ]
            </field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 2: تطبق على Stock Manager - يشوف كل الـ Locations بدون قيود -->
        <record id="rule_stock_location_manager_full" model="ir.rule">
            <field name="name">Stock Location: Full Access - Manager</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="active">True</field>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>